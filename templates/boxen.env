# Environment shared by every boxen container. Keep this file chmod 600.
# After editing, run `boxen restart <name>` (or `boxen up <name>`) for each
# project; a plain container restart doesn't re-read this file.
#
# Remote Control needs a claude.ai sign-in talking directly to
# api.anthropic.com. Do NOT set any of these here, or it stops working:
#   CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, DISABLE_GROWTHBOOK,
#   ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN,
#   ANTHROPIC_BASE_URL (pointing anywhere but api.anthropic.com)

# Fine-grained GitHub token for git and the gh CLI inside containers.
# Suggested permissions: Contents read/write, Pull requests read/write,
# Metadata read. Set an expiration. With "Only select repositories", add each
# new private repo to the token. A project can override this with GH_TOKEN in
# ~/.config/boxen/projects/<name>/project.env.
#GH_TOKEN=github_pat_xxxxxxxx

# Git identity for commits made inside containers.
#GIT_AUTHOR_NAME=Your Name
#GIT_AUTHOR_EMAIL=you@example.com
#GIT_COMMITTER_NAME=Your Name
#GIT_COMMITTER_EMAIL=you@example.com

# Your timezone (IANA name).
TZ=America/Detroit

# Optional: opt out of Claude Code's operational telemetry. Remote Control
# keeps working with these set.
#DISABLE_TELEMETRY=1
#DISABLE_ERROR_REPORTING=1
