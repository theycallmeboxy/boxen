# Environment shared by every boxen container. Keep this file chmod 600.
#
# Do NOT add CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC here: it turns off
# Remote Control.

# Fine-grained GitHub token, scoped to the repos Claude should clone and push.
# Used by git (through gh) and by the gh CLI.
#GH_TOKEN=github_pat_xxxxxxxx

# Git identity for commits made inside containers.
#GIT_AUTHOR_NAME=Your Name
#GIT_AUTHOR_EMAIL=you@example.com
#GIT_COMMITTER_NAME=Your Name
#GIT_COMMITTER_EMAIL=you@example.com

TZ=America/Detroit
