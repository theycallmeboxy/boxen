#!/usr/bin/env bash
# boxen: manage per-project Claude Code containers on this VM.
#
# Layout:
#   <clone>/                          this repo: script, base image, templates
#   ~/.config/boxen/boxen.env         shared env for all containers (BOXEN_HOME)
#   ~/.config/boxen/base.local.Dockerfile   optional: your additions to the base image
#   ~/.config/boxen/projects/<name>/  compose.yaml, Dockerfile, optional project.env
#                                     and compose.override.yaml
#   ~/src/<name>/                     the project's code (BOXEN_SRC); same path inside
#   docker volume claude-config       shared ~/.claude for every container
set -euo pipefail

# The repo is wherever this script really lives (it's usually symlinked into ~/.local/bin).
BOXEN_REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BOXEN_HOME="${BOXEN_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/boxen}"
SRC_ROOT="$(realpath -m "${BOXEN_SRC:-$HOME/src}")"
PROJECTS_DIR="$BOXEN_HOME/projects"
ENV_FILE="$BOXEN_HOME/boxen.env"
LOCAL_BASE="$BOXEN_HOME/base.local.Dockerfile"
CORE_IMAGE="boxen-base:core"
BASE_IMAGE="boxen-base:latest"
CONFIG_VOLUME="claude-config"

# Identity for the container user. Use the passwd entry for the GID: under
# `sg docker` (install.sh), plain `id -g` would report the docker group.
USER_NAME="$(id -un)"
USER_UID="$(id -u)"
USER_GID="$(id -g "$USER_NAME")"
CHOME="/home/$USER_NAME"

die()  { printf 'boxen: %s\n' "$*" >&2; exit 1; }
# In cron runs (QUIET set), stamp warnings with the time for tokens.log.
warn() { printf '%sboxen: %s\n' "${QUIET:+$(date -Is) }" "$*" >&2; }
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# Agent mode (BOXEN_AGENT=1): boxen is being run by boxen-agentd for the
# supervisor project, with no terminal and nobody at the keyboard. Nothing may
# stop to ask; a command that needs a person either fails (need_tty, exit 2)
# or reports the exact question for someone to answer in the app and exits 3
# (approval_needed). Interactive use is unchanged.
agent_mode() { [[ "${BOXEN_AGENT:-}" == 1 ]]; }
need_tty() {
  agent_mode || return 0
  printf 'boxen: %s needs a terminal\n' "$1" >&2
  exit 2
}
# approval_needed KIND NAME COMMAND, with the question's text on stdin: print
# it in the fixed form the supervisor looks for, then return 3.
approval_needed() {
  printf 'boxen: approval needed (%s) for %s:\n' "$1" "$2"
  sed 's/^/    /'
  printf 'boxen: to approve, run: %s\n' "$3"
  return 3
}
# Set from `--approve trust` (up, restart, new): answer the trust question
# in agent mode instead of reporting it.
APPROVE_TRUST=0

# run_quiet LABEL cmd...: run a command with its output hidden. On failure,
# print "LABEL failed:" and the last 40 lines of its output, and fail too.
run_quiet() {
  local label=$1 out rc=0
  shift
  out=$(mktemp)
  "$@" >"$out" 2>&1 || rc=$?
  if (( rc )); then
    printf 'boxen: %s failed:\n' "$label" >&2
    tail -n 40 "$out" >&2
  fi
  rm -f "$out"
  return "$rc"
}

usage() {
  cat <<'EOF'
Usage: boxen <command> [args]

  new <name> [git-url]                            Create a project (cloning git-url if given) and start it
  supervisor                                      Create/start the supervisor: runs boxen for you from the app
  ls                                              List projects, their servers and GitHub tokens
  up <name|all>                                   Start, or apply env/compose changes; answers pending prompts
  down <name|all>                                 Stop
  restart <name|all>                              Recreate the container (picks up env changes)
  logs <name> [-f] [--tail N]                     The Remote Control server's output
  shell <name>                                    Bash inside the container
  claude <name> [args]                            Terminal Claude session inside the container
  resume <name> [N|ID] [--stop|--attach|--force]  Continue an earlier session in the Claude app
  rm <name> [--yes]                               Remove container, image and config (keeps the code)
  github [--reset] [--key f.pem]                  Connect GitHub: your app, per-project tokens, commit identity
  login                                           Sign in to Claude again (shared by every project)
  update [name|all]                               Rebuild images: fresh base and every project, or one project
  self-update                                     Update boxen itself and apply it to every project
  import-mac                                      How to move your Claude Code work from a Mac
EOF
}

valid_name() {
  [[ "$1" =~ ^[a-z0-9]+([_-][a-z0-9]+)*$ && ${#1} -le 40 ]] \
    || die "invalid project name '$1' (lowercase letters and digits, single '-' or '_' between them, max 40 chars)"
}

proj_dir() { printf '%s/%s' "$PROJECTS_DIR" "$1"; }

require_project() {
  [[ -n "${1:-}" ]] || die "missing project name (see 'boxen help')"
  valid_name "$1"
  [[ -f "$(proj_dir "$1")/compose.yaml" ]] || die "no such project: $1"
}

require_setup() {
  [[ -f "$ENV_FILE" ]] || die "run $BOXEN_REPO/install.sh first"
  docker image inspect "$BASE_IMAGE" >/dev/null 2>&1 || die "base image missing; run $BOXEN_REPO/install.sh first"
  docker volume inspect "$CONFIG_VOLUME" >/dev/null 2>&1 || die "volume $CONFIG_VOLUME missing; run $BOXEN_REPO/install.sh first"
}

# docker compose scoped to one project's directory. compose.yaml is generated;
# the project's own settings go in compose.override.yaml, merged on top (with
# an explicit -f, compose doesn't pick the override up by itself).
dc() {
  local name=$1; shift
  local dir; dir=$(proj_dir "$name")
  local files=(-f "$dir/compose.yaml")
  [[ -f "$dir/compose.override.yaml" ]] && files+=(-f "$dir/compose.override.yaml")
  docker compose --project-directory "$dir" "${files[@]}" "$@"
}

# One-off container from the base image with the shared config mounted.
run_base() {
  docker run --rm "$@"
}
base_args() {
  printf '%s\n' -v "$CONFIG_VOLUME:$CHOME/.claude" -e "CLAUDE_CONFIG_DIR=$CHOME/.claude"
}

# The supervisor project (the one that runs boxen for you from the app) goes
# last, so an "all" that restarts it has finished everything else first.
projects() {
  shopt -s nullglob
  local d n
  for d in "$PROJECTS_DIR"/*/; do
    n=$(basename "$d")
    [[ "$n" != supervisor ]] && printf '%s\n' "$n"
  done
  [[ -d "$PROJECTS_DIR/supervisor" ]] && echo supervisor
  return 0
}

# each <cmd_fn> <name|all> [args...]: run a per-project command for one
# project, or for every project when the name is "all". Each project runs in
# a subshell, so one failing doesn't stop the rest; failures are listed at
# the end (exit 3 if any of them was only waiting for an approval).
each() {
  local fn=$1
  shift
  if [[ "${1:-}" != all ]]; then
    "$fn" "$@"
    return
  fi
  shift
  local n rc=0 failed=() list=()
  mapfile -t list < <(projects)
  (( ${#list[@]} )) || { info "no projects yet"; return 0; }
  for n in "${list[@]}"; do
    ( "$fn" "$n" "$@" ) || { if (( $? == 3 && rc != 1 )); then rc=3; else rc=1; fi; failed+=("$n"); }
  done
  (( ${#failed[@]} == 0 )) || { warn "failed for: ${failed[*]}"; exit "$rc"; }
}

# The compose template a project is rendered from: the supervisor has its own.
compose_template() {
  if [[ "$1" == supervisor ]]; then
    printf '%s/templates/compose.supervisor.yaml\n' "$BOXEN_REPO"
  else
    printf '%s/templates/compose.yaml\n' "$BOXEN_REPO"
  fi
}

# ---------------------------------------------------------------- setup

build_base() {
  # --fresh: re-pull Ubuntu and skip the cache so apt picks up new
  # packages (including Claude Code) in both layers.
  local core_extra=() local_extra=()
  if [[ "${1:-}" == "--fresh" ]]; then
    core_extra=(--pull --no-cache)
    local_extra=(--no-cache)
  fi
  info "building base image..."
  run_quiet "building $CORE_IMAGE" docker build "${core_extra[@]}" -t "$CORE_IMAGE" \
    --build-arg USERNAME="$USER_NAME" \
    --build-arg USER_UID="$USER_UID" \
    --build-arg USER_GID="$USER_GID" \
    "$BOXEN_REPO/base" || return 1
  if [[ -f "$LOCAL_BASE" ]]; then
    info "applying base.local.Dockerfile..."
    # Built from stdin with no context, so nothing in ~/.config/boxen
    # (like boxen.env) is ever sent to the builder.
    run_quiet "building $BASE_IMAGE from $LOCAL_BASE" \
      docker build "${local_extra[@]}" -t "$BASE_IMAGE" - < "$LOCAL_BASE" || return 1
  else
    run_quiet "tagging $BASE_IMAGE" docker tag "$CORE_IMAGE" "$BASE_IMAGE" || return 1
  fi
}

# Hidden command: install.sh runs it (and self-update, through install.sh).
cmd_setup() {
  command -v docker >/dev/null || die "docker not found"
  docker compose version >/dev/null 2>&1 || die "docker compose plugin not found"
  docker info >/dev/null 2>&1 || die "can't talk to the docker daemon (is your user in the docker group?)"

  mkdir -p "$PROJECTS_DIR" "$SRC_ROOT"

  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$BOXEN_REPO/templates/boxen.env" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    # Containers use the VM's timezone.
    local tz
    tz=$(timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || true)
    if [[ -n "$tz" ]]; then set_env TZ "$tz"; fi
    info "created $ENV_FILE"
  fi

  build_base || exit 1

  if ! docker volume inspect "$CONFIG_VOLUME" >/dev/null 2>&1; then
    docker volume create "$CONFIG_VOLUME" >/dev/null
    info "created volume $CONFIG_VOLUME"
  fi
  # Make sure the shared config volume belongs to you, not root.
  docker run --rm --user root -v "$CONFIG_VOLUME:/v" "$BASE_IMAGE" \
    chown "$USER_UID:$USER_GID" /v

  install_shared_config
}

# The /carry skill goes into the shared config (every project sees it), and
# transcripts are kept a year instead of Claude Code's 30 days, so there's
# something to carry. Only boxen's own copy of the skill is replaced; a
# cleanupPeriodDays you set yourself is left alone.
install_shared_config() {
  local args line out rc=0
  mapfile -t args < <(base_args)
  out=$(mktemp)
  # shellcheck disable=SC2016  # expanded inside the container
  run_base "${args[@]}" -v "$BOXEN_REPO/skills:/boxen-skills:ro" "$BASE_IMAGE" bash -c '
    set -e
    d=$CLAUDE_CONFIG_DIR/skills/carry
    if [ ! -f "$d/SKILL.md" ]; then
      mkdir -p "$d" && cp /boxen-skills/carry/SKILL.md "$d/SKILL.md" && echo "installed /carry skill"
    elif head -5 "$d/SKILL.md" | grep -q boxen-managed; then
      cp /boxen-skills/carry/SKILL.md "$d/SKILL.md"
    fi
    s=$CLAUDE_CONFIG_DIR/settings.json
    if [ ! -f "$s" ]; then
      echo "{\"cleanupPeriodDays\": 365}" > "$s" && echo "transcripts are kept for 365 days"
    elif ! jq -e "type == \"object\"" "$s" >/dev/null 2>&1; then
      echo "settings.json is not a JSON object; leaving it alone"
    elif ! jq -e "has(\"cleanupPeriodDays\")" "$s" >/dev/null; then
      jq ".cleanupPeriodDays = 365" "$s" > "$s.tmp" && mv -f "$s.tmp" "$s" && echo "transcripts are kept for 365 days"
    fi' >"$out" 2>&1 || rc=$?
  if (( rc )); then
    printf 'boxen: installing shared config failed:\n' >&2
    tail -n 40 "$out" >&2
  else
    while IFS= read -r line; do info "$line"; done < "$out"
  fi
  rm -f "$out"
  return "$rc"
}

# ------------------------------------------------------- shared config / login

# True when the shared config holds a claude.ai login, which Remote Control
# requires (API keys and setup-token tokens don't work for it).
logged_in() {
  local args; mapfile -t args < <(base_args)
  run_base "${args[@]}" "$BASE_IMAGE" \
    sh -c 'claude auth status 2>/dev/null | jq -e ".authMethod == \"claude.ai\"" >/dev/null'
}

do_login() {
  need_tty login
  local args; mapfile -t args < <(base_args)
  echo "    Open the URL it prints on any device and sign in with your claude.ai account."
  echo "    Then paste the code it gives you here and press Enter. Nothing appears on"
  echo "    screen while you paste; that's normal."
  run_base -it "${args[@]}" "$BASE_IMAGE" claude auth login
}

ensure_login() {
  logged_in && return
  if agent_mode; then
    printf 'boxen: login needs a terminal (Claude isn'"'"'t signed in yet; run '"'"'boxen login'"'"' on the VM)\n' >&2
    exit 2
  fi
  info "Claude isn't signed in (with a claude.ai account) yet. Every project shares this login."
  do_login
  logged_in || die "still not signed in with a claude.ai account; run 'boxen login' to retry"
}

cmd_login() {
  require_setup
  do_login
  logged_in || die "sign-in didn't produce a claude.ai login"
  local n list=()
  mapfile -t list < <(projects)
  for n in "${list[@]}"; do
    if [[ "$(docker inspect -f '{{.State.Running}}' "boxen-$n" 2>/dev/null || true)" == true ]] \
       || [[ "$(docker inspect -f '{{.State.Restarting}}' "boxen-$n" 2>/dev/null || true)" == true ]]; then
      docker restart "boxen-$n" >/dev/null
    fi
  done
  info "signed in"
}

# ---------------------------------------------------------------- GitHub
#
# A private GitHub App you own mints short-lived tokens (1 hour), each scoped
# to one project's repo. The app's private key stays on the VM. Containers only
# see their own token, through a read-only mount of projects/<name>/token, and
# cron refreshes it every 30 minutes.

GH_DIR="$BOXEN_HOME/github"
GH_KEY="$GH_DIR/app.pem"
GH_CONF="$GH_DIR/app.conf"
TOKENS_LOG="$BOXEN_HOME/tokens.log"
GH_API="https://api.github.com"

app_configured() { [[ -s "$GH_KEY" && -s "$GH_CONF" ]]; }
app_conf() { sed -n "s/^$1=//p" "$GH_CONF" 2>/dev/null | tail -1; }
set_app_conf() {
  local tmp="$GH_CONF.tmp"
  { grep -v "^$1=" "$GH_CONF" 2>/dev/null || true; printf '%s=%s\n' "$1" "$2"; } > "$tmp"
  mv -f "$tmp" "$GH_CONF"
}
app_install_url() { printf 'https://github.com/apps/%s/installations/new' "$(app_conf APP_SLUG)"; }

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# RS256 JWT identifying the app, valid for 9 minutes (iat backdated 60s for
# clock drift, as GitHub recommends).
make_jwt() {
  local now h p s
  now=$(date +%s)
  h=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  p=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$(app_conf CLIENT_ID)" | b64url)
  s=$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$GH_KEY" -binary | b64url)
  printf '%s.%s.%s' "$h" "$p" "$s"
}

# gh_app_api METHOD PATH [JSON]: call the GitHub API as the app. Prints the
# JSON reply; on failure it still prints JSON with a .message, and fails.
gh_app_api() {
  local out rc=0
  local args=(-s --fail-with-body -X "$1"
              -H "Authorization: Bearer $(make_jwt)"
              -H "Accept: application/vnd.github+json"
              -H "X-GitHub-Api-Version: 2022-11-28")
  if [[ -n "${3:-}" ]]; then args+=(-H "Content-Type: application/json" -d "$3"); fi
  out=$(curl "${args[@]}" "$GH_API$2") || rc=$?
  if (( rc )) && [[ -z "$out" ]]; then
    out=$(printf '{"message":"no reply from GitHub (curl exit %d)"}' "$rc")
  fi
  printf '%s\n' "$out"
  return "$rc"
}
gh_msg() { jq -r '.message // empty' <<<"$1" 2>/dev/null || true; }

# github.com remote URL (https or ssh form) -> owner/repo
github_repo() {
  local u=${1%/}
  u=${u%.git}
  case $u in
    https://github.com/*)   u=${u#https://github.com/} ;;
    https://*@github.com/*) u=${u#https://*@github.com/} ;;
    git@github.com:*)       u=${u#git@github.com:} ;;
    ssh://git@github.com/*) u=${u#ssh://git@github.com/} ;;
    *) return 1 ;;
  esac
  # owner and repo: GitHub's own shape (start alphanumeric, no trailing . or -), and no ".."
  local seg='[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9_])?'
  [[ $u =~ ^$seg/$seg$ && $u != *..* ]] || return 1
  printf '%s\n' "$u"
}

project_repo() {
  local url
  url=$(git -C "$SRC_ROOT/$1" remote get-url origin 2>/dev/null) || return 1
  github_repo "$url"
}

mkdir_private() { mkdir -p "$1" && chmod 700 "$1"; }

token_dir() { printf '%s/token' "$(proj_dir "$1")"; }

# token_state NAME: for `boxen ls`, from the token file alone (no network).
# Tokens last an hour and cron renews them every 30 minutes, so one older
# than 55 minutes means the refresh isn't happening.
token_state() {
  local f
  f="$(token_dir "$1")/gh-token"
  project_repo "$1" >/dev/null 2>&1 || { echo "-"; return; }
  app_configured || { echo "run boxen github"; return; }
  [[ -f "$f" ]] || { echo "no token"; return; }
  if (( $(date +%s) - $(stat -c %Y "$f") < 3300 )); then echo "token ok"; else echo "token stale"; fi
}

# app_account OWNER: true if the boxen app is installed on that account (you,
# or an org you added it to). Only asked when a repo lookup fails.
APP_ACCOUNTS=""
app_account() {
  if [[ -z "$APP_ACCOUNTS" ]]; then
    APP_ACCOUNTS=$(gh_app_api GET "/app/installations?per_page=100" \
                     | jq -r '.[].account.login' 2>/dev/null | tr 'A-Z' 'a-z') || true
    # If GitHub can't be asked, assume it's yours so the real error is shown.
    [[ -n "$APP_ACCOUNTS" ]] || { APP_ACCOUNTS="?"; }
  fi
  [[ "$APP_ACCOUNTS" == "?" ]] && return 0
  grep -qxF "$(tr 'A-Z' 'a-z' <<<"$1")" <<<"$APP_ACCOUNTS"
}

# mint_token owner/repo dir: write a 1-hour token for just that repo to
# dir/gh-token (atomically, so a reader never sees half a token). Prints
# the expiry time.
mint_token() {
  local repo=$1 dir=$2 out inst tok
  out=$(gh_app_api GET "/repos/$repo/installation") || {
    # Someone else's repo (a clone of an upstream project): the app can only
    # be installed on accounts you control, so no token is possible. Not an
    # error; return 2 so the caller can say so.
    if ! app_account "${repo%%/*}"; then return 2; fi
    warn "$repo: the boxen GitHub App can't access it ($(gh_msg "$out")). Add it to the app's installation: $(app_install_url)"
    return 1
  }
  inst=$(jq -r .id <<<"$out")
  out=$(gh_app_api POST "/app/installations/$inst/access_tokens" \
          "$(jq -nc --arg r "${repo#*/}" '{repositories: [$r]}')") || {
    warn "$repo: couldn't get a token ($(gh_msg "$out"))"
    return 1
  }
  tok=$(jq -r '.token // empty' <<<"$out")
  [[ -n "$tok" ]] || { warn "$repo: GitHub's reply had no token"; return 1; }
  mkdir_private "$dir"
  (umask 077; printf '%s\n' "$tok" > "$dir/.gh-token.tmp")
  mv -f "$dir/.gh-token.tmp" "$dir/gh-token"
  jq -r .expires_at <<<"$out"
}

# Refresh one project's token. A no-op when GitHub isn't set up; removes the
# token when the project has no GitHub remote (yet). Quiet except for
# failures, unless `boxen tokens` asked for the per-project report
# (TOKENS_VERBOSE).
refresh_project() {
  local n=$1 dir repo exp
  app_configured || return 0
  dir=$(token_dir "$n")
  mkdir_private "$dir"
  if ! repo=$(project_repo "$n"); then
    rm -f "$dir/gh-token"
    [[ -z "${TOKENS_VERBOSE:-}" ]] || printf '  %-24s no GitHub remote; no token\n' "$n"
    return 0
  fi
  local rc=0
  exp=$(mint_token "$repo" "$dir") || rc=$?
  if (( rc == 2 )); then
    rm -f "$dir/gh-token"
    [[ -z "${TOKENS_VERBOSE:-}" ]] || printf '  %-24s %-36s not your repo: pulls work (public), no token to push\n' "$n" "$repo"
    return 0
  fi
  (( rc == 0 )) || return 1
  [[ -z "${TOKENS_VERBOSE:-}" ]] || printf '  %-24s %-36s token valid until %s\n' "$n" "$repo" "$exp"
}

# Hidden command: cron runs `tokens --quiet`; `boxen github` runs it to mint
# tokens for existing projects.
cmd_tokens() {
  local n rc=0 list=()
  if [[ "${1:-}" == --quiet ]]; then
    # From cron: output goes to tokens.log, so stay silent unless something fails.
    QUIET=1
    shift
    if [[ -f "$TOKENS_LOG" ]] && (( $(stat -c %s "$TOKENS_LOG") > 1000000 )); then
      : > "$TOKENS_LOG"
    fi
  else
    TOKENS_VERBOSE=1
  fi
  if ! app_configured; then
    [[ -n "${QUIET:-}" ]] || warn "GitHub isn't set up yet; run 'boxen github'"
    return 0
  fi
  if [[ "${1:-}" == all ]]; then shift; fi
  if (( $# )); then
    for n in "$@"; do require_project "$n"; list+=("$n"); done
  else
    mapfile -t list < <(projects)
  fi
  for n in "${list[@]}"; do
    refresh_project "$n" || rc=1
  done
  return "$rc"
}

install_cron() {
  if ! command -v crontab >/dev/null; then
    warn "cron isn't installed, so tokens won't refresh on their own. Install it (sudo apt install cron) and re-run 'boxen github'."
    return 1
  fi
  local tag="# boxen-tokens" job current
  job="BOXEN_HOME=\"$BOXEN_HOME\" BOXEN_SRC=\"$SRC_ROOT\" \"$BOXEN_REPO/bin/boxen\" tokens --quiet >>\"$TOKENS_LOG\" 2>&1"
  # Read your existing crontab in full first, then rewrite it with our lines
  # replaced (everything else kept as is).
  current=$(crontab -l 2>/dev/null || true)
  {
    if [[ -n "$current" ]]; then grep -vF "$tag" <<<"$current" || true; fi
    printf '*/30 * * * * %s %s\n' "$job" "$tag"
    printf '@reboot sleep 30 && %s %s\n' "$job" "$tag"
  } | crontab -
  info "cron refreshes tokens every 30 minutes and at boot (problems go to $TOKENS_LOG)"
}

env_get() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -1; }

# set_env KEY VALUE in boxen.env: replace an existing (or commented-out) line,
# else append.
set_env() {
  if grep -qE "^#?$1=" "$ENV_FILE"; then
    sed -i -E "s|^#?$1=.*|$1=$(sed_esc "$2")|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"
  fi
}

# read_key DEST [FILE]: copy a PEM private key from FILE, or read one pasted
# into the terminal. A pasted key isn't echoed (it would sit in your scrollback);
# a * appears for each line received instead.
read_key() {
  local dest=$1 src=${2:-} line n=0 started=0 tty=0
  (umask 077; : > "$dest")
  if [[ -n "$src" ]]; then
    src=${src/#\~/$HOME}
    [[ -f $src ]] || { rm -f "$dest"; die "no such file: $src"; }
    cat "$src" > "$dest"
  else
    if [[ -t 0 ]]; then
      tty=1
      stty -echo
      trap 'stty echo 2>/dev/null' EXIT
    fi
    while IFS= read -r line; do
      # Ignore anything before the BEGIN line (stray whitespace, etc).
      if (( ! started )); then
        [[ $line == -----BEGIN* ]] || continue
        started=1
      fi
      printf '%s\n' "$line" >> "$dest"
      n=$((n + 1))
      printf '*' >&2
      [[ $line == -----END* ]] && break
    done
    if (( tty )); then stty echo; trap - EXIT; fi
    printf '\n' >&2
    (( n )) || { rm -f "$dest"; die "no key received"; }
    info "received $n lines"
  fi
  openssl pkey -in "$dest" -noout 2>/dev/null || { rm -f "$dest"; die "that isn't a valid private key"; }
}

cmd_github() {
  need_tty github
  local c
  for c in openssl curl jq git; do
    command -v "$c" >/dev/null || die "$c is required (sudo apt install $c)"
  done
  [[ -f "$ENV_FILE" ]] || die "run $BOXEN_REPO/install.sh first"

  local keyfile=""
  while (( $# )); do
    case $1 in
      --reset) rm -f "$GH_KEY" "$GH_CONF"; info "forgot the GitHub App; setting it up again" ;;
      --key)   keyfile=${2:-}; [[ -n "$keyfile" ]] || die "--key needs a path to the .pem file"; shift ;;
      *)       die "usage: boxen github [--reset] [--key file.pem]" ;;
    esac
    shift
  done
  mkdir_private "$GH_DIR"

  # Who you are on GitHub: from the VM's gh login if there is one.
  local uid="" login="" name="" user
  if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    login=$(gh api user --jq .login)
  else
    read -rp "Your GitHub username: " login
  fi
  [[ -n "$login" ]] || die "need your GitHub username"
  user=$(curl -fsS "$GH_API/users/$login") || die "couldn't look up GitHub user '$login'"
  uid=$(jq -r .id <<<"$user")
  name=$(jq -r '.name // empty' <<<"$user")

  if ! app_configured; then
    local cid url
    url="https://github.com/settings/apps/new?name=boxen-$login"
    url+="&description=Short-lived%20per-repo%20tokens%20for%20boxen%20containers"
    url+="&url=https://github.com/$login&public=false&webhook_active=false"
    url+="&contents=write&pull_requests=write&issues=write"
    url+="&actions=read&checks=read&statuses=read&metadata=read"
    cat <<EOF

Step 1 of 2: create your private GitHub App. Open this link, signed in to
GitHub as $login. It pre-fills the name and permissions:

  $url

Click "Create GitHub App" at the bottom. On the page that follows:
  - copy the Client ID (near the top)
  - under "Private keys", click "Generate a private key" (a .pem file downloads)

EOF
    read -rp "Client ID: " cid
    cid=${cid//[[:space:]]/}
    [[ -n "$cid" ]] || die "need the Client ID"
    if [[ -n "$keyfile" ]]; then
      read_key "$GH_KEY.tmp" "$keyfile"
    else
      echo "Now paste the private key: open the downloaded .pem file, copy all of it"
      echo "(BEGIN through END line), and paste here. It won't be shown; you'll see"
      echo "a * per line. (Or re-run with --key /path/to/file.pem if it's on this VM.)"
      read_key "$GH_KEY.tmp"
    fi
    mv -f "$GH_KEY.tmp" "$GH_KEY"
    set_app_conf CLIENT_ID "$cid"
  fi

  local app slug
  app=$(gh_app_api GET /app) || \
    die "GitHub rejected the app's credentials ($(gh_msg "$app")). Check the Client ID and key, then run 'boxen github --reset'."
  slug=$(jq -r .slug <<<"$app")
  set_app_conf APP_SLUG "$slug"
  info "GitHub App: $slug"

  local installs
  installs=$(gh_app_api GET /app/installations | jq length) || die "couldn't list the app's installations"
  if [[ "$installs" == 0 ]]; then
    cat <<EOF

Step 2 of 2: install the app on your account:

  $(app_install_url)

Choose "All repositories" so repos you create later are covered too, or pick
specific ones (then add new repos to it as you go).

EOF
    read -rp "Press Enter once it's installed... " _
    installs=$(gh_app_api GET /app/installations | jq length) || die "couldn't list the app's installations"
    [[ "$installs" != 0 ]] || die "the app isn't installed yet; install it, then re-run 'boxen github'"
  fi
  info "app is installed"

  # Commit identity for containers: your GitHub no-reply address keeps your
  # real email out of commits. Leave it alone if you've already set one.
  local email="${uid}+${login}@users.noreply.github.com" ident_set=0
  name=${name:-$login}
  if [[ -z "$(env_get GIT_AUTHOR_EMAIL)" ]]; then
    set_env GIT_AUTHOR_NAME "$name"
    set_env GIT_COMMITTER_NAME "$name"
    set_env GIT_AUTHOR_EMAIL "$email"
    set_env GIT_COMMITTER_EMAIL "$email"
    ident_set=1
    info "commits from containers: $name <$email>"
  else
    info "keeping the git identity already in $ENV_FILE ($(env_get GIT_AUTHOR_EMAIL)); your no-reply address is $email"
  fi

  install_cron || true

  info "minting tokens for existing projects"
  cmd_tokens || true

  # A new identity only reaches containers created after it; recreate the
  # ones running now.
  if (( ident_set )); then
    local n running=()
    while read -r n; do
      if [[ "$(docker inspect -f '{{.State.Running}}' "boxen-$n" 2>/dev/null || true)" == true ]]; then
        running+=("$n")
      fi
    done < <(projects)
    if (( ${#running[@]} )); then
      for n in "${running[@]}"; do
        run_quiet "restarting $n" dc "$n" up -d --force-recreate || true
      done
      info "restarted ${#running[@]} running project(s) so they pick up the git identity"
    fi
  fi
}

# ------------------------------------------------------------ new project

# Turn the server's terminal output into plain text: strip control sequences
# (colors, cursor moves, clears, window titles) and stray control characters.
# The server redraws its status box in place (cursor up, then repaint), which
# in a log becomes the same lines over and over; after a redraw, lines already
# shown in the previous or current paint are skipped, so you see changes only.
# perl works on raw bytes, so this behaves the same in any locale (sed's
# character ranges don't under en_US.UTF-8).
plain_text() {
  LC_ALL=C perl -ne '
    BEGIN { $| = 1; our ($redraw, %prev, %cur) = (0) }
    if (/\e\[[0-9]*A/) { $redraw = 1; %prev = %cur; %cur = () }
    s/\e\[[0-9;?<>=!]*[ -\/]*[@-~]//g;      # CSI: colors, cursor, clears
    s/\e\][^\a\e]*(?:\a|\e\\)//g;           # OSC: window titles, links
    s/\e[()*+][0-9A-Za-z]//g;               # charset selection
    s/\e[=>78DEHMNOZc]//g;                  # other short escapes
    for my $l (split /\r|\n/) {
      $l =~ tr/\000-\010\013-\037\177//d;
      $l =~ s/\s+$//;
      next unless $l =~ /\S/;
      if ($redraw) { my $seen = $prev{$l} || $cur{$l}; $cur{$l} = 1; next if $seen }
      print "$l\n";
    }'
}

# server_state NAME: what the project's Remote Control server is doing, read
# from its output since the container last started. A container can be
# "running" while the server inside sits at a question nobody can answer, so
# `boxen ls` and the wait after starting a project use this.
server_state() {
  local n=$1 started
  started=$(docker inspect -f '{{.State.StartedAt}}' "boxen-$n" 2>/dev/null) || { echo "not created"; return; }
  docker logs --since "$started" --tail 300 "boxen-$n" 2>&1 | plain_text | perl -ne '
    BEGIN { $s = "starting" }
    if    (/Workspace not trusted/)                      { $s = "not trusted: run boxen up NAME" }
    elsif (/not logged in|please (log|sign) in|claude (auth )?login/i)
                                                         { $s = "not signed in: run boxen login" }
    elsif (/Spawn mode for this project/)                { $s = "waiting for an answer: run boxen up NAME" }
    elsif (/^Trust .*\? \[y\/N\]$|^Enable Remote Control\? \(y\/n\)$/)
                                                         { $s = "waiting for an answer: run boxen up NAME" }
    elsif (/Reconnecting/)                               { $s = "reconnecting" }
    elsif (/\bConnected\b|\bReconnected\b/)              { $s = "connected" }
    END   { print "$s\n" }' | sed "s/NAME/$n/" || true
}

# Escape a value for use as a sed replacement (we use | as the delimiter).
sed_esc() { printf '%s' "$1" | sed -e 's/[&|\\]/\\&/g'; }

render() {
  # $1 template, $2 name, $3 source dir
  sed -e "s|__NAME__|$(sed_esc "$2")|g" \
      -e "s|__USER__|$(sed_esc "$USER_NAME")|g" \
      -e "s|__CHOME__|$(sed_esc "$CHOME")|g" \
      -e "s|__BOXEN_HOME__|$(sed_esc "$BOXEN_HOME")|g" \
      -e "s|__SRC__|$(sed_esc "$3")|g" "$1"
}

# attach_prompts NAME: the server is waiting at one of Claude's one-time
# questions (trust this folder; enable Remote Control), which it can only
# take from a terminal. Restart the container with this terminal attached
# from its first line of output so you can answer; once the server prints
# its session URL, boxen detaches on its own and the server keeps running.
attach_prompts() {
  local n=$1 c="boxen-$1" tmp watcher
  docker stop "$c" >/dev/null 2>&1 || true
  run_quiet "creating $n" dc "$n" up --no-start || return 1
  tmp=$(mktemp -d)
  cat <<EOF

==> Starting '$n' with your terminal attached. Answer y to trust this folder and
    (first time only) y to enable Remote Control; boxen detaches by itself once
    the server is up. (If it doesn't: Ctrl+P then Ctrl+Q. Ctrl+C restarts the server.)

EOF
  # Watch the attached output for the session URL, then end the attachment
  # (the docker client, not the container). Gives up after 10 minutes.
  (
    for _ in $(seq 600); do
      # The session URL (claude.ai/code?environment=...), not just any mention
      # of claude.ai/code: the server's one-time questions mention it too.
      if [[ -s "$tmp/pid" ]] && grep -q 'claude\.ai/code?environment=' "$tmp/out" 2>/dev/null; then
        sleep 1    # let the rest of the banner arrive
        kill -9 "$(cat "$tmp/pid")" 2>/dev/null || true
        exit 0
      fi
      sleep 1
    done
  ) &
  watcher=$!
  # script(1) gives the attachment a terminal and copies its output to a file
  # we can watch. The shell records its PID, then becomes the docker client.
  script -qfec "echo \$\$ > '$tmp/pid'; exec docker start -ai '$c'" "$tmp/out" || true
  kill "$watcher" 2>/dev/null || true
  wait "$watcher" 2>/dev/null || true
  stty sane 2>/dev/null || true
  echo
  rm -rf "$tmp"
}

# drive_prompts NAME: attach_prompts for agent mode, where nobody is at a
# keyboard. The container is started attached under script(1) as above, but
# its input is a pipe boxen writes to, and its output is watched for the
# server's one-time questions:
#   - the line "Enable Remote Control? (y/n)", exactly, is answered y:
#     starting Remote Control servers is what boxen is for.
#   - any other question ("Trust <folder>? [y/N]", preceded by what trusting
#     means for this folder: hooks, MCP servers, settings it brings; or
#     anything else ending in [y/N], [Y/n] or (y/n)) is answered y only with
#     `--approve trust`. Otherwise its text is reported for a person to see,
#     the container is stopped so it doesn't sit at the prompt, and this
#     returns 3. The exact match matters: the preamble quotes text from the
#     repo (server names, rules), which must not be able to look like the
#     question boxen answers by itself.
# The pty gets a size first: Claude refuses to ask ("did not report its
# size") on a 0x0 terminal. Returns 0 once the session URL appears or the
# container stops by itself; wait_server then reports the state as usual.
# 3 after 180s without a URL or a known question (whatever is on screen is
# shown).
# The coprocess's variables vanish once it exits, so test for it this way.
drv_alive() { [[ -n "${DRV_PID:-}" ]] && kill -0 "$DRV_PID" 2>/dev/null; }

drive_prompts() {
  local n=$1 c="boxen-$1" tmp seg last off=0 size i state="" answer rc=0
  docker stop "$c" >/dev/null 2>&1 || true
  run_quiet "creating $n" dc "$n" up --no-start || return 1
  tmp=$(mktemp -d)
  : > "$tmp/out"
  # DRV[1] is the pty's input. script's own stdout is discarded: the file
  # has everything. A write to a pty whose reader is gone must not end boxen.
  trap '' PIPE
  coproc DRV { script -qfec "stty rows 50 cols 200; stty size > '$tmp/size'; echo \$\$ > '$tmp/pid'; exec docker start -ai '$c'" "$tmp/out" >/dev/null 2>&1; }
  for (( i = 0; i < 180; i++ )); do
    sleep 1
    if [[ ! -s "$tmp/size" ]]; then continue; fi
    if [[ "$(cat "$tmp/size")" == "0 0" ]]; then state=nosize; break; fi
    # Only what arrived since the last answer, so an answered question isn't
    # seen again: exactly the bytes from off to size, as it stood before the
    # read. script's own "Script started on ..." header isn't output.
    size=$(stat -c %s "$tmp/out")
    seg=$(tail -c +$((off + 1)) "$tmp/out" | head -c $((size - off)) | plain_text | grep -v '^Script \(started\|done\) on ' || true)
    if grep -q 'claude\.ai/code?environment=' <<<"$seg"; then
      state=connected
      break
    fi
    last=$(tail -n 1 <<<"$seg")
    answer=0
    if [[ "$last" == "Enable Remote Control? (y/n)" ]]; then
      answer=1
    else
      case $last in
        *"(y/n)"|*"[y/N]"|*"[Y/n]") state=trust ;;
      esac
    fi
    if [[ "$state" == trust ]] && (( APPROVE_TRUST )); then state="" answer=1; fi
    [[ "$state" != trust ]] || break
    if (( answer )); then
      off=$size
      if drv_alive && [[ -n "${DRV[1]:-}" ]]; then
        printf 'y\n' >&"${DRV[1]}" || true
      fi
      continue
    fi
    # The container stopped (crashed, or exited) on its own.
    drv_alive || { state=exited; break; }
  done
  if [[ "$state" == connected ]]; then sleep 1; fi    # the rest of the banner
  # End the attachment (the docker client), not the container.
  if [[ -s "$tmp/pid" ]]; then kill -9 "$(cat "$tmp/pid")" 2>/dev/null || true; fi
  wait "${DRV_PID:-}" 2>/dev/null || true
  trap - PIPE
  [[ -s "$tmp/size" ]] || state=nosize
  case $state in
    trust)
      # The question as the server put it, from the line that introduces
      # what trusting means (or the first line, if that changed) to the question.
      docker stop "$c" >/dev/null 2>&1 || true
      if grep -q '^Remote Control starts' <<<"$seg"; then
        seg=$(sed -n '/^Remote Control starts/,$p' <<<"$seg")
      fi
      approval_needed trust "$n" "boxen up $n --approve trust" <<<"$seg" || rc=$? ;;
    nosize)
      docker stop "$c" >/dev/null 2>&1 || true
      warn "couldn't give $n's server a terminal with a size, so it can't ask its questions; run 'boxen up $n' from a terminal on the VM"
      rc=1 ;;
    "")
      docker stop "$c" >/dev/null 2>&1 || true
      printf 'boxen: %s is waiting at an unrecognized question:\n' "$n"
      tail -n 10 <<<"$seg" | sed 's/^/    /'
      printf 'boxen: answer it with '"'"'boxen up %s'"'"' from a terminal on the VM\n' "$n"
      rc=3 ;;
  esac
  rm -rf "$tmp"
  return "$rc"
}

# poll_server NAME: server_state, checked every second for up to 20s until it
# settles on something other than "starting". The restart count is baselined
# the first time the container is seen running (each call starts over, so a
# restart during attach_prompts, e.g. from Ctrl+C, isn't a crash loop); if it
# then exits or restarts, "not running (...)" instead.
poll_server() {
  local n=$1 c="boxen-$1" st run0="" run i
  for (( i = 0; i < 20; i++ )); do
    run=$(docker inspect -f '{{.State.Running}} {{.RestartCount}}' "$c" 2>/dev/null) || run="missing"
    if [[ "$run" == true* ]]; then
      [[ -n "$run0" ]] || run0=$run
      if [[ "$run" != "$run0" ]]; then
        echo "not running (running/restarts: $run)"
        return
      fi
      st=$(server_state "$n")
      [[ "$st" == starting ]] || { echo "$st"; return; }
    elif [[ -n "$run0" ]] || (( i >= 3 )); then
      # Stopped after running, or never came up within a few seconds.
      echo "not running (running/restarts: $run)"
      return
    fi
    sleep 1
  done
  echo starting
}

# wait_server NAME [PREFIX]: after a start, wait for the project's Remote
# Control server to connect and print one line about it ("NAME: PREFIXconnected").
# A server stuck at a one-time question gets answered through attach_prompts
# when there's a terminal, or drive_prompts in agent mode. Returns 1 when
# the project still needs you (3 when it needs an approval).
wait_server() {
  local n=$1 pre=${2:-} st
  st=$(poll_server "$n")
  case $st in
    "not trusted"*|"waiting for an answer"*)
      if agent_mode; then
        drive_prompts "$n" || return $?
        st=$(poll_server "$n")
      elif [[ -t 0 ]]; then
        attach_prompts "$n" || return 1
        st=$(poll_server "$n")
      else
        echo "$n: ${pre}waiting for an answer — run 'boxen up $n' from a terminal"
        return 1
      fi ;;
  esac
  case $st in
    connected|reconnecting)
      echo "$n: $pre$st" ;;
    starting)
      echo "$n: ${pre}still starting (check 'boxen ls' in a moment)" ;;
    "not signed in"*)
      echo "$n: ${pre}not signed in — run 'boxen login'"
      return 1 ;;
    "not running"*)
      warn "$n isn't staying up ${st#not running }. Last log lines:"
      dc "$n" logs --no-log-prefix --tail=30 claude 2>&1 | plain_text >&2 || true
      warn "fix the cause, then 'boxen up $n'. If it's a sign-in problem: 'boxen login'."
      return 1 ;;
    *)
      echo "$n: $pre$st"
      return 1 ;;
  esac
}

# start_project NAME [compose up args]: refresh the GitHub token, bring the
# container up (output hidden unless it fails), then wait_server.
start_project() {
  local n=$1
  shift
  refresh_project "$n" || true
  run_quiet "starting $n" dc "$n" up -d "$@" || return 1
  wait_server "$n"
}

# write_override_example NAME: a commented compose.override.example.yaml in
# the project dir, unless the project already has its own override.
write_override_example() {
  local pdir
  pdir=$(proj_dir "$1")
  [[ -e "$pdir/compose.override.yaml" ]] && return 0
  render "$BOXEN_REPO/templates/compose.override.example.yaml" "$1" "$SRC_ROOT/$1" \
    > "$pdir/compose.override.example.yaml"
}

# rerender_compose NAME [OLD_TEMPLATE]: replace the project's compose.yaml
# with a render of the current template. A file that differs from the new
# render and from the render of the template it came from (OLD_TEMPLATE, when
# known) was edited by hand: it's kept as compose.yaml.old and said so. A
# compose.yaml.bak from an older boxen goes if it's just the old template.
rerender_compose() {
  local n=$1 oldt=${2:-} pdir new old
  pdir=$(proj_dir "$n")
  new=$(mktemp)
  old=$(mktemp)
  render "$(compose_template "$n")" "$n" "$SRC_ROOT/$n" > "$new"
  if [[ -n "$oldt" && -s "$oldt" ]]; then render "$oldt" "$n" "$SRC_ROOT/$n" > "$old"; fi
  if ! cmp -s "$pdir/compose.yaml" "$new" && ! cmp -s "$pdir/compose.yaml" "$old"; then
    mv -f "$pdir/compose.yaml" "$pdir/compose.yaml.old"
    echo "$n: compose.yaml had your edits; kept as compose.yaml.old — move them to compose.override.yaml"
  fi
  mv -f "$new" "$pdir/compose.yaml"
  chmod 0644 "$pdir/compose.yaml"
  if [[ -f "$pdir/compose.yaml.bak" ]] && cmp -s "$pdir/compose.yaml.bak" "$old"; then
    rm -f "$pdir/compose.yaml.bak"
  fi
  rm -f "$old"
}

# create_project NAME: write the project's compose.yaml and Dockerfile and
# build its image. Its code folder (~/src/NAME) must already exist.
create_project() {
  local name=$1 pdir src errf rc=0
  pdir=$(proj_dir "$name")
  src="$SRC_ROOT/$name"
  # Create the token dir yourself so Docker doesn't create it root-owned.
  mkdir -p "$pdir"
  mkdir_private "$(token_dir "$name")"
  render "$(compose_template "$name")" "$name" "$src" > "$pdir/compose.yaml"
  render "$BOXEN_REPO/templates/Dockerfile"   "$name" "$src" > "$pdir/Dockerfile"
  write_override_example "$name"
  printf '\033[1;34m==>\033[0m building image for %s...' "$name"
  errf=$(mktemp)
  run_quiet "building image for $name" dc "$name" build 2>"$errf" || rc=$?
  if (( rc )); then echo; cat "$errf" >&2; else echo " done"; fi
  rm -f "$errf"
  return "$rc"
}

# Set by cmd_new so a failed or interrupted run can be retried cleanly.
NEW_NAME="" NEW_PDIR="" NEW_SRC="" NEW_CREATED_SRC=0
new_cleanup() {
  local rc=$?
  [[ -n "$NEW_PDIR" ]] || return 0
  warn "'new $NEW_NAME' didn't finish (exit $rc); cleaning up so you can retry"
  if [[ -f "$NEW_PDIR/compose.yaml" ]]; then
    dc "$NEW_NAME" down --rmi all >/dev/null 2>&1 || true
  fi
  rm -rf "$NEW_PDIR"
  # Only remove the code dir if this run created it (e.g. a half-finished clone).
  if [[ "$NEW_CREATED_SRC" == 1 ]]; then rm -rf "$NEW_SRC"; fi
}

cmd_new() {
  local name="" url="" pos=()
  while (( $# )); do
    case $1 in
      --*) start_opts "$@"; break ;;    # options come after name [git-url]
      *)   pos+=("$1"); shift ;;
    esac
  done
  name=${pos[0]:-} url=${pos[1]:-}
  (( ${#pos[@]} <= 2 )) || die "usage: boxen new <name> [git-url] [--approve trust]"
  [[ -n "$name" ]] || die "usage: boxen new <name> [git-url]  (git-url optional; GitHub URL to clone)"
  if [[ -n "$url" ]] && ! github_repo "$url" >/dev/null && [[ "$url" == git@* || "$url" == ssh://* ]]; then
    die "only github.com repos can be cloned over SSH-style URLs (containers have no SSH keys); use the https:// URL"
  fi
  valid_name "$name"
  [[ "$name" != all ]] || die "'all' is reserved (it means every project); pick another name"
  [[ "$name" != supervisor ]] || die "'supervisor' is reserved; 'boxen supervisor' creates that project"
  require_setup

  local pdir src
  pdir=$(proj_dir "$name")
  src="$SRC_ROOT/$name"

  [[ -e "$pdir" ]] && die "project '$name' already exists ($pdir)"
  if [[ -n "$url" && -d "$src" && -n "$(ls -A "$src")" ]]; then
    die "$src already has files; can't clone into it (omit the url to use it as-is)"
  fi

  NEW_NAME=$name NEW_PDIR=$pdir NEW_SRC=$src NEW_CREATED_SRC=0
  [[ -d "$src" ]] || NEW_CREATED_SRC=1
  trap new_cleanup EXIT

  # Create the code dir yourself so Docker doesn't create it root-owned.
  mkdir -p "$src"
  # Sign in before building anything, so a missing login fails fast.
  ensure_login
  create_project "$name"

  if [[ -n "$url" ]]; then
    if app_configured; then
      local repo
      repo=$(github_repo "$url") || die "'$url' isn't a github.com repo URL"
      local rc=0
      mint_token "$repo" "$(token_dir "$name")" >/dev/null || rc=$?
      if (( rc == 2 )); then
        info "$repo isn't yours, so there's no token for it; cloning works if it's public. To push changes, fork it and clone your fork."
      elif (( rc )); then
        die "no GitHub token for $repo, so it can't be cloned (see above)"
      fi
    else
      warn "GitHub isn't set up ('boxen github'); cloning a private repo will fail unless GH_TOKEN is in boxen.env"
    fi
    info "cloning $url"
    run_quiet "cloning $url" dc "$name" run --rm --no-deps -T claude git clone "$url" .
  fi

  # From here on the project exists; keep it even if the start needs a retry.
  trap - EXIT
  NEW_PDIR=""
  start_project "$name"
  info "done: '$name' is in the Claude app under Code."
}

# ------------------------------------------------------------- supervisor
#
# The supervisor is a project like any other, except that inside it, `boxen`
# is a client (base/boxen-client) that reaches bin/boxen-agentd on the VM
# through a socket mounted into the container, and may only run an
# allowlisted set of boxen commands, with BOXEN_AGENT=1 (see agent_mode).
# Its CLAUDE.md (templates/supervisor.CLAUDE.md) is what makes it a
# supervisor; boxen owns that file: it lives in the project dir, is mounted
# read-only over ~/src/supervisor/CLAUDE.md (so the supervisor can't edit
# its own rules), and is rewritten here and on self-update.

AGENT_DIR="$BOXEN_HOME/agent"
AGENT_SOCK="$AGENT_DIR/agent.sock"

write_supervisor_claude_md() {
  local pdir
  pdir=$(proj_dir supervisor)
  mkdir -p "$pdir" "$SRC_ROOT/supervisor"
  cp "$BOXEN_REPO/templates/supervisor.CLAUDE.md" "$pdir/CLAUDE.md"
  chmod 0644 "$pdir/CLAUDE.md"
}

cmd_supervisor() {
  (( $# == 0 )) || die "usage: boxen supervisor"
  need_tty supervisor
  require_setup
  local name=supervisor pdir
  pdir=$(proj_dir "$name")
  # The socket's folder, mounted into the container (a folder, not the
  # socket itself: boxen-agentd recreates the socket when it restarts, and a
  # mount of the file would keep pointing at the old one). Created here so
  # Docker doesn't create it root-owned.
  mkdir_private "$AGENT_DIR"
  [[ -S "$AGENT_SOCK" ]] || warn "boxen-agent isn't running (no $AGENT_SOCK); re-run $BOXEN_REPO/install.sh, which sets it up"
  write_supervisor_claude_md
  ensure_login
  if [[ -f "$pdir/compose.yaml" ]]; then
    rerender_compose "$name"
    write_override_example "$name"
  else
    create_project "$name"
  fi
  start_project "$name"
  info "done: 'boxen supervisor' is in the Claude app under Code. Ask it what's running."
}

# -------------------------------------------------------------- day to day

# Each project's container, whether its server is actually connected (a
# running container can hold a server stuck at a question), and its GitHub
# token.
cmd_ls() {
  printf '%-24s %-20s %-42s %s\n' PROJECT CONTAINER SERVER GITHUB
  local n c st
  while read -r n; do
    c=$(docker inspect -f '{{.State.Status}} {{.RestartCount}}' "boxen-$n" 2>/dev/null) || c="-"
    st="-"
    [[ $c == running* ]] && st=$(server_state "$n")
    [[ $c == *" 0" ]] && c=${c% 0}
    [[ $c == *" "* ]] && c="${c% *} (${c##* } restarts)"
    [[ $c == "-" ]] && c="not created"
    printf '%-24s %-20s %-42s %s\n' "$n" "$c" "$st" "$(token_state "$n")"
  done < <(projects)
}

# start_opts [--approve trust]: the options up, restart and new take after
# the name. In agent mode, --approve trust answers the folder's trust
# question (see drive_prompts); from a terminal you answer it yourself.
start_opts() {
  while (( $# )); do
    case $1 in
      --approve) [[ "${2:-}" == trust ]] || die "--approve takes 'trust' (e.g. boxen up <name> --approve trust)"; APPROVE_TRUST=1; shift ;;
      --approve=trust) APPROVE_TRUST=1 ;;
      *) die "unknown option '$1' (options: --approve trust)" ;;
    esac
    shift
  done
}

# An approval is for one project's question: never `up all --approve trust`.
no_approve_all() {
  local a
  [[ "${1:-}" == all ]] || return 0
  for a in "${@:2}"; do
    [[ "$a" != --approve* ]] || die "approve one project at a time (boxen up <name> --approve trust), not all"
  done
}

cmd_up()      { require_project "${1:-}"; start_opts "${@:2}"; start_project "$1"; }
cmd_restart() { require_project "${1:-}"; start_opts "${@:2}"; start_project "$1" --force-recreate; }
cmd_down() {
  require_project "${1:-}"
  run_quiet "stopping $1" dc "$1" down || return 1
  echo "$1: stopped"
}

cmd_logs() {
  require_project "${1:-}"
  local n=$1 tail=100 args=()
  shift
  while (( $# )); do
    case $1 in
      --tail)   tail=${2:-}; shift ;;
      --tail=*) tail=${1#--tail=} ;;
      -f|--follow)
        if agent_mode; then
          printf 'boxen: logs -f isn'"'"'t available here; use --tail\n' >&2
          exit 2
        fi
        args+=("$1") ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  [[ "$tail" =~ ^[0-9]+$ ]] && (( tail >= 1 && tail <= 5000 )) || die "--tail needs a number of lines, 1 to 5000"
  # The server writes to a terminal, so its log is full of screen-control
  # codes (cursor moves, clears) that would scramble yours; print the text.
  dc "$n" logs --no-log-prefix --tail="$tail" "${args[@]}" claude 2>&1 | plain_text
}

cmd_shell() {
  need_tty shell
  require_project "${1:-}"
  docker exec -it "boxen-$1" bash
}

cmd_claude() {
  need_tty claude
  require_project "${1:-}"
  local n=$1; shift
  docker exec -it "boxen-$n" claude "$@"
}

# resume NAME [N|ID] [--stop|--attach|--force]: earlier sessions, in a
# numbered list; picking one puts it in the Claude app with its history. The
# work happens inside the container (boxen-sessions).
cmd_resume() {
  require_project "${1:-}"
  local n=$1 a
  shift
  [[ "$(docker inspect -f '{{.State.Running}}' "boxen-$n" 2>/dev/null || true)" == true ]] \
    || die "$n isn't running; start it with 'boxen up $n'"
  if agent_mode; then
    for a in "$@"; do [[ "$a" != --attach ]] || need_tty "resume --attach"; done
    docker exec -i -e BOXEN_AGENT=1 "boxen-$n" boxen-sessions resume "$@"
  else
    docker exec -it "boxen-$n" boxen-sessions resume "$@"
  fi
}

cmd_rm() {
  require_project "${1:-}"
  local name=$1 ans yes=0 q
  shift
  while (( $# )); do
    case $1 in
      --yes|-y) yes=1 ;;
      *) die "usage: boxen rm <name> [--yes]" ;;
    esac
    shift
  done
  q="Remove container, image and config for '$name'? Code in $SRC_ROOT/$name is kept."
  if (( ! yes )); then
    if agent_mode; then
      approval_needed rm "$name" "boxen rm $name --yes" <<<"$q" || return $?
    fi
    read -rp "$q [y/N] " ans
    [[ "$ans" == [yY] ]] || { echo "aborted"; return; }
  fi
  run_quiet "removing $name" dc "$name" down --rmi all || return 1
  rm -rf "$(proj_dir "$name")"
  info "removed '$name'. Code in $SRC_ROOT/$name and its Claude history in the shared config are kept."
}

# ------------------------------------------------------------- maintenance

# update_one NAME: rebuild the project's image (cached), recreate its
# container and wait for the server. One line of output.
update_one() {
  local n=$1
  run_quiet "building image for $n" dc "$n" build || return 1
  refresh_project "$n" || true
  run_quiet "starting $n" dc "$n" up -d --force-recreate || return 1
  wait_server "$n" "rebuilt, "
}

cmd_update() {
  local n failed=() list=()
  if [[ -n "${1:-}" && "$1" != all ]]; then
    require_project "$1"
    update_one "$1"
    return
  fi
  build_base --fresh || exit 1
  mapfile -t list < <(projects)
  for n in "${list[@]}"; do
    update_one "$n" || failed+=("$n")
  done
  docker image prune -f >/dev/null
  docker builder prune -f --filter until=720h >/dev/null
  if (( ${#failed[@]} )); then
    die "update finished, but these projects failed: ${failed[*]}"
  fi
  info "update done"
}

# Hidden for one release: the previous self-update told upgraders to run
# these. `regen` re-renders compose.yaml (hand edits kept as .old) and starts
# the project; `rebuild` is `update`. Remove next release.
cmd_regen() {
  require_project "${1:-}"
  rerender_compose "$1"
  write_override_example "$1"
  mkdir_private "$(token_dir "$1")"
  start_project "$1"
}

cmd_self_update() {
  local old new changed n list=() failed=() mode=none oldt
  old=$(git -C "$BOXEN_REPO" rev-parse HEAD)
  run_quiet "git pull" git -C "$BOXEN_REPO" pull --ff-only \
    || die "couldn't fast-forward $BOXEN_REPO. If you edited files there, move those changes to ~/.config/boxen (see README, Customizing) and retry."
  new=$(git -C "$BOXEN_REPO" rev-parse HEAD)
  if [[ "$old" == "$new" ]]; then
    info "boxen is already up to date"
    return 0
  fi
  info "updated boxen:"
  git -C "$BOXEN_REPO" log --oneline --no-decorate "$old..$new" | sed 's/^/    /'
  changed=$(git -C "$BOXEN_REPO" diff --name-only "$old" "$new")

  # The new installer: VM prerequisites, PATH link, base image. (This script
  # keeps running from the old copy it already opened, which is fine.)
  info "running the updated installer"
  BOXEN_SELF_UPDATE=1 "$BOXEN_REPO/install.sh"

  mapfile -t list < <(projects)
  if (( ${#list[@]} == 0 )); then
    info "self-update done"
    return 0
  fi

  # Every project's compose.yaml comes from the template (settings of your
  # own belong in compose.override.yaml). Hand edits are kept as .old.
  oldt=$(mktemp)
  for n in "${list[@]}"; do
    git -C "$BOXEN_REPO" show "$old:templates/$(basename "$(compose_template "$n")")" > "$oldt" 2>/dev/null || true
    rerender_compose "$n" "$oldt"
    write_override_example "$n"
    mkdir_private "$(token_dir "$n")"
    [[ "$n" != supervisor ]] || write_supervisor_claude_md
  done
  rm -f "$oldt"

  # A changed base image means new project images; a changed compose template
  # means `up` (compose recreates only what differs).
  if grep -qE '^base/' <<<"$changed"; then
    mode=rebuild
  elif grep -qE '^templates/compose(\.supervisor)?\.yaml$' <<<"$changed"; then
    mode=up
  fi
  if [[ "$mode" != none ]]; then
    info "applying to projects (servers restart; app sessions reconnect on their own)"
    for n in "${list[@]}"; do
      case $mode in
        rebuild) update_one "$n" || failed+=("$n") ;;
        up)      start_project "$n" || failed+=("$n") ;;
      esac
    done
  fi
  if (( ${#failed[@]} )); then
    die "self-update finished, but these projects failed: ${failed[*]}"
  fi
  info "self-update done"
}

# ------------------------------------------------------------------- main

cmd=${1:-help}
shift || true
case "$cmd" in
  new)      cmd_new "$@" ;;
  supervisor) cmd_supervisor "$@" ;;
  ls|list)  cmd_ls ;;
  up)       no_approve_all "$@"; each cmd_up "$@" ;;
  down)     each cmd_down "$@" ;;
  restart)  no_approve_all "$@"; each cmd_restart "$@" ;;
  logs)     cmd_logs "$@" ;;
  shell)    cmd_shell "$@" ;;
  claude)   cmd_claude "$@" ;;
  resume)   cmd_resume "$@" ;;
  rm)       cmd_rm "$@" ;;
  github)   cmd_github "$@" ;;
  login)    cmd_login ;;
  update)   cmd_update "$@" ;;
  self-update) cmd_self_update ;;
  import-mac)
    need_tty import-mac
    # shellcheck source=lib/import-mac.sh
    source "$BOXEN_REPO/lib/import-mac.sh"
    cmd_import_mac "$@" ;;
  setup)    cmd_setup "$@" ;;
  tokens)   cmd_tokens "$@" ;;
  regen)    each cmd_regen "$@" ;;
  rebuild)  cmd_update "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
