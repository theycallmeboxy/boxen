#!/usr/bin/env bash
# boxen: manage per-project Claude Code containers on this VM.
#
# Layout:
#   <clone>/                          this repo: script, base image, templates
#   ~/.config/boxen/boxen.env         shared env for all containers (BOXEN_HOME)
#   ~/.config/boxen/base.local.Dockerfile   optional: your additions to the base image
#   ~/.config/boxen/projects/<name>/  compose.yaml, Dockerfile, optional project.env
#   ~/src/<name>/                     the project's code (BOXEN_SRC); same path inside
#   docker volume claude-config       shared ~/.claude for every container
set -euo pipefail

# The repo is wherever this script really lives (it's usually symlinked into ~/.local/bin).
BOXEN_REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BOXEN_HOME="${BOXEN_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/boxen}"
SRC_ROOT="$(realpath -m "${BOXEN_SRC:-$HOME/src}")"
PROJECTS_DIR="$BOXEN_HOME/projects"
ENV_FILE="$BOXEN_HOME/boxen.env"
LOCAL_BASE="$BOXEN_HOME/base.local.Dockerfile"
CORE_IMAGE="boxen-base:core"
BASE_IMAGE="boxen-base:latest"
CONFIG_VOLUME="claude-config"

# Identity for the container user. Use the passwd entry for the GID: under
# `sg docker` (install.sh), plain `id -g` would report the docker group.
USER_NAME="$(id -un)"
USER_UID="$(id -u)"
USER_GID="$(id -g "$USER_NAME")"
CHOME="/home/$USER_NAME"

die()  { printf 'boxen: %s\n' "$*" >&2; exit 1; }
warn() { printf 'boxen: %s\n' "$*" >&2; }
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

usage() {
  cat <<'EOF'
Usage: boxen <command> [args]

Setup
  setup                     First-time setup: env file, config volume, base image
  new <name> [git-url]      Create a project and start its container.
                            git-url: optional HTTPS GitHub URL to clone into
                            ~/src/<name>. Omit it for a new empty project, or
                            when ~/src/<name> already holds your code.
  login                     Sign in to Claude again (shared by all projects),
                            then restart running projects
  import <dir>              Copy CLAUDE.md, rules/, skills/, agents/, commands/
                            from <dir> (e.g. a copy of your Mac's ~/.claude)
                            into the shared config
  config                    Shell in the shared ~/.claude (edit CLAUDE.md etc.)

Day to day
  ls                        List projects and container status
  up <name>                 Start (or apply boxen.env / project.env changes)
  down <name>               Stop
  restart <name>            Recreate the container (picks up env changes)
  logs <name> [-f]          Show the Remote Control server's output
  shell <name>              Bash shell inside the container
  claude <name> [args]      Interactive Claude session in the container's terminal
  trust <name>              Re-run the one-time trust / Remote Control prompts

Maintenance
  rebuild <name>            Rebuild one project image and recreate its container
  regen <name>              Re-render compose.yaml from the current template
                            (old one saved as compose.yaml.bak)
  update                    Rebuild base (fresh Ubuntu + Claude Code), then all projects
  rm <name>                 Remove a project's container, image and config
                            (leaves ~/src/<name> alone)
  self-update               git pull this boxen repo (then run 'update' to apply)
EOF
}

valid_name() {
  [[ "$1" =~ ^[a-z0-9]+([_-][a-z0-9]+)*$ && ${#1} -le 40 ]] \
    || die "invalid project name '$1' (lowercase letters and digits, single '-' or '_' between them, max 40 chars)"
}

proj_dir() { printf '%s/%s' "$PROJECTS_DIR" "$1"; }

require_project() {
  [[ -n "${1:-}" ]] || die "missing project name (see 'boxen help')"
  valid_name "$1"
  [[ -f "$(proj_dir "$1")/compose.yaml" ]] || die "no such project: $1"
}

require_setup() {
  [[ -f "$ENV_FILE" ]] || die "run 'boxen setup' first"
  docker image inspect "$BASE_IMAGE" >/dev/null 2>&1 || die "base image missing; run 'boxen setup'"
  docker volume inspect "$CONFIG_VOLUME" >/dev/null 2>&1 || die "volume $CONFIG_VOLUME missing; run 'boxen setup'"
}

# docker compose scoped to one project's directory.
dc() {
  local name=$1; shift
  local dir; dir=$(proj_dir "$name")
  docker compose --project-directory "$dir" -f "$dir/compose.yaml" "$@"
}

# One-off container from the base image with the shared config mounted.
run_base() {
  docker run --rm "$@"
}
base_args() {
  printf '%s\n' -v "$CONFIG_VOLUME:$CHOME/.claude" -e "CLAUDE_CONFIG_DIR=$CHOME/.claude"
}

projects() {
  shopt -s nullglob
  local d
  for d in "$PROJECTS_DIR"/*/; do basename "$d"; done
}

# ---------------------------------------------------------------- setup

build_base() {
  # --fresh: re-pull Ubuntu and skip the cache so apt picks up new
  # packages (including Claude Code) in both layers.
  local core_extra=() local_extra=()
  if [[ "${1:-}" == "--fresh" ]]; then
    core_extra=(--pull --no-cache)
    local_extra=(--no-cache)
  fi
  info "building $CORE_IMAGE"
  docker build "${core_extra[@]}" -t "$CORE_IMAGE" \
    --build-arg USERNAME="$USER_NAME" \
    --build-arg USER_UID="$USER_UID" \
    --build-arg USER_GID="$USER_GID" \
    "$BOXEN_REPO/base"
  if [[ -f "$LOCAL_BASE" ]]; then
    info "applying $LOCAL_BASE"
    # Built from stdin with no context, so nothing in ~/.config/boxen
    # (like boxen.env) is ever sent to the builder.
    docker build "${local_extra[@]}" -t "$BASE_IMAGE" - < "$LOCAL_BASE"
  else
    docker tag "$CORE_IMAGE" "$BASE_IMAGE"
  fi
}

cmd_setup() {
  command -v docker >/dev/null || die "docker not found"
  docker compose version >/dev/null 2>&1 || die "docker compose plugin not found"
  docker info >/dev/null 2>&1 || die "can't talk to the docker daemon (is your user in the docker group?)"

  mkdir -p "$PROJECTS_DIR" "$SRC_ROOT"

  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$BOXEN_REPO/templates/boxen.env" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "created $ENV_FILE (add your GitHub token and git identity)"
  fi

  build_base

  if ! docker volume inspect "$CONFIG_VOLUME" >/dev/null 2>&1; then
    docker volume create "$CONFIG_VOLUME" >/dev/null
    info "created volume $CONFIG_VOLUME"
  fi
  # Make sure the shared config volume belongs to you, not root.
  docker run --rm --user root -v "$CONFIG_VOLUME:/v" "$BASE_IMAGE" \
    chown "$USER_UID:$USER_GID" /v

  info "setup done. Next: edit $ENV_FILE, then 'boxen new <name> [git-url]'"
}

# ------------------------------------------------------- shared config / login

# True when the shared config holds a claude.ai login, which Remote Control
# requires (API keys and setup-token tokens don't work for it).
logged_in() {
  local args; mapfile -t args < <(base_args)
  run_base "${args[@]}" "$BASE_IMAGE" \
    sh -c 'claude auth status 2>/dev/null | jq -e ".authMethod == \"claude.ai\"" >/dev/null'
}

do_login() {
  local args; mapfile -t args < <(base_args)
  echo "    Open the URL it prints on any device, sign in with your claude.ai account,"
  echo "    and paste the code back here."
  run_base -it "${args[@]}" "$BASE_IMAGE" claude auth login
}

ensure_login() {
  logged_in && return
  info "Claude isn't signed in (with a claude.ai account) yet. Every project shares this login."
  do_login
  logged_in || die "still not signed in with a claude.ai account; run 'boxen login' to retry"
}

cmd_login() {
  require_setup
  do_login
  logged_in || die "sign-in didn't produce a claude.ai login"
  local n
  while read -r n; do
    if [[ "$(docker inspect -f '{{.State.Running}}' "boxen-$n" 2>/dev/null || true)" == true ]] \
       || [[ "$(docker inspect -f '{{.State.Restarting}}' "boxen-$n" 2>/dev/null || true)" == true ]]; then
      info "restarting $n"
      docker restart "boxen-$n" >/dev/null
    fi
  done < <(projects)
  info "signed in"
}

cmd_import() {
  local dir=${1:-}
  [[ -n "$dir" && -d "$dir" ]] || die "usage: boxen import <dir>  (a directory with CLAUDE.md, rules/, skills/ ...)"
  require_setup
  dir=$(realpath "$dir")
  local args; mapfile -t args < <(base_args)
  # shellcheck disable=SC2016  # expanded inside the container
  run_base "${args[@]}" -v "$dir:/import:ro" "$BASE_IMAGE" bash -c '
    cd /import
    found=0
    for f in CLAUDE.md rules skills agents commands; do
      if [ -e "$f" ]; then cp -a "$f" "$CLAUDE_CONFIG_DIR/" && echo "imported $f"; found=1; fi
    done
    [ "$found" = 1 ] || echo "nothing to import (looked for CLAUDE.md rules skills agents commands)"'
}

cmd_config() {
  require_setup
  local args; mapfile -t args < <(base_args)
  info "shared ~/.claude; changes apply to every project. 'exit' when done."
  run_base -it "${args[@]}" -w "$CHOME/.claude" "$BASE_IMAGE" bash
}

# ------------------------------------------------------------ new project

# Escape a value for use as a sed replacement (we use | as the delimiter).
sed_esc() { printf '%s' "$1" | sed -e 's/[&|\\]/\\&/g'; }

render() {
  # $1 template, $2 name, $3 source dir
  sed -e "s|__NAME__|$(sed_esc "$2")|g" \
      -e "s|__USER__|$(sed_esc "$USER_NAME")|g" \
      -e "s|__CHOME__|$(sed_esc "$CHOME")|g" \
      -e "s|__SRC__|$(sed_esc "$3")|g" "$1"
}

first_run() {
  local name=$1
  cat <<EOF

==> One-time prompts for '$name'
    Claude will ask you to trust this folder and, the very first time ever,
    to enable Remote Control. Answer y to each.
    When it shows the session URL / QR code, press Ctrl+C to continue.

EOF
  read -rp "Press Enter to start... " _
  trap ':' INT
  dc "$name" run --rm --no-deps claude claude remote-control --name "$name" || true
  trap - INT
}

# After `up`, make sure the server stays running instead of crash-looping.
check_running() {
  local n=$1 st
  info "checking that $n stays up (15s)"
  sleep 15
  st=$(docker inspect -f '{{.State.Running}} {{.RestartCount}}' "boxen-$n" 2>/dev/null) || st="missing"
  if [[ "$st" != "true 0" ]]; then
    warn "$n isn't staying up (running/restarts: $st). Last log lines:"
    dc "$n" logs --tail=30 claude >&2 || true
    warn "fix the cause, then 'boxen up $n'. If it's a sign-in problem: 'boxen login'."
    return 1
  fi
}

# Set by cmd_new so a failed or interrupted run can be retried cleanly.
NEW_NAME="" NEW_PDIR="" NEW_SRC="" NEW_CREATED_SRC=0
new_cleanup() {
  local rc=$?
  [[ -n "$NEW_PDIR" ]] || return 0
  warn "'new $NEW_NAME' didn't finish (exit $rc); cleaning up so you can retry"
  if [[ -f "$NEW_PDIR/compose.yaml" ]]; then
    dc "$NEW_NAME" down --rmi all >/dev/null 2>&1 || true
  fi
  rm -rf "$NEW_PDIR"
  # Only remove the code dir if this run created it (e.g. a half-finished clone).
  if [[ "$NEW_CREATED_SRC" == 1 ]]; then rm -rf "$NEW_SRC"; fi
}

cmd_new() {
  local name=${1:-} url=${2:-}
  [[ -n "$name" ]] || die "usage: boxen new <name> [git-url]  (git-url optional; HTTPS GitHub URL to clone)"
  if [[ "$url" == git@* || "$url" == ssh://* ]]; then
    die "use the HTTPS form of the URL (https://github.com/owner/repo.git); containers authenticate with GH_TOKEN, not SSH keys"
  fi
  valid_name "$name"
  require_setup

  local pdir src
  pdir=$(proj_dir "$name")
  src="$SRC_ROOT/$name"

  [[ -e "$pdir" ]] && die "project '$name' already exists ($pdir)"
  if [[ -n "$url" && -d "$src" && -n "$(ls -A "$src")" ]]; then
    die "$src already has files; can't clone into it (omit the url to use it as-is)"
  fi

  NEW_NAME=$name NEW_PDIR=$pdir NEW_SRC=$src NEW_CREATED_SRC=0
  [[ -d "$src" ]] || NEW_CREATED_SRC=1
  trap new_cleanup EXIT

  # Create the code dir yourself so Docker doesn't create it root-owned.
  mkdir -p "$src" "$pdir"
  render "$BOXEN_REPO/templates/compose.yaml" "$name" "$src" > "$pdir/compose.yaml"
  render "$BOXEN_REPO/templates/Dockerfile"   "$name" "$src" > "$pdir/Dockerfile"

  info "building image for $name"
  dc "$name" build

  if [[ -n "$url" ]]; then
    info "cloning $url"
    dc "$name" run --rm --no-deps -T claude git clone "$url" .
  fi

  ensure_login
  first_run "$name"

  info "starting $name"
  dc "$name" up -d

  # From here on the project exists; keep it even if the health check fails.
  trap - EXIT
  NEW_PDIR=""
  check_running "$name"
  info "done. '$name' is in the Claude app under Code. 'boxen logs $name' shows the server."
}

# -------------------------------------------------------------- day to day

cmd_ls() {
  printf '%-24s %s\n' PROJECT STATUS
  local n st
  while read -r n; do
    st=$(docker inspect -f '{{.State.Status}}  (restarts: {{.RestartCount}}, started {{.State.StartedAt}})' \
           "boxen-$n" 2>/dev/null) || st="not created"
    printf '%-24s %s\n' "$n" "$st"
  done < <(projects)
}

cmd_up()      { require_project "${1:-}"; dc "$1" up -d; }
cmd_down()    { require_project "${1:-}"; dc "$1" down; }
cmd_restart() { require_project "${1:-}"; dc "$1" up -d --force-recreate; }

cmd_logs() {
  require_project "${1:-}"
  local n=$1; shift
  dc "$n" logs --tail=100 "$@" claude
}

cmd_shell() {
  require_project "${1:-}"
  docker exec -it "boxen-$1" bash
}

cmd_claude() {
  require_project "${1:-}"
  local n=$1; shift
  docker exec -it "boxen-$n" claude "$@"
}

cmd_trust() {
  require_project "${1:-}"
  dc "$1" down
  first_run "$1"
  dc "$1" up -d
  check_running "$1"
}

# ------------------------------------------------------------- maintenance

rebuild_one() {
  info "rebuilding $1"
  dc "$1" build && dc "$1" up -d --force-recreate
}

cmd_rebuild() {
  require_project "${1:-}"
  echo "Recreating the container restarts its Remote Control server;"
  echo "sessions reconnect on their own, but a turn in progress is interrupted."
  rebuild_one "$1"
}

cmd_regen() {
  require_project "${1:-}"
  local pdir; pdir=$(proj_dir "$1")
  cp "$pdir/compose.yaml" "$pdir/compose.yaml.bak"
  render "$BOXEN_REPO/templates/compose.yaml" "$1" "$SRC_ROOT/$1" > "$pdir/compose.yaml"
  info "re-rendered $pdir/compose.yaml (old one in compose.yaml.bak; diff them if you'd edited it)"
  dc "$1" up -d
}

cmd_update() {
  build_base --fresh
  local n failed=()
  while read -r n; do
    rebuild_one "$n" || failed+=("$n")
  done < <(projects)
  info "pruning dangling images and old build cache"
  docker image prune -f >/dev/null
  docker builder prune -f --filter until=720h >/dev/null
  if (( ${#failed[@]} )); then
    die "update finished, but these projects failed to rebuild: ${failed[*]}"
  fi
  info "update done"
}

cmd_rm() {
  require_project "${1:-}"
  local name=$1 ans
  read -rp "Remove container, image and config for '$name'? Code in $SRC_ROOT/$name is kept. [y/N] " ans
  [[ "$ans" == [yY] ]] || { echo "aborted"; return; }
  dc "$name" down --rmi all
  rm -rf "$(proj_dir "$name")"
  info "removed '$name'. Code in $SRC_ROOT/$name and its Claude history in the shared config are kept."
}

# ------------------------------------------------------------------- main

cmd=${1:-help}
shift || true
case "$cmd" in
  setup)    cmd_setup "$@" ;;
  new)      cmd_new "$@" ;;
  login)    cmd_login ;;
  import)   cmd_import "$@" ;;
  config)   cmd_config ;;
  ls|list)  cmd_ls ;;
  up)       cmd_up "$@" ;;
  down)     cmd_down "$@" ;;
  restart)  cmd_restart "$@" ;;
  logs)     cmd_logs "$@" ;;
  shell)    cmd_shell "$@" ;;
  claude)   cmd_claude "$@" ;;
  trust)    cmd_trust "$@" ;;
  rebuild)  cmd_rebuild "$@" ;;
  regen)    cmd_regen "$@" ;;
  update)   cmd_update ;;
  rm)       cmd_rm "$@" ;;
  self-update) git -C "$BOXEN_REPO" pull --ff-only ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
