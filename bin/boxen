#!/usr/bin/env bash
# boxen: Claude Code agents on this VM, one project folder each, each
# project's builds in its own container (rootless Docker).
#
# Layout:
#   <clone>/                          this repo
#   ~/src/<name>/                     a project: its agent's folder (BOXEN_SRC)
#   ~/src/<name>/.boxen/              its build container: Dockerfile, services.yaml
#                                     (the agent may edit these)
#   ~/.config/boxen/projects/<name>/  boxen's (agents can't write here): compose.yaml
#                                     (generated), compose.services.yaml (rendered from
#                                     services.yaml), compose.override.yaml (yours),
#                                     repos and token/ (GitHub), serve (marker),
#                                     compose.nonroot.yaml (boxen nonroot: its
#                                     seccomp profile, ~/.config/boxen/seccomp-userns.json)
#   ~/.config/boxen/gitconfig         git settings for repos under ~/src: the token
#                                     helper and the commit identity
#   ~/.claude/                        Claude Code, shared: boxen keeps the sandbox
#                                     settings and boxen.md there
set -euo pipefail

# The repo is wherever this script really lives (it's usually symlinked into ~/.local/bin).
BOXEN_BIN="$(readlink -f "${BASH_SOURCE[0]}")"
BOXEN_REPO="$(cd "$(dirname "$BOXEN_BIN")/.." && pwd)"
BOXEN_HOME="${BOXEN_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/boxen}"
SRC_ROOT="$(realpath -m "${BOXEN_SRC:-$HOME/src}")"
PROJECTS_DIR="$BOXEN_HOME/projects"
CORE_IMAGE="boxen-env:core"
ENV_IMAGE="boxen-env:latest"
LOCAL_ENV="$BOXEN_HOME/env.local.Dockerfile"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
GITCONFIG="$BOXEN_HOME/gitconfig"
FORMAT_MARK="# boxen-format: 2"

USER_UID="$(id -u)"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$USER_UID}"
DOCKER_SOCK="$RUNTIME_DIR/docker.sock"
# boxen only ever talks to your rootless Docker, never the system daemon
# (BOXEN_DOCKER_HOST points it elsewhere, for tests).
export DOCKER_HOST="${BOXEN_DOCKER_HOST:-unix://$DOCKER_SOCK}"

# Sessions and the dashboard live in a tmux server of boxen's own. It's
# started without DOCKER_HOST, so nothing in it inherits boxen's.
TMUX_CMD=(env -u DOCKER_HOST tmux -L boxen)
TMUX_CONF="$BOXEN_REPO/ui/tmux.conf"

die()  { printf 'boxen: %s\n' "$*" >&2; exit 1; }
# In timer runs (QUIET set), stamp warnings with the time for tokens.log.
warn() { printf '%sboxen: %s\n' "${QUIET:+$(date -Is) }" "$*" >&2; }
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

# run_quiet LABEL cmd...: run a command with its output hidden. On failure,
# print "LABEL failed:" and the last 40 lines of its output, and fail too.
run_quiet() {
  local label=$1 out rc=0
  shift
  out=$(mktemp)
  "$@" >"$out" 2>&1 || rc=$?
  if (( rc )); then
    printf 'boxen: %s failed:\n' "$label" >&2
    tail -n 40 "$out" >&2
  fi
  rm -f "$out"
  return "$rc"
}

usage() {
  cat <<'EOF'
Usage: boxen <command> [args]

Projects (~/src/<name>)
  new <name> [git-url]            Create a project (cloning git-url if given) and its build container
  ls [--json]                     Projects: build container, Claude sessions, serve, GitHub tokens
  claude <name> [args]            A Claude session in the project, in a tmux window (also in the app)
  serve [<name> [--off]]          Keep a Remote Control server up for a project, to start sessions from the app
  ui [--restart]                  The dashboard: projects, sessions, files and terminals (tmux)
  shell <name>                    A root shell in the project's build container
  up <name|all>                   Start a build container and its sidecars, applying any changes
  down <name|all>                 Stop them
  rm <name> [--yes]               Remove the build container, image, sidecars and their data, and boxen's
                                  config for it (override, repo list, tokens); the code stays
  repos <name> [add|rm <owner/repo>...]   The GitHub repos a project's tokens cover
  nonroot <name> [on|off]         Let the project's agent run builds as a non-root user (boxen run --user)
  df [<name>] [--json]            Disk use: each project's code, image, volumes and Claude history,
                                  what they share, leftovers and free space

In a project folder (what agents use; they act on the folder they're in)
  run [-C dir] [-u] cmd...        Run a command in the project's build container (-u, --user: as a
                                  non-root user whose files are still yours; boxen nonroot turns it on)
  run -d NAME cmd... | --logs NAME [-f] | --stop NAME | --ps   Background processes there
  env apply | show | logs <sidecar> [-f] [--tail N]   Apply .boxen/ changes; status; a sidecar's logs

Setup and upkeep
  github [--reset] [--key f.pem]  Connect GitHub: your app, per-project tokens, commit identity
  doctor [--lan <host:port>]      Check rootless Docker, the sandbox and isolation on this VM
  migrate [--yes | --cleanup]     Move a boxen v1 install (agents in containers) to this layout
  update                          Rebuild the base image and every project's build container
  self-update                     Update boxen itself and apply it
EOF
}

valid_name() {
  [[ "$1" =~ ^[a-z0-9]+([_-][a-z0-9]+)*$ && ${#1} -le 40 ]] \
    || die "invalid project name '$1' (lowercase letters and digits, single '-' or '_' between them, max 40 chars)"
}

# Names that mean something else to boxen or boxen ui.
RESERVED_NAMES=(all global dashboard ui)
not_reserved() {
  local r
  for r in "${RESERVED_NAMES[@]}"; do
    [[ "$1" != "$r" ]] || die "'$1' is reserved; pick another name"
  done
}

# ---------------------------------------------------------------- locks
#
# lock_project NAME: hold the project's lock (projects/NAME/.lock) for the
# rest of this process (or subshell), so two boxen commands never change a
# project at once. Doesn't wait: if it's held, say so and exit 2
# (LOCK_BUSY_RC). Every descriptor is kept in LOCK_FDS, and whatever might
# outlive boxen (install.sh, tmux) runs through nolocks, so no daemon ends
# up holding a lock.
LOCK_FDS=()
LOCK_BUSY_RC=2
lock_project() {
  local d fd
  d=$(proj_dir "$1")
  mkdir -p "$d"
  exec {fd}>>"$d/.lock"
  if [[ "${LOCK_WAIT:-0}" != 0 ]]; then
    flock -w "$LOCK_WAIT" "$fd" || { printf 'boxen: %s is busy (another boxen command has held it for %ss)\n' "$1" "$LOCK_WAIT" >&2; exit "$LOCK_BUSY_RC"; }
  else
    flock -n "$fd" || { printf 'boxen: %s is busy (another boxen command is running for it)\n' "$1" >&2; exit "$LOCK_BUSY_RC"; }
  fi
  LOCK_FDS+=("$fd")
}

lock_global() {
  local fd
  mkdir -p "$BOXEN_HOME"
  exec {fd}>>"$BOXEN_HOME/.global.lock"
  flock -n "$fd" || { printf 'boxen: busy (another update or self-update is running)\n' >&2; exit 2; }
  LOCK_FDS+=("$fd")
}

nolocks() {
  (
    local fd
    for fd in "${LOCK_FDS[@]}"; do exec {fd}>&-; done
    LOCK_FDS=()
    "$@"
  )
}

# locked NAME cmd...: run cmd in a subshell holding NAME's lock, for loops
# over every project: a busy one is skipped with exit 75 (BUSY_RC).
BUSY_RC=75
locked() {
  local n=$1
  shift
  ( LOCK_BUSY_RC=$BUSY_RC; lock_project "$n"; "$@" )
}

# each <fn> <name|all> [args...]: a per-project command for one project, or
# every project; failures and busy ones are listed at the end.
each() {
  local fn=$1
  shift
  if [[ "${1:-}" != all ]]; then
    "$fn" "$@"
    return
  fi
  shift
  local n r rc=0 failed=() busy=() list=()
  mapfile -t list < <(projects)
  (( ${#list[@]} )) || { info "no projects yet"; return 0; }
  for n in "${list[@]}"; do
    r=0
    ( LOCK_BUSY_RC=$BUSY_RC; "$fn" "$n" "$@" ) || r=$?
    if (( r == BUSY_RC )); then busy+=("$n"); (( rc )) || rc=2
    elif (( r )); then failed+=("$n"); rc=1; fi
  done
  (( ${#busy[@]} == 0 )) || warn "skipped, busy (another boxen command was running for them): ${busy[*]}"
  (( ${#failed[@]} == 0 )) || warn "failed for: ${failed[*]}"
  (( rc == 0 )) || exit "$rc"
}

# ---------------------------------------------------------------- paths

proj_dir() { printf '%s/%s' "$PROJECTS_DIR" "$1"; }
src_dir()  { printf '%s/%s' "$SRC_ROOT" "$1"; }
bdir()     { printf '%s/%s/.boxen' "$SRC_ROOT" "$1"; }

is_v2() { [[ -f "$(proj_dir "$1")/compose.yaml" ]] && grep -qxF "$FORMAT_MARK" "$(proj_dir "$1")/compose.yaml"; }

require_project() {
  [[ -n "${1:-}" ]] || die "missing project name (see 'boxen help')"
  valid_name "$1"
  [[ -f "$(proj_dir "$1")/compose.yaml" ]] || die "no such project: $1"
  is_v2 "$1" || die "$1 is a boxen v1 project (agent in a container); run 'boxen migrate' first"
}

# projects: every v2 project, by name. v1_projects: the ones migrate converts.
projects() {
  shopt -s nullglob
  local d n
  for d in "$PROJECTS_DIR"/*/; do
    d=${d%/}; n=${d##*/}
    is_v2 "$n" && printf '%s\n' "$n"
  done
  return 0
}
v1_projects() {
  shopt -s nullglob
  local d n
  for d in "$PROJECTS_DIR"/*/; do
    d=${d%/}; n=${d##*/}
    [[ -f "$d/compose.yaml" ]] && ! is_v2 "$n" && printf '%s\n' "$n"
  done
  return 0
}

# project_of_dir DIR: the project DIR (a physical path) is in, if any.
project_of_dir() {
  local rel n
  case "$1/" in
    "$SRC_ROOT"/?*/*) ;;
    *) return 1 ;;
  esac
  rel=${1#"$SRC_ROOT"/}
  n=${rel%%/*}
  [[ "$n" =~ ^[a-z0-9]+([_-][a-z0-9]+)*$ ]] && is_v2 "$n" || return 1
  printf '%s\n' "$n"
}

# project_here: the project of the current folder, in HERE (or die).
HERE=""
project_here() {
  HERE=$(project_of_dir "$(pwd -P)") \
    || die "not in a boxen project folder (~/src/<project>); boxen run and boxen env act on the folder you're in"
}

# ---------------------------------------------------------------- Docker

# require_docker: the rootless daemon answers. Build containers run as root,
# which is only your own user under rootless Docker; under a system daemon
# it would be root on the VM, so boxen refuses one.
require_docker() {
  command -v docker >/dev/null || die "docker isn't installed; run $BOXEN_REPO/install.sh"
  local so
  if ! so=$(docker info -f '{{json .SecurityOptions}}' 2>/dev/null); then
    # The socket is there but can't be reached: most likely a Claude Code
    # sandbox, which blocks it (boxen run/env are excluded only when they
    # are the whole command line).
    # (Inside the sandbox the socket is hidden: denied, it's /dev/null.)
    if [[ -n "${SANDBOX_RUNTIME:-}" || -c "$DOCKER_SOCK" ]]; then
      die "this ran inside Claude Code's sandbox, which blocks Docker: make 'boxen run ...' (or 'boxen env ...') the whole command line, with no 'cd ... &&', pipes, redirects or \$(...) around it"
    fi
    [[ ! -S "$DOCKER_SOCK" ]] || die "can't reach rootless Docker at $DOCKER_HOST (systemctl --user status docker)"
    die "can't reach rootless Docker at $DOCKER_HOST (systemctl --user start docker; or re-run $BOXEN_REPO/install.sh)"
  fi
  [[ "$so" == *rootless* ]] || die "the Docker daemon at $DOCKER_HOST isn't rootless; boxen's build containers need it to be (see install.sh)"
}

require_setup() {
  require_docker
  docker image inspect "$ENV_IMAGE" >/dev/null 2>&1 || die "base image $ENV_IMAGE missing; run $BOXEN_REPO/install.sh"
}

# docker compose for one project: the generated compose.yaml, the sidecars
# rendered from services.yaml, and your compose.override.yaml, in that order.
dc() {
  local n=$1 d files
  shift
  d=$(proj_dir "$n")
  files=(-f "$d/compose.yaml")
  [[ -f "$d/compose.services.yaml" ]] && files+=(-f "$d/compose.services.yaml")
  [[ -f "$d/compose.nonroot.yaml" ]] && files+=(-f "$d/compose.nonroot.yaml")
  [[ -f "$d/compose.override.yaml" ]] && files+=(-f "$d/compose.override.yaml")
  docker compose --project-directory "$d" "${files[@]}" "$@"
}

env_name() { printf 'boxen.%s.env' "$1"; }
running() { [[ "$(docker inspect -f '{{.State.Running}}' "$(env_name "$1")" 2>/dev/null || true)" == true ]]; }

build_base() {
  # --fresh: re-pull Ubuntu and skip the cache so apt picks up new packages.
  local core_extra=() local_extra=()
  if [[ "${1:-}" == --fresh ]]; then
    core_extra=(--pull --no-cache)
    local_extra=(--no-cache)
  fi
  info "building the base image ($ENV_IMAGE)..."
  run_quiet "building $CORE_IMAGE" docker build "${core_extra[@]}" -t "$CORE_IMAGE" "$BOXEN_REPO/image" || return 1
  if [[ -f "$LOCAL_ENV" ]]; then
    info "applying env.local.Dockerfile..."
    # From stdin with no context: nothing in ~/.config/boxen reaches the builder.
    run_quiet "building $ENV_IMAGE from $LOCAL_ENV" \
      docker build "${local_extra[@]}" -t "$ENV_IMAGE" - < "$LOCAL_ENV" || return 1
  else
    run_quiet "tagging $ENV_IMAGE" docker tag "$CORE_IMAGE" "$ENV_IMAGE" || return 1
  fi
}

# ------------------------------------------------------- templates, .boxen/

# Escape a value for use as a sed replacement (| is the delimiter).
sed_esc() { printf '%s' "$1" | sed -e 's/[&|\\]/\\&/g'; }

vm_tz() {
  local tz
  tz=$(timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || true)
  [[ "$tz" =~ ^[A-Za-z0-9_+/-]+$ ]] || tz=UTC
  printf '%s\n' "$tz"
}

# render TEMPLATE NAME: the template with the project's values filled in. A
# placeholder this code doesn't know (a template newer than the running
# script) is never written out.
render() {
  local out left
  out=$(sed -e "s|__NAME__|$(sed_esc "$2")|g" \
            -e "s|__SRC__|$(sed_esc "$(src_dir "$2")")|g" \
            -e "s|__TZ__|$(sed_esc "$(vm_tz)")|g" "$1")
  if left=$(grep -oE '__[A-Z_]+__' <<<"$out" | head -1) && [[ -n "$left" ]]; then
    die "template $1 has unfilled placeholder $left"
  fi
  printf '%s\n' "$out"
}

# write_compose NAME: compose.yaml from the template, and the override
# example. The template each project was rendered from is kept next to it
# (.compose.template), so a compose.yaml edited by hand (it differs from
# both the new render and the render of that template) is recognized and
# kept as compose.yaml.old. Every `boxen setup` runs this for every
# project, with the code that's just been installed.
write_compose() {
  local n=$1 pdir new prev
  pdir=$(proj_dir "$n")
  mkdir -p "$pdir"
  new=$(mktemp -p "$pdir" .compose.XXXXXX)
  # (in a subshell: render dies on a bad template, and the temp file must go)
  ( render "$BOXEN_REPO/templates/compose.yaml" "$n" ) > "$new" || { rm -f "$new"; return 1; }
  if [[ -f "$pdir/compose.yaml" ]] && ! cmp -s "$pdir/compose.yaml" "$new"; then
    prev=$(mktemp)
    if [[ -f "$pdir/.compose.template" ]]; then ( render "$pdir/.compose.template" "$n" ) > "$prev" 2>/dev/null || true; fi
    if ! cmp -s "$pdir/compose.yaml" "$prev"; then
      cp -f "$pdir/compose.yaml" "$pdir/compose.yaml.old"
      echo "$n: compose.yaml had your edits; kept as compose.yaml.old (they belong in compose.override.yaml)"
    fi
    rm -f "$prev"
  fi
  chmod 0644 "$new"
  mv -f "$new" "$pdir/compose.yaml"
  cp -f "$BOXEN_REPO/templates/compose.yaml" "$pdir/.compose.template"
  render "$BOXEN_REPO/templates/compose.override.example.yaml" "$n" > "$pdir/compose.override.example.yaml"
  if [[ -f "$pdir/compose.nonroot.yaml" ]]; then write_nonroot "$n"; fi
}

# ---------------------------------------------------------------- non-root runs
#
# `boxen run --user` runs a command as uid 1000 inside a user namespace of
# its own, in which that uid is the container's root (you on the VM): for
# tools that refuse to run as root, without files owned by an ID the VM
# doesn't know (what a plain second user in a rootless container gets).
# Making that namespace takes one syscall Docker's default seccomp profile
# blocks, so a project gets it only when you turn it on: its build container
# then runs with Docker's profile plus a rule allowing unshare() of a user
# namespace alone (see image/seccomp/README.md).

SECCOMP_USERNS="$BOXEN_HOME/seccomp-userns.json"
CLONE_NEWUSER=$((0x10000000))

write_seccomp() {
  local tmp
  mkdir -p "$BOXEN_HOME"
  tmp=$(mktemp -p "$BOXEN_HOME" .seccomp.XXXXXX)
  if ! jq --argjson mask $(( 0xFFFFFFFF & ~CLONE_NEWUSER )) '.syscalls += [{
        names: ["unshare"], action: "SCMP_ACT_ALLOW",
        args: [{index: 0, value: $mask, valueTwo: 0, op: "SCMP_CMP_MASKED_EQ"}],
        comment: "boxen: a user namespace and nothing else, for boxen run --user",
        excludes: {caps: ["CAP_SYS_ADMIN"]}}]' \
        "$BOXEN_REPO/image/seccomp/docker-default.json" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  chmod 0644 "$tmp"
  mv -f "$tmp" "$SECCOMP_USERNS"
}

# write_nonroot NAME: the compose file that gives the project's build
# container that profile (only the build container; sidecars keep Docker's).
write_nonroot() {
  local n=$1 f
  f="$(proj_dir "$n")/compose.nonroot.yaml"
  write_seccomp || return 1
  cat > "$f.tmp" <<EOF
# Generated by boxen nonroot $n on (boxen nonroot $n off removes it): the
# build container may create a user namespace, for boxen run --user.
services:
  env:
    security_opt:
      - seccomp=$SECCOMP_USERNS
    environment:
      BOXEN_NONROOT: "1"
EOF
  mv -f "$f.tmp" "$f"
}

nonroot_on() { [[ -f "$(proj_dir "$1")/compose.nonroot.yaml" ]]; }

cmd_nonroot() {
  require_project "${1:-}"
  local n=$1 f
  f="$(proj_dir "$n")/compose.nonroot.yaml"
  case ${2:-} in
    "")
      (( $# == 1 )) || die "usage: boxen nonroot <name> [on|off]"
      if nonroot_on "$n"; then echo "$n: non-root runs on (boxen run --user)"
      else echo "$n: non-root runs off (boxen nonroot $n on turns them on)"; fi
      return 0 ;;
    on|off) (( $# == 2 )) || die "usage: boxen nonroot <name> [on|off]" ;;
    *) die "usage: boxen nonroot <name> [on|off]" ;;
  esac
  require_setup
  lock_project "$n"
  local busy
  if running "$n" && busy=$(env_busy "$n"); then
    die "$(printf '%s: not now, turning it %s recreates the build container, which would end what runs in it:\n%s\nTry again when that is done.' \
           "$n" "$2" "$(sed 's/^ */    /' <<<"$busy" | head -n 5)")"
  fi
  if [[ $2 == on ]]; then
    write_nonroot "$n" || die "$n: couldn't write its seccomp profile"
  else
    rm -f "$f"
  fi
  # The build container is recreated with the new settings (what's
  # installed in it at run time is lost, as with boxen env apply).
  if docker inspect "$(env_name "$n")" >/dev/null 2>&1; then
    start_env "$n" || die "$n: non-root runs turned $2, but its build container didn't start again (boxen env show)"
  fi
  if [[ $2 == on ]]; then
    echo "$n: non-root runs on: its agent can use boxen run --user"
  else
    echo "$n: non-root runs off"
  fi
}

# env_path NAME FILE: the path of .boxen/FILE, after checking that neither
# .boxen nor the file is a symlink or anything but a plain file. The agent
# writes .boxen/, so a link there must never make boxen read a file outside
# it. Prints the refusal and returns 1.
env_path() {
  local n=$1 f=$2 d p
  d=$(bdir "$n")
  p="$d/$f"
  if [[ -L "$d" ]] || { [[ -e "$d" && ! -d "$d" ]]; }; then
    printf 'boxen: %s: .boxen is a symlink or not a folder; refusing\n' "$n" >&2
    return 1
  fi
  if [[ -L "$p" ]] || { [[ -e "$p" && ! -f "$p" ]]; }; then
    printf 'boxen: %s: .boxen/%s is a symlink or not a plain file; refusing\n' "$n" "$f" >&2
    return 1
  fi
  printf '%s\n' "$p"
}

# env_read NAME FILE: the contents of .boxen/FILE, read through a descriptor
# that's checked to be that very file (a swap for a link after env_path's
# check is caught). 1: no such file; 2: refused.
env_read() {
  local n=$1 f=$2 p fd real want
  p=$(env_path "$n" "$f") || return 2
  [[ -e "$p" ]] || return 1
  { exec {fd}<"$p"; } 2>/dev/null || return 1
  real=$(readlink "/proc/$BASHPID/fd/$fd" 2>/dev/null || true)
  want="$(realpath -m "$(bdir "$n")")/$f"
  if [[ ! -f "/proc/$BASHPID/fd/$fd" || "$real" != "$want" ]]; then
    exec {fd}<&-
    printf 'boxen: %s: .boxen/%s is a symlink; refusing\n' "$n" "$f" >&2
    return 2
  fi
  cat <&"$fd"
  exec {fd}<&-
}

# env_files NAME: .boxen/ with a Dockerfile and services.yaml, from the
# templates where they're missing (an existing file is never touched).
env_files() {
  local n=$1 f p tmp
  env_path "$n" Dockerfile >/dev/null || return 1
  mkdir -p "$(bdir "$n")"
  for f in Dockerfile services.yaml; do
    p=$(env_path "$n" "$f") || return 1
    [[ ! -e "$p" ]] || continue
    tmp=$(mktemp -p "$(bdir "$n")" ".$f.XXXXXX")
    render "$BOXEN_REPO/templates/$f" "$n" > "$tmp"
    chmod 0644 "$tmp"
    mv -n "$tmp" "$p"
    rm -f "$tmp"
  done
}

# services_declared < content: services.yaml says anything beyond comments
# and bare `services:` / `volumes:` headings.
services_declared() {
  grep -vE '^[[:space:]]*(#|$)' | grep -qvE '^(services|volumes):[[:space:]]*(\{\}[[:space:]]*)?$'
}

# The compose plugin's binary, run on its own (it's a standalone program
# too) in a throwaway container, so parsing services.yaml can't read any
# other file on the VM.
compose_plugin() {
  local p
  p=$(docker info --format '{{range .ClientInfo.Plugins}}{{if eq .Name "compose"}}{{.Path}}{{end}}{{end}}' 2>/dev/null || true)
  for p in "$p" /usr/libexec/docker/cli-plugins/docker-compose "$HOME/.docker/cli-plugins/docker-compose"; do
    if [[ -n "$p" && -x "$p" ]]; then printf '%s\n' "$p"; return 0; fi
  done
  warn "can't find the docker compose plugin binary"
  return 1
}

# render_services NAME: .boxen/services.yaml -> the sidecars' compose file,
# staged as compose.services.yaml.new (empty: no sidecars) until
# commit_services puts it in place, so a later failure (the build) leaves
# the running definition as it was. The file is normalized by `docker
# compose config` in a container with no network that sees only a copy of
# it (`include:` and `extends:` can't pull in other files), then checked by
# boxen-services, which renames volumes to this project's and refuses
# anything that could reach the VM. Problems are printed, rc 2.
render_services() {
  local n=$1 pdir sf json out err rc=0 tmpd plugin
  pdir=$(proj_dir "$n")
  rm -f "$pdir/compose.services.yaml.new"
  tmpd=$(mktemp -d)
  sf="$tmpd/services.yaml"
  env_read "$n" services.yaml > "$sf" || rc=$?
  if (( rc == 2 )); then rm -rf "$tmpd"; return 2; fi
  if (( rc == 1 )) || ! services_declared < "$sf"; then
    rm -rf "$tmpd"
    : > "$pdir/compose.services.yaml.new"
    return 0
  fi
  rc=0
  plugin=$(compose_plugin) || { rm -rf "$tmpd"; return 1; }
  json=$(mktemp); out=$(mktemp); err=$(mktemp)
  if ! docker run --rm --network none -v "$tmpd:/w:ro" -w /w -v "$plugin:/compose:ro" "$ENV_IMAGE" \
         /compose -f services.yaml config --format json --no-interpolate >"$json" 2>"$err"; then
    sed 's/^/services.yaml: /' "$err" >&2
    rc=2
  elif ! "$BOXEN_REPO/bin/boxen-services" "$n" <"$json" >"$out" 2>"$err"; then
    cat "$err" >&2
    rc=2
  fi
  if (( rc )); then
    printf 'boxen: %s: services.yaml rejected; nothing changed\n' "$n" >&2
  elif [[ "$(jq -r '.services | length' "$out")" == 0 ]]; then
    : > "$pdir/compose.services.yaml.new"
  else
    chmod 0644 "$out"
    mv -f "$out" "$pdir/compose.services.yaml.new"
  fi
  rm -rf "$json" "$out" "$err" "$tmpd"
  return "$rc"
}

# commit_services NAME: what render_services staged becomes the sidecars'
# compose file (an empty one: no sidecars).
commit_services() {
  local pdir
  pdir=$(proj_dir "$1")
  [[ -e "$pdir/compose.services.yaml.new" ]] || return 0
  if [[ -s "$pdir/compose.services.yaml.new" ]]; then
    mv -f "$pdir/compose.services.yaml.new" "$pdir/compose.services.yaml"
  else
    rm -f "$pdir/compose.services.yaml.new" "$pdir/compose.services.yaml"
  fi
}

sidecar_names() {
  local f
  f="$(proj_dir "$1")/compose.services.yaml"
  [[ -f "$f" ]] || return 0
  jq -r '.services | keys[]' "$f" 2>/dev/null || true
}

# start_env NAME [--build]: check .boxen/, render the sidecars, (with
# --build) build the image, and bring the build container and sidecars up;
# compose recreates whatever changed. Every problem is printed before
# anything is replaced. Call with the project's lock held.
start_env() {
  local n=$1 f sc
  for f in Dockerfile services.yaml; do env_path "$n" "$f" >/dev/null || return 2; done
  [[ -f "$(bdir "$n")/Dockerfile" ]] || { printf 'boxen: %s: .boxen/Dockerfile is missing\n' "$n" >&2; return 2; }
  render_services "$n" || return $?
  if [[ "${2:-}" == --build ]] || ! docker image inspect "boxen-env-$n:latest" >/dev/null 2>&1; then
    run_quiet "building $n's build container (.boxen/Dockerfile)" dc "$n" build env || return 1
  fi
  commit_services "$n"
  run_quiet "starting $n" dc "$n" up -d --remove-orphans || return 1
  sc=$(sidecar_names "$n" | paste -sd, - | sed 's/,/, /g')
  echo "$n: build container up${sc:+; sidecars: $sc}"
}

# ensure_running NAME: start the build container if it isn't running,
# waiting (up to 10 minutes) for another boxen command that holds the
# project, such as an apply. Output goes to stderr, keeping stdout for the
# command boxen run is about to run.
ensure_running() {
  running "$1" && return 0
  require_setup
  ( LOCK_WAIT=600; lock_project "$1"; running "$1" || { echo "boxen: starting $1's build container..."; start_env "$1"; } ) >&2
}

# ---------------------------------------------------------------- GitHub

# shellcheck source=lib/github.sh
source "$BOXEN_REPO/lib/github.sh"
GITSCAN="$BOXEN_REPO/bin/boxen-gitscan"

# git_ident name|email: the commit identity in boxen's git config.
git_ident() { git config -f "$GITCONFIG" --get "user.$1" 2>/dev/null || true; }

# write_gitconfig [NAME EMAIL]: boxen's git settings for repos under ~/src,
# included from your ~/.gitconfig (includeIf gitdir): GitHub credentials
# come only from boxen (each project's own tokens, never another helper or
# your own login), GitHub SSH URLs are fetched over https (nobody here has
# SSH keys), and commits carry the boxen identity. Without NAME/EMAIL the
# identity already there is kept.
write_gitconfig() {
  local name=${1:-$(git_ident name)} email=${2:-$(git_ident email)} tmp helper inc last
  mkdir -p "$BOXEN_HOME"
  tmp=$(mktemp -p "$BOXEN_HOME" .gitconfig.XXXXXX)
  printf '%s\n' "# Written by boxen (boxen setup, boxen github); rewritten each time." \
                "# Git settings for repos under $SRC_ROOT, included from ~/.gitconfig." > "$tmp"
  printf -v helper '!%q git-credential' "$BOXEN_BIN"
  git config -f "$tmp" credential.https://github.com.helper ""
  git config -f "$tmp" --add credential.https://github.com.helper "$helper"
  git config -f "$tmp" credential.https://github.com.useHttpPath true
  git config -f "$tmp" url.https://github.com/.insteadOf git@github.com:
  git config -f "$tmp" --add url.https://github.com/.insteadOf ssh://git@github.com/
  [[ -z "$name" ]] || git config -f "$tmp" user.name "$name"
  [[ -z "$email" ]] || git config -f "$tmp" user.email "$email"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$GITCONFIG"
  # The include goes last in ~/.gitconfig (moved there again at every
  # setup), so its credential settings come after any of yours.
  inc="includeIf.gitdir:$SRC_ROOT/.path"
  last=$(git config --global --get-regexp '.*' 2>/dev/null | tail -n 1 || true)
  # (git prints section names in lower case)
  if [[ "${last,,}" != "${inc,,} ${GITCONFIG,,}" ]]; then
    git config --global --unset-all "$inc" 2>/dev/null || true
    git config --global --add "$inc" "$GITCONFIG"
    info "$HOME/.gitconfig: repos under $SRC_ROOT use boxen's git settings ($GITCONFIG)"
  fi
}

# git-credential [--project NAME] get: the credential helper for github.com
# in repos under ~/src (see write_gitconfig). The project is the one git
# runs in (or NAME, for `new`'s clone); the token is the one for the
# repo's owner, else the project's default. With no token it answers
# quit=1, so git asks no helper after it (a `credential.helper` you or
# `gh auth setup-git` added to ~/.gitconfig later would otherwise hand the
# agent your own login) and fails with an auth error. Outside a project it
# says nothing. Runs inside the agent's sandbox: it only reads.
cmd_git_credential() {
  local proj="" op line host="" path="" protocol="" owner dir token=""
  if [[ "${1:-}" == --project ]]; then proj=${2:-}; shift 2 || true; fi
  op=${1:-}
  while IFS= read -r line && [[ -n "$line" ]]; do
    case $line in
      host=*) host=${line#host=} ;;
      path=*) path=${line#path=} ;;
      protocol=*) protocol=${line#protocol=} ;;
    esac
  done
  [[ "$op" == get && "$host" == github.com && ( -z "$protocol" || "$protocol" == https ) ]] || return 0
  if [[ -z "$proj" ]]; then proj=$(project_of_dir "$(pwd -P)") || return 0; fi
  [[ "$proj" =~ ^[a-z0-9]+([_-][a-z0-9]+)*$ ]] || { echo quit=1; return 0; }
  dir=$(token_dir "$proj")
  owner=${path%%/*}
  owner=${owner,,}
  if [[ "$owner" =~ ^[a-z0-9]([a-z0-9_.-]{0,37}[a-z0-9_])?$ && -s "$dir/gh-token.$owner" ]]; then
    token=$(head -n 1 "$dir/gh-token.$owner" 2>/dev/null || true)
  fi
  if [[ -z "$token" && -s "$dir/gh-token" ]]; then token=$(head -n 1 "$dir/gh-token" 2>/dev/null || true); fi
  [[ -n "$token" ]] || { echo quit=1; return 0; }
  printf 'username=x-access-token\npassword=%s\n' "$token"
}

# ensure_token_timer: tokens refresh every 30 minutes and at boot, from a
# systemd user timer (boxen-tokens), or cron where there's no systemd user
# session.
ensure_token_timer() {
  local unit_dir="$HOME/.config/systemd/user"
  if systemctl --user show-environment >/dev/null 2>&1; then
    mkdir -p "$unit_dir"
    write_unit "$unit_dir/boxen-tokens.service" <<EOF
# Written by boxen; rewritten on boxen setup.
[Unit]
Description=boxen: refresh each project's GitHub tokens

[Service]
Type=oneshot
Environment="BOXEN_HOME=$BOXEN_HOME" "BOXEN_SRC=$SRC_ROOT"
ExecStart=/bin/sh -c 'exec "\$0" tokens --quiet >>"\$1" 2>&1' "$BOXEN_BIN" "$TOKENS_LOG"
EOF
    write_unit "$unit_dir/boxen-tokens.timer" <<'EOF'
# Written by boxen; rewritten on boxen setup.
[Unit]
Description=boxen: refresh GitHub tokens every 30 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=30min

[Install]
WantedBy=timers.target
EOF
    write_unit "$unit_dir/boxen-rebuild.service" <<EOF
# Written by boxen; rewritten on boxen setup.
[Unit]
Description=boxen: switch build containers to images an update built while they were busy

[Service]
Type=oneshot
Environment="BOXEN_HOME=$BOXEN_HOME" "BOXEN_SRC=$SRC_ROOT"
ExecStart=/bin/sh -c 'exec "\$0" rebuild-pending >>"\$1" 2>&1' "$BOXEN_BIN" "$BOXEN_HOME/rebuild.log"
EOF
    write_unit "$unit_dir/boxen-rebuild.timer" <<'EOF'
# Written by boxen; rewritten on boxen setup.
[Unit]
Description=boxen: check for deferred rebuilds every 2 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=2min

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now boxen-tokens.timer >/dev/null 2>&1 \
      || { warn "couldn't start the boxen-tokens timer (systemctl --user status boxen-tokens.timer)"; return 1; }
    systemctl --user enable --now boxen-rebuild.timer >/dev/null 2>&1 \
      || warn "couldn't start the boxen-rebuild timer (systemctl --user status boxen-rebuild.timer)"
    uninstall_cron
    return 0
  fi
  install_cron
}

# write_unit FILE < content: replace FILE when the content changed.
write_unit() {
  local tmp
  tmp=$(mktemp)
  cat > "$tmp"
  if cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 0; fi
  chmod 0644 "$tmp"
  mv -f "$tmp" "$1"
}

# ---------------------------------------------------------------- Claude

# managed_settings: the Claude Code settings boxen's isolation depends on,
# as JSON. install.sh puts them in /etc/claude-code/managed-settings.d/
# boxen.json (with sudo): managed settings rank above every other file, so
# nothing in your settings, a project's or an old config can loosen them,
# and a project's own settings can't take a command out of the sandbox.
#   - the sandbox: on, required (Claude won't start without it), no
#     unsandboxed retries; `boxen run` and `boxen env` are its only
#     exceptions (they act on the folder they're run in), allowed without a
#     prompt
#   - its network: GitHub only
#   - nothing of the session's runtime folder ($XDG_RUNTIME_DIR: rootless
#     Docker's socket, the systemd and D-Bus sockets) or of the tmux
#     sockets: a command there would run outside the sandbox; nor the
#     system Docker sockets
#   - no reading SSH keys, gh's login or the GitHub App's key, and no
#     GITHUB_TOKEN/GH_TOKEN from your environment, in a sandboxed command
#   - no bypassPermissions mode: the file tools aren't sandboxed, and
#     without prompts they could write anywhere
managed_settings() {
  local deny=("$RUNTIME_DIR" "/tmp/tmux-$USER_UID" /var/run/docker.sock /run/docker.sock)
  jq -n --arg key "$GH_DIR" '{
    sandbox: {
      enabled: true, failIfUnavailable: true, allowUnsandboxedCommands: false,
      excludedCommands: ["boxen run *", "boxen env *"],
      network: {allowedDomains: ["github.com", "api.github.com", "*.githubusercontent.com"]},
      filesystem: {denyRead: $ARGS.positional},
      credentials: {
        files: [{path: "~/.ssh", mode: "deny"}, {path: "~/.config/gh", mode: "deny"}, {path: $key, mode: "deny"}],
        envVars: [{name: "GITHUB_TOKEN", mode: "deny"}, {name: "GH_TOKEN", mode: "deny"},
                  {name: "GH_ENTERPRISE_TOKEN", mode: "deny"}, {name: "GITHUB_ENTERPRISE_TOKEN", mode: "deny"}]
      }
    },
    permissions: {
      allow: ["Bash(boxen run *)", "Bash(boxen env *)"],
      disableBypassPermissionsMode: "disable"
    }
  }' --args "${deny[@]}"
}
MANAGED="/etc/claude-code/managed-settings.d/boxen.json"

# claude_settings: your own ~/.claude/settings.json gets two defaults, each
# only if you haven't set it: Remote Control for every session, and
# transcripts kept a year (cleanupPeriodDays). Everything else is yours.
claude_settings() {
  local s="$CLAUDE_DIR/settings.json" tmp
  mkdir -p "$CLAUDE_DIR"
  [[ -s "$s" ]] || printf '{}\n' > "$s"
  if ! jq -e 'type == "object"' "$s" >/dev/null 2>&1; then
    warn "$s isn't a JSON object; leaving it alone"
    return 1
  fi
  # Both set already: the file is left exactly as it is (layout included).
  jq -e 'has("cleanupPeriodDays") and has("remoteControlAtStartup")' "$s" >/dev/null 2>&1 && return 0
  tmp=$(mktemp -p "$CLAUDE_DIR" .settings.XXXXXX)
  jq '.cleanupPeriodDays //= 365
      | if has("remoteControlAtStartup") then . else .remoteControlAtStartup = true end' "$s" > "$tmp" \
    || { rm -f "$tmp"; warn "couldn't update $s"; return 1; }
  if cmp -s "$tmp" "$s"; then rm -f "$tmp"; return 0; fi
  chmod --reference="$s" "$tmp" 2>/dev/null || chmod 0600 "$tmp"
  mv -f "$tmp" "$s"
}

# claude_config: boxen.md (how agents work here) next to the shared
# CLAUDE.md, imported from it with an @boxen.md line (the rest of CLAUDE.md
# is yours); the /carry skill; the settings above. Only boxen's own copies
# are replaced (first line marked boxen-managed).
claude_config() {
  local d="$CLAUDE_DIR" c
  mkdir -p "$d/skills/carry"
  if [[ ! -f "$d/skills/carry/SKILL.md" ]] || head -5 "$d/skills/carry/SKILL.md" | grep -q boxen-managed; then
    cp -f "$BOXEN_REPO/skills/carry/SKILL.md" "$d/skills/carry/SKILL.md"
  fi
  if [[ ! -f "$d/boxen.md" ]] || head -1 "$d/boxen.md" | grep -q boxen-managed; then
    cp -f "$BOXEN_REPO/templates/boxen.md" "$d/boxen.md"
  else
    warn "$d/boxen.md isn't boxen's (no boxen-managed line); leaving it alone"
  fi
  c="$d/CLAUDE.md"
  if [[ ! -f "$c" ]]; then
    printf '@boxen.md\n' > "$c"
  elif ! grep -qx '@boxen.md' "$c"; then
    { [[ ! -s "$c" || -z "$(tail -c 1 "$c")" ]] || printf '\n'; printf '\n@boxen.md\n'; } >> "$c"
  fi
  claude_settings || true
}

# ---------------------------------------------------------------- setup

# Hidden command: install.sh runs it (and self-update, through install.sh).
cmd_setup() {
  require_docker
  docker compose version >/dev/null 2>&1 || die "the docker compose plugin isn't installed; re-run $BOXEN_REPO/install.sh"
  mkdir -p "$PROJECTS_DIR" "$SRC_ROOT"
  build_base || exit 1
  claude_config
  write_gitconfig
  ensure_token_timer || true
  serve_unit || true
  # Every project's compose.yaml from the template just installed (a
  # project a self-update skipped, busy, catches up here).
  local n
  while read -r n; do
    locked "$n" write_compose "$n" || warn "$n: couldn't update its compose.yaml (busy?); the next setup tries again"
  done < <(projects)
}

# ---------------------------------------------------------------- new

NEW_PDIR="" NEW_SRC="" NEW_CREATED_SRC=0 NEW_NAME=""
new_cleanup() {
  local rc=$?
  [[ -n "$NEW_PDIR" ]] || return 0
  warn "'new $NEW_NAME' didn't finish (exit $rc); cleaning up so you can retry"
  if [[ -f "$NEW_PDIR/compose.yaml" ]]; then dc "$NEW_NAME" down --rmi all -v >/dev/null 2>&1 || true; fi
  rm -rf "$NEW_PDIR"
  if [[ "$NEW_CREATED_SRC" == 1 ]]; then rm -rf "$NEW_SRC"; fi
}

cmd_new() {
  local name=${1:-} url=${2:-} repo="" pdir src
  (( $# >= 1 && $# <= 2 )) || die "usage: boxen new <name> [git-url]"
  valid_name "$name"
  not_reserved "$name"
  require_setup
  if [[ -n "$url" ]]; then
    repo=$(github_repo "$url" || true)
    if [[ -n "$repo" ]]; then
      url="https://github.com/$repo.git"
    elif [[ "$url" != https://* ]]; then
      die "clone over https (git-url '$url'); nobody here has SSH keys"
    fi
  fi
  pdir=$(proj_dir "$name")
  src=$(src_dir "$name")
  [[ ! -f "$pdir/compose.yaml" ]] || die "project '$name' already exists"
  if [[ -n "$url" && -d "$src" && -n "$(ls -A "$src")" ]]; then
    die "$src already has files; can't clone into it (leave out the url to use it as it is)"
  fi
  lock_project "$name"
  NEW_NAME=$name NEW_PDIR=$pdir NEW_SRC=$src NEW_CREATED_SRC=0
  [[ -d "$src" ]] || NEW_CREATED_SRC=1
  trap new_cleanup EXIT
  # Stopped by a signal (Ctrl+C, boxen ui quitting), bash would skip the
  # EXIT trap: exit normally instead, so the cleanup runs.
  trap 'exit 143' TERM HUP
  trap 'exit 130' INT
  mkdir_private "$(token_dir "$name")"
  mkdir -p "$src"

  if [[ -n "$url" ]]; then
    seed_repos "$name" "$repo"
    if [[ -n "$repo" ]] && app_configured; then
      refresh_project "$name" || true
      case $(repo_states "$name" "$repo") in
        ok) ;;
        not-installed)
          info "$repo isn't yours, so there's no token for it; cloning works if it's public. To push, fork it, then 'boxen repos $name add <you>/<repo>'." ;;
        *) die "no GitHub token for $repo, so it can't be cloned (see above)" ;;
      esac
    elif [[ -n "$repo" ]]; then
      warn "GitHub isn't set up ('boxen github'); cloning a private repo will fail"
    fi
    info "cloning $url"
    run_quiet "cloning $url" git -c credential.https://github.com.helper= \
      -c "credential.https://github.com.helper=!$(printf '%q' "$BOXEN_BIN") git-credential --project $name" \
      -c credential.https://github.com.useHttpPath=true clone -- "$url" "$src"
  fi
  seed_repos "$name"
  env_files "$name"
  write_compose "$name"
  info "building $name's build container..."
  start_env "$name" --build
  trap - EXIT TERM HUP INT
  NEW_PDIR=""
  info "done. Start working: boxen claude $name   (or: cd $src && claude)"
  echo "    Its build environment is $src/.boxen/ (the agent may edit it; boxen env apply applies it)."
}

# ---------------------------------------------------------------- run, env

# run [-C DIR] [--] CMD...      the command in the build container, in the
#                               folder you're in (or DIR, inside the project)
# run -d NAME [-C DIR] CMD...   started in the background (boxen-bg)
# run --logs NAME [-f] [--tail N] | --stop NAME | --ps
# Excluded from Claude Code's sandbox (see claude_settings), so it acts only
# on the project of the folder it's run in.
cmd_run() {
  local wd="" mode=exec name="" here target t user=()
  case ${1:-} in -h|--help) usage; return 0 ;; esac
  project_here
  here=$(pwd -P)
  while (( $# )); do
    case $1 in
      -C)      wd=${2:-}; [[ -n "$wd" ]] || die "-C needs a folder"; shift 2 ;;
      -C?*)    wd=${1#-C}; shift ;;
      -d)      mode="bg"; name=${2:-}; [[ -n "$name" ]] || die "usage: boxen run -d NAME cmd..."; shift 2 ;;
      -u|--user) user=(boxen-user); shift ;;
      --logs)  mode="logs"; name=${2:-}; [[ -n "$name" ]] || die "usage: boxen run --logs NAME [-f] [--tail N]"; shift 2; break ;;
      --stop)  mode="stop"; name=${2:-}; [[ -n "$name" ]] || die "usage: boxen run --stop NAME"; shift 2; break ;;
      --ps)    mode="ps"; shift; break ;;
      --)      shift; break ;;
      -*)      die "unknown option '$1' (put -- before a command that starts with -)" ;;
      *)       break ;;
    esac
  done
  target=$here
  if [[ -n "$wd" ]]; then
    [[ "$wd" == /* ]] && target=$(realpath -m "$wd") || target=$(realpath -m "$here/$wd")
    case "$target/" in
      "$(src_dir "$HERE")"/*) ;;
      *) die "-C $wd is outside this project ($(src_dir "$HERE"))" ;;
    esac
    [[ -d "$target" ]] || die "no such folder: $target"
  fi
  if (( ${#user[@]} )); then
    [[ $mode == exec || $mode == bg ]] || die "--user goes with a command (boxen run --user cmd, boxen run -d NAME --user cmd)"
    nonroot_on "$HERE" \
      || die "non-root runs aren't on for $HERE. The user turns them on with: boxen nonroot $HERE on"
  fi
  case $mode in
    exec) (( $# )) || die "usage: boxen run [-C dir] cmd...  (see boxen run --help)" ;;
    bg)   (( $# )) || die "usage: boxen run -d NAME cmd..." ;;
    stop) (( $# == 0 )) || die "usage: boxen run --stop NAME" ;;
    ps)   (( $# == 0 )) || die "usage: boxen run --ps" ;;
  esac
  ensure_running "$HERE"
  t=(-i)
  if [[ -t 0 && -t 1 ]]; then t=(-it); fi
  case $mode in
    exec)
      # In a terminal, Ctrl+C reaches the command through it.
      if [[ -t 0 && -t 1 ]]; then
        exec docker exec -it -w "$target" -e "TERM=${TERM:-dumb}" "$(env_name "$HERE")" \
          bash -lc 'exec "$@"' boxen-run "${user[@]}" "$@"
      fi
      run_supervised "$target" "${user[@]}" "$@" ;;
    bg)
      exec docker exec -i -w "$target" "$(env_name "$HERE")" \
        bash -lc 'exec boxen-bg start "$@"' boxen-run "$name" "${user[@]}" "$@" ;;
    logs) exec docker exec "${t[@]}" "$(env_name "$HERE")" boxen-bg logs "$name" "$@" ;;
    stop) exec docker exec -i "$(env_name "$HERE")" boxen-bg stop "$name" ;;
    ps)   exec docker exec -i "$(env_name "$HERE")" boxen-bg ps ;;
  esac
}

# run_supervised DIR CMD...: boxen run without a terminal (how agents run
# it). docker exec doesn't stop a command whose client goes away, so the
# command runs under boxen-exec with an ID, and if this process is
# interrupted (Claude's Esc or command timeout send it a signal), it ends
# the command's whole process group in the container before exiting.
run_supervised() {
  local target=$1 c id in pid rc=0
  shift
  c=$(env_name "$HERE")
  id=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
  # A background job gets /dev/null as its input unless it's given one.
  exec {in}<&0
  docker exec -i -w "$target" -e "TERM=${TERM:-dumb}" "$c" \
    boxen-exec "$id" bash -lc 'exec "$@"' boxen-run "$@" <&"$in" &
  pid=$!
  exec {in}<&-
  # shellcheck disable=SC2064  # c, id and pid are fixed now, on purpose
  trap "docker exec '$c' boxen-exec --kill '$id' >/dev/null 2>&1 || true; kill '$pid' 2>/dev/null || true; exit 130" INT TERM HUP
  wait "$pid" || rc=$?
  trap - INT TERM HUP
  exit "$rc"
}

cmd_env() {
  project_here
  local n=$HERE
  case ${1:-} in
    apply)
      (( $# == 1 )) || die "usage: boxen env apply"
      require_setup
      LOCK_WAIT=600 lock_project "$n"
      start_env "$n" --build || die "nothing changed: fix the problem above and run boxen env apply again"
      echo "$n: environment applied" ;;
    show)
      (( $# == 1 )) || die "usage: boxen env show"
      show_project "$n" ;;
    logs)
      shift
      env_logs "$n" "$@" ;;
    *) die "usage: boxen env apply | show | logs <sidecar> [-f] [--tail N]" ;;
  esac
}

# show_project NAME: what the project's agent (or you) needs to know.
show_project() {
  local n=$1 pdir line any=0
  pdir=$(proj_dir "$n")
  echo "$n: $(src_dir "$n")"
  echo "Containers:"
  while IFS=$'\t' read -r line; do
    any=1
    printf '    %s\n' "$line"
  done < <(docker ps -a --filter "label=com.docker.compose.project=boxen-$n" \
             --format '{{.Names}}   {{.Image}}   {{.Status}}' 2>/dev/null | sort || true)
  (( any )) || echo "    none (boxen run starts the build container)"
  if [[ -f "$pdir/compose.override.yaml" ]]; then
    echo "Override: $pdir/compose.override.yaml (the user's: ports, mounts, limits)"
  else
    echo "Override: none (the user can add ports, mounts and limits in $pdir/compose.override.yaml)"
  fi
  repos_show "$n"
  if nonroot_on "$n"; then
    echo "Non-root runs: on (boxen run --user cmd runs it as uid 1000; its files are still yours)"
  else
    echo "Non-root runs: off (for a tool that refuses root; the user turns them on with: boxen nonroot $n on)"
  fi
  rebuild_pending_note "$n"
  echo "Build environment: $(bdir "$n")/Dockerfile, $(bdir "$n")/services.yaml"
}

env_logs() {
  local n=$1 svc=${2:-} tail=100 c follow=()
  [[ -n "$svc" ]] || die "usage: boxen env logs <sidecar|env> [-f] [--tail N]"
  shift 2
  while (( $# )); do
    case $1 in
      --tail) tail=${2:-}; [[ -n "$tail" ]] || die "--tail needs a number of lines, 1 to 5000"; shift ;;
      --tail=*) tail=${1#--tail=} ;;
      -f|--follow) follow=(-f) ;;
      *) die "usage: boxen env logs <sidecar|env> [-f] [--tail N]" ;;
    esac
    shift
  done
  [[ "$tail" =~ ^[0-9]+$ ]] && (( tail >= 1 && tail <= 5000 )) || die "--tail needs a number of lines, 1 to 5000"
  if [[ "$svc" != env ]] && ! sidecar_names "$n" | grep -xF "$svc" >/dev/null; then
    die "no sidecar called '$svc' (sidecars: $(sidecar_names "$n" | paste -sd' ' -))"
  fi
  c="boxen.$n.$svc"
  # Control characters stripped, so a log can't drive your terminal.
  docker logs "${follow[@]}" --tail "$tail" "$c" 2>&1 | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177'
}

# ---------------------------------------------------------------- user commands

cmd_up() {
  require_project "${1:-}"
  require_setup
  lock_project "$1"
  start_env "$1" --build || return $?
  rm -f "$(proj_dir "$1")/rebuild" "$(proj_dir "$1")/rebuild.idle"
}

cmd_down() {
  require_project "${1:-}"
  lock_project "$1"
  run_quiet "stopping $1" dc "$1" down || return 1
  echo "$1: stopped"
}

cmd_shell() {
  require_project "${1:-}"
  (( $# == 1 )) || die "usage: boxen shell <name>"
  [[ -t 0 && -t 1 ]] || die "shell needs a terminal"
  ensure_running "$1"
  exec docker exec -it -w "$(src_dir "$1")" -e "TERM=${TERM:-xterm}" "$(env_name "$1")" bash -l
}

cmd_rm() {
  require_project "${1:-}"
  local n=$1 yes=0 ans q
  shift
  while (( $# )); do
    case $1 in
      --yes|-y) yes=1 ;;
      *) die "usage: boxen rm <name> [--yes]" ;;
    esac
    shift
  done
  q="Remove $n's build container, image, sidecars and their data (volumes), and boxen's config for it ($(proj_dir "$n"): your override, its repo list and tokens)? Code in $(src_dir "$n") (with .boxen/) and its Claude history stay."
  if (( ! yes )); then
    [[ -t 0 ]] || die "rm asks first; run it in a terminal, or add --yes"
    read -rp "$q [y/N] " ans
    [[ "$ans" == [yY] ]] || { echo "aborted"; return 0; }
  fi
  lock_project "$n"
  serve_stop "$n" || true
  run_quiet "removing $n" dc "$n" down --rmi all -v --remove-orphans || return 1
  docker volume ls -q --filter "label=boxen.project=$n" 2>/dev/null | xargs -r docker volume rm >/dev/null 2>&1 || true
  docker volume ls -q --filter "name=^boxen\\.$n\\." 2>/dev/null | xargs -r docker volume rm >/dev/null 2>&1 || true
  rm -rf "$(proj_dir "$n")"
  info "removed '$n'. Code in $(src_dir "$n") and its Claude history are kept."
}

# ---------------------------------------------------------------- sessions

in_boxen_tmux() { [[ -n "${TMUX:-}" && "$(basename "${TMUX%%,*}")" == boxen ]]; }

# claude NAME [ARGS]: a Claude session in the project folder, in a window of
# boxen's tmux (so it keeps running when SSH drops, and shows in boxen ui).
# With Remote Control on for every session (claude_settings), it's in the
# Claude app too.
cmd_claude() {
  require_project "${1:-}"
  local n=$1 argv
  shift
  command -v claude >/dev/null || die "Claude Code isn't installed on the VM; re-run $BOXEN_REPO/install.sh"
  [[ -t 0 && -t 1 ]] || die "claude needs a terminal"
  # If Claude exits with an error (say, the sandbox can't start), its last
  # words stay on screen until Enter instead of the window vanishing.
  # shellcheck disable=SC2016  # expanded by that sh, on purpose
  argv=(sh -c 'claude "$@" || { printf "\nclaude exited (%s); press Enter " "$?"; read -r _; }' claude "$@")
  if in_boxen_tmux; then
    "${TMUX_CMD[@]}" new-window -t =boxen: -n "$n" -c "$(src_dir "$n")" "${argv[@]}"
    return
  fi
  if "${TMUX_CMD[@]}" has-session -t =boxen 2>/dev/null; then
    "${TMUX_CMD[@]}" new-window -t =boxen: -n "$n" -c "$(src_dir "$n")" "${argv[@]}"
    exec env -u TMUX "${TMUX_CMD[@]}" attach-session -t =boxen
  fi
  exec env -u TMUX "${TMUX_CMD[@]}" -f "$TMUX_CONF" new-session -s boxen -n "$n" -c "$(src_dir "$n")" "${argv[@]}"
}

# serve: a Remote Control server per project, for starting sessions from the
# app when none is running. Each runs in a tmux window, <name>~serve, in a
# session of their own, "serve", that nobody attaches to: they aren't tabs
# next to your sessions. boxen ui shows one when you open it (linking the
# window into the "boxen" session too) and hides it again (unlinking it),
# so its one-time questions (trust the folder, enable Remote Control) can be
# answered without the tab staying. projects/<name>/serve marks it on; the
# boxen-serve user service starts the marked ones at boot.
SERVE_SESSION=serve
serve_win() { printf '%s~serve' "$1"; }
serve_on() { [[ -f "$(proj_dir "$1")/serve" ]]; }
# (grep reads all of it: with -q it could exit first, and pipefail would
# count tmux's broken pipe as "not there".)
serve_wins() { "${TMUX_CMD[@]}" list-windows -t "=$SERVE_SESSION:" -F '#{window_name}' 2>/dev/null || true; }
serving() { serve_wins | grep -xF "$(serve_win "$1")" >/dev/null; }

serve_start() {
  local n=$1
  serve_adopt
  serving "$n" && return 0
  if "${TMUX_CMD[@]}" has-session -t "=$SERVE_SESSION" 2>/dev/null; then
    "${TMUX_CMD[@]}" new-window -d -t "=$SERVE_SESSION:" -n "$(serve_win "$n")" -c "$(src_dir "$n")" \
      "$BOXEN_BIN" serve-run "$n"
  else
    nolocks "${TMUX_CMD[@]}" -f "$TMUX_CONF" new-session -d -s "$SERVE_SESSION" -n "$(serve_win "$n")" \
      -c "$(src_dir "$n")" "$BOXEN_BIN" serve-run "$n"
  fi
}
# kill-window ends it in every session it's in (shown in boxen's too).
serve_stop() {
  serve_adopt
  serving "$1" || return 0
  "${TMUX_CMD[@]}" kill-window -t "=$SERVE_SESSION:=$(serve_win "$1")" 2>/dev/null || true
}

# serve_adopt: serve windows from before they had a session of their own
# lived in "boxen", as tabs: moved to "serve", still running. (One that's
# in both is a shown one: left alone.)
serve_adopt() {
  local w linked moved=0
  while read -r w linked; do
    [[ "$w" == *~serve && "$linked" == 0 ]] || continue
    if ! "${TMUX_CMD[@]}" has-session -t "=$SERVE_SESSION" 2>/dev/null; then
      # A session needs a window to exist: a placeholder until the first move.
      "${TMUX_CMD[@]}" new-session -d -s "$SERVE_SESSION" -n "boxen-placeholder" sleep 60 2>/dev/null || return 0
      moved=1
    fi
    "${TMUX_CMD[@]}" move-window -d -s "=boxen:=$w" -t "=$SERVE_SESSION:" 2>/dev/null || true
  done < <("${TMUX_CMD[@]}" list-windows -t =boxen: -F '#{window_name} #{window_linked}' 2>/dev/null || true)
  if (( moved )); then
    "${TMUX_CMD[@]}" kill-window -t "=$SERVE_SESSION:=boxen-placeholder" 2>/dev/null || true
  fi
}

cmd_serve() {
  local n
  case ${1:-} in
    "")
      for n in $(projects); do
        if serve_on "$n"; then
          if serving "$n"; then printf '%-24s on\n' "$n"; else printf '%-24s on, not running (boxen serve %s)\n' "$n" "$n"; fi
        fi
      done
      return 0 ;;
    --restore)
      for n in $(projects); do serve_on "$n" && serve_start "$n"; done
      return 0 ;;
  esac
  require_project "$1"
  n=$1
  case ${2:-} in
    "")
      command -v claude >/dev/null || die "Claude Code isn't installed on the VM; re-run $BOXEN_REPO/install.sh"
      : > "$(proj_dir "$n")/serve"
      serve_start "$n"
      info "$n: Remote Control server running (tmux window $(serve_win "$n")); start sessions from the Claude app"
      echo "    The first time, it asks to trust the folder and to enable Remote Control: answer in boxen ui." ;;
    --off)
      rm -f "$(proj_dir "$n")/serve"
      serve_stop "$n"
      echo "$n: serve off" ;;
    *) die "usage: boxen serve [<name> [--off]]" ;;
  esac
}

# Hidden: the serve window's program. The server exits after a long network
# outage; it comes back after 10 seconds.
cmd_serve_run() {
  require_project "${1:-}"
  cd "$(src_dir "$1")"
  while :; do
    env -u DOCKER_HOST claude remote-control --name "$1" --spawn=same-dir || true
    echo "boxen: the Remote Control server for $1 stopped; restarting in 10 s (boxen serve $1 --off to stop it)"
    sleep 10
  done
}

# serve_unit: the user service that starts serve windows at boot. KillMode
# process: stopping it never takes the tmux server (and your sessions) down.
serve_unit() {
  local unit_dir="$HOME/.config/systemd/user"
  systemctl --user show-environment >/dev/null 2>&1 || return 0
  mkdir -p "$unit_dir"
  write_unit "$unit_dir/boxen-serve.service" <<EOF
# Written by boxen; rewritten on boxen setup.
[Unit]
Description=boxen: start the Remote Control servers marked with boxen serve

[Service]
Type=oneshot
RemainAfterExit=yes
KillMode=process
ExecStart=/bin/bash -lc 'exec "\$0" serve --restore' "$BOXEN_BIN"

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable boxen-serve.service >/dev/null 2>&1 || warn "couldn't enable boxen-serve (systemctl --user status boxen-serve)"
}

# ---------------------------------------------------------------- ls

# claude_counts: "project sessions served" lines: Claude Code processes of
# yours by the project their folder is in, split into interactive sessions
# and those under a serve window (a `boxen serve-run` among their
# ancestors: the server and the sessions it starts).
claude_counts() {
  local p cwd n a i served
  local -A c=() s=()
  for p in /proc/[0-9]*; do
    [[ -O "$p" ]] || continue
    # By name, or by what it runs (a native install's binary is named after
    # its version: ~/.local/share/claude/versions/X.Y.Z).
    if [[ "$(cat "$p/comm" 2>/dev/null)" != claude ]]; then
      case $(readlink "$p/exe" 2>/dev/null) in
        */claude|*/claude/versions/*) ;;
        *) continue ;;
      esac
    fi
    cwd=$(readlink "$p/cwd" 2>/dev/null) || continue
    n=$(project_of_dir "$cwd") || continue
    served=0
    a=${p#/proc/}
    for i in 1 2 3 4 5 6 7 8; do
      a=$(awk '/^PPid:/ { print $2 }' "/proc/$a/status" 2>/dev/null) || break
      [[ "$a" =~ ^[0-9]+$ ]] && (( a > 1 )) || break
      if tr '\0' ' ' < "/proc/$a/cmdline" 2>/dev/null | grep -E ' serve-run [a-z0-9_-]+ ?$' >/dev/null; then
        served=1; break
      fi
    done
    if (( served )); then s[$n]=$(( ${s[$n]:-0} + 1 )); else c[$n]=$(( ${c[$n]:-0} + 1 )); fi
  done
  for n in $(printf '%s\n' "${!c[@]}" "${!s[@]}" | sort -u); do
    printf '%s %s %s\n' "$n" "${c[$n]:-0}" "${s[$n]:-0}"
  done
}

# collect: what ls shows, per project, in L_* arrays.
L_NAME=() L_ENV=() L_SESS=() L_SERVED=() L_SERVE=() L_GITHUB=() L_REPO=() L_REPOS=() L_RSTATES=() L_ORIGIN=() L_SIDE=()
DOCKER_OK=1
collect() {
  local i n line out proj cname state status svc dirs=() repos=() states=() wins
  local -A envst=() side=() sess=() served=()
  mapfile -t L_NAME < <(projects)
  if out=$(docker ps -a --filter label=com.docker.compose.project \
             --format '{{.Label "com.docker.compose.project"}}|{{.Names}}|{{.State}}|{{.Status}}' 2>/dev/null); then
    while IFS='|' read -r proj cname state status; do
      [[ "$proj" == boxen-* ]] || continue
      n=${proj#boxen-}
      svc=${cname#"boxen.$n."}
      if [[ "$svc" == env ]]; then envst[$n]="$state|$status"
      else side[$n]+="$svc|$state|$status;"; fi
    done <<<"$out"
  else
    DOCKER_OK=0
  fi
  while read -r n line svc; do sess[$n]=$line; served[$n]=$svc; done < <(claude_counts)
  wins=$(serve_wins)
  for n in "${L_NAME[@]}"; do dirs+=("$(src_dir "$n")"); done
  if (( ${#dirs[@]} )); then mapfile -t L_ORIGIN < <("$GITSCAN" origin "${dirs[@]}" 2>/dev/null || true); fi
  for i in "${!L_NAME[@]}"; do
    n=${L_NAME[i]}
    L_ENV[i]=${envst[$n]:-}
    L_SIDE[i]=${side[$n]:-}
    L_SESS[i]=${sess[$n]:-0}
    L_SERVED[i]=${served[$n]:-0}
    if serve_on "$n"; then
      if grep -qxF "$(serve_win "$n")" <<<"$wins"; then L_SERVE[i]=on; else L_SERVE[i]=stopped; fi
    else
      L_SERVE[i]=off
    fi
    mapfile -t repos < <(listed_repos "$n")
    mapfile -t states < <(repo_states "$n" "${repos[@]}")
    L_REPO[i]=${repos[0]:-}
    L_REPOS[i]=${repos[*]}
    L_RSTATES[i]=${states[*]}
    L_ORIGIN[i]=${L_ORIGIN[i]:-}
    L_GITHUB[i]=$(github_state "$n" "${states[@]}")
  done
}

cmd_ls() {
  local i e v1=()
  collect
  printf '%-24s %-14s %-9s %-8s %s\n' PROJECT CONTAINER SESSIONS SERVE GITHUB
  for i in "${!L_NAME[@]}"; do
    e=${L_ENV[i]%%|*}
    (( DOCKER_OK )) || e="?"
    printf '%-24s %-14s %-9s %-8s %s\n' "${L_NAME[i]}" "${e:-not created}" "${L_SESS[i]}" "${L_SERVE[i]}" "${L_GITHUB[i]}"
  done
  (( DOCKER_OK )) || warn "couldn't reach rootless Docker ($DOCKER_HOST)"
  mapfile -t v1 < <(v1_projects)
  (( ${#v1[@]} == 0 )) || echo "boxen v1 projects, not moved yet (boxen migrate): ${v1[*]}"
}

# ls --json: for boxen ui and scripts. No network.
#   {"version": 3, "docker": bool, "src": "~/src path",
#    "projects": [{"name", "path", "container": {"state", "status"} | null,
#                  "sidecars": [{"service", "container", "state", "status"}],
#                  "sessions": N (interactive Claude sessions), "served": N (Claude
#                  processes under its serve window), "serve": "off"|"on"|"stopped",
#                  "github", "repo": "owner/repo" | null,
#                  "repos": [{"repo", "state", "origin"}]}],
#    "v1": ["name", ...]}
LS_FIELDS=11
cmd_ls_json() {
  local i args=() v1=()
  collect
  for i in "${!L_NAME[@]}"; do
    args+=("${L_NAME[i]}" "${L_ENV[i]}" "${L_SIDE[i]}" "${L_SESS[i]}" "${L_SERVE[i]}"
           "${L_GITHUB[i]}" "${L_REPO[i]}" "${L_REPOS[i]}" "${L_RSTATES[i]}" "${L_ORIGIN[i]}" "${L_SERVED[i]}")
  done
  mapfile -t v1 < <(v1_projects)
  jq -n --argjson docker "$( (( DOCKER_OK )) && echo true || echo false)" --argjson nf "$LS_FIELDS" \
     --arg src "$SRC_ROOT" --arg v1 "${v1[*]}" '
    def words: split(" ") | map(select(. != ""));
    [$ARGS.positional | range(0; length; $nf) as $o | .[$o:$o + $nf]]
    | map(. as $v | {
        name: $v[0],
        path: "\($src)/\($v[0])",
        container: (if $v[1] == "" then null else ($v[1] | split("|") | {state: .[0], status: (.[1] // "")}) end),
        sidecars: ($v[2] | split(";") | map(select(. != "") | split("|")
                   | {service: .[0], container: "boxen.\($v[0]).\(.[0])", state: (.[1] // ""), status: (.[2] // "")})),
        sessions: ($v[3] | tonumber? // 0),
        served: ($v[10] | tonumber? // 0),
        serve: $v[4], github: $v[5],
        repo: (if $v[6] == "" then null else $v[6] end),
        repos: ([$v[7] | words, ($v[8] | words)] | transpose
                | map({repo: .[0], state: (.[1] // "-"),
                       origin: ($v[9] != "" and (.[0] | ascii_downcase) == ($v[9] | ascii_downcase))}))})
    | {version: 3, docker: $docker, src: $src, projects: ., v1: ($v1 | words)}' --args "${args[@]}"
}

# ---------------------------------------------------------------- ui

UI_VENV="${BOXEN_UI_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/boxen/ui-venv}"
UI_DASH=()
ui_prepare() {
  local v vdir
  command -v tmux >/dev/null || die "tmux isn't installed; re-run $BOXEN_REPO/install.sh"
  v=$(tmux -V 2>/dev/null || true)
  if ! [[ "$v" =~ ([0-9]+)\.([0-9]+) ]] \
     || (( BASH_REMATCH[1] < 3 || (BASH_REMATCH[1] == 3 && BASH_REMATCH[2] < 3) )); then
    die "boxen ui needs tmux 3.3 or newer (this is ${v:-an unknown version})"
  fi
  vdir=$(readlink -f "$UI_VENV" 2>/dev/null || true)
  [[ -n "$vdir" && -x "$vdir/bin/python" ]] \
    || die "the ui's Python environment is missing ($UI_VENV); re-run $BOXEN_REPO/install.sh"
  # shellcheck disable=SC2016  # expanded by that sh, on purpose
  UI_DASH=(env -u DOCKER_HOST "PYTHONPATH=$BOXEN_REPO/ui" sh -c \
           '"$0" -P -m boxen_ui || { printf "\nboxen ui exited (%s); press Enter " "$?"; read -r _; }' \
           "$vdir/bin/python")
}

cmd_ui() {
  local t=("${TMUX_CMD[@]}") restart=0
  case ${1:-} in
    "") ;;
    --restart) restart=1 ;;
    *) die "usage: boxen ui [--restart]" ;;
  esac
  (( restart )) || [[ -t 0 && -t 1 ]] || die "ui needs a terminal (run it in an SSH session on the VM)"
  ui_prepare
  if (( restart )); then
    "${t[@]}" has-session -t =boxen 2>/dev/null || die "boxen ui isn't running; start it with 'boxen ui'"
    serve_adopt
    "${t[@]}" respawn-window -k -c "$HOME" -t =boxen:=dashboard "${UI_DASH[@]}" 2>/dev/null \
      || "${t[@]}" new-window -d -c "$HOME" -t =boxen: -n dashboard "${UI_DASH[@]}"
    info "dashboard restarted"
    return
  fi
  if in_boxen_tmux; then
    "${t[@]}" select-window -t =boxen:=dashboard 2>/dev/null \
      || "${t[@]}" new-window -c "$HOME" -t =boxen: -n dashboard "${UI_DASH[@]}"
    return
  fi
  if "${t[@]}" has-session -t =boxen 2>/dev/null; then
    "${t[@]}" source-file "$TMUX_CONF" 2>/dev/null || true
    serve_adopt
    "${t[@]}" list-windows -t =boxen: -F '#{window_name}' 2>/dev/null | grep -x dashboard >/dev/null \
      || "${t[@]}" new-window -d -c "$HOME" -t =boxen: -n dashboard "${UI_DASH[@]}"
    exec env -u TMUX "${t[@]}" attach-session -t =boxen \; select-window -t =boxen:=dashboard
  fi
  exec env -u TMUX "${t[@]}" -f "$TMUX_CONF" new-session -c "$HOME" -s boxen -n dashboard "${UI_DASH[@]}"
}

# ---------------------------------------------------------------- upkeep

# env_busy NAME: what's running in the project's build container besides
# its own init and sleep (a build, a server, a shell), one "PID COMMAND"
# per line; nothing (and status 1) when it's idle or not running.
env_busy() {
  local out
  out=$(docker exec "$(env_name "$1")" ps -e -o pid=,args= 2>/dev/null) || return 1
  out=$(awk '$1 != 1 && $2 != "ps" && !($2 == "sleep" && $3 == "infinity")' <<<"$out")
  [[ -n "$out" ]] || return 1
  printf '%s\n' "$out"
}

# Rebuilding recreates the container, which ends whatever runs in it. A
# project with something running gets its new image built now and is
# marked (projects/<name>/rebuild); the boxen-rebuild timer swaps the
# container over once nothing has run in it for two checks in a row
# (rebuild_pending). UPDATE_SKIPPED_RC tells the caller it's deferred.
UPDATE_SKIPPED_RC=76
REBUILD_IDLE_SECS=90
update_one() {
  local n=$1 busy
  if running "$n" && busy=$(env_busy "$n"); then
    run_quiet "building $n's build container (.boxen/Dockerfile)" dc "$n" build env || return 1
    date +%s > "$(proj_dir "$n")/rebuild"
    rm -f "$(proj_dir "$n")/rebuild.idle"
    printf 'boxen: %s: new image built; the container switches to it once nothing runs in it (now running:\n%s\n  )\n' \
      "$n" "$(sed 's/^ */    /' <<<"$busy" | head -n 5)" >&2
    return "$UPDATE_SKIPPED_RC"
  fi
  start_env "$n" --build || return $?
  rm -f "$(proj_dir "$n")/rebuild" "$(proj_dir "$n")/rebuild.idle"
}

# Hidden command, from the boxen-rebuild timer (every 2 minutes): for each
# project marked by update_one, recreate its build container on the image
# already built, once it has been idle at two checks REBUILD_IDLE_SECS
# apart (an agent between two commands isn't idle for that long, usually;
# a boxen run that starts meanwhile waits for the project's lock).
cmd_rebuild_pending() {
  local n pdir now since
  for n in $(projects); do
    pdir=$(proj_dir "$n")
    [[ -f "$pdir/rebuild" ]] || continue
    ( LOCK_BUSY_RC=0
      lock_project "$n"
      [[ -f "$pdir/rebuild" ]] || exit 0
      if ! docker inspect "$(env_name "$n")" >/dev/null 2>&1; then
        rm -f "$pdir/rebuild" "$pdir/rebuild.idle"; exit 0          # removed or down: nothing to swap
      fi
      if ! running "$n"; then
        rm -f "$pdir/rebuild" "$pdir/rebuild.idle"; exit 0          # stopped: the next start uses the new image
      fi
      if env_busy "$n" >/dev/null; then rm -f "$pdir/rebuild.idle"; exit 0; fi
      now=$(date +%s)
      if [[ ! -f "$pdir/rebuild.idle" ]]; then echo "$now" > "$pdir/rebuild.idle"; exit 0; fi
      since=$(head -n 1 "$pdir/rebuild.idle" 2>/dev/null || echo "$now")
      [[ "$since" =~ ^[0-9]+$ ]] || since=$now
      (( now - since >= REBUILD_IDLE_SECS )) || exit 0
      if start_env "$n"; then
        rm -f "$pdir/rebuild" "$pdir/rebuild.idle"
        printf '%s %s: switched to its new build image\n' "$(date -Is)" "$n"
      else
        printf '%s %s: switching to its new build image failed; boxen up %s shows why\n' "$(date -Is)" "$n" "$n"
      fi
    ) || true
  done
}

rebuild_pending_note() {
  [[ -f "$(proj_dir "$1")/rebuild" ]] || return 0
  echo "Rebuild pending: boxen built a new image for it; the build container switches over on its own once nothing has run in it for a couple of minutes (or now: boxen up $1)"
}

cmd_update() {
  local n r failed=() busy=() list=() skipped=()
  (( $# == 0 )) || die "usage: boxen update   (one project: boxen up <name>)"
  require_setup
  lock_global
  build_base --fresh || exit 1
  mapfile -t list < <(projects)
  for n in "${list[@]}"; do
    r=0
    if docker inspect "$(env_name "$n")" >/dev/null 2>&1; then
      locked "$n" update_one "$n" || r=$?
    else
      # Never started: just drop the old image; the next start builds it.
      docker image rm "boxen-env-$n:latest" >/dev/null 2>&1 || true
    fi
    if (( r == BUSY_RC )); then busy+=("$n")
    elif (( r == UPDATE_SKIPPED_RC )); then skipped+=("$n")
    elif (( r )); then failed+=("$n"); fi
  done
  docker image prune -f >/dev/null 2>&1 || true
  docker builder prune -f --filter until=720h >/dev/null 2>&1 || true
  (( ${#busy[@]} == 0 )) || warn "update: skipped, busy: ${busy[*]}"
  (( ${#skipped[@]} == 0 )) || warn "update: work is running in ${skipped[*]}: they switch to their new images on their own once it's done"
  (( ${#failed[@]} == 0 )) || die "update finished, but these projects failed: ${failed[*]}"
  info "update done"
}

cmd_self_update() {
  local old new changed n r list=() failed=() skipped=() rebuild=0
  lock_global
  old=$(git -C "$BOXEN_REPO" rev-parse HEAD)
  run_quiet "git pull" nolocks git -c gc.autoDetach=false -C "$BOXEN_REPO" pull --ff-only \
    || die "couldn't fast-forward $BOXEN_REPO. If you edited files there, move those changes to ~/.config/boxen and retry."
  new=$(git -C "$BOXEN_REPO" rev-parse HEAD)
  if [[ "$old" == "$new" ]]; then info "boxen is already up to date"; return 0; fi
  info "updated boxen:"
  git -C "$BOXEN_REPO" log --oneline --no-decorate "$old..$new" | sed 's/^/    /'
  changed=$(git -C "$BOXEN_REPO" diff --name-only "$old" "$new")
  info "running the updated installer"
  BOXEN_SELF_UPDATE=1 nolocks "$BOXEN_REPO/install.sh"
  # The installer's setup rewrote every project's compose.yaml; a changed
  # base image or template means rebuilding the running ones.
  mapfile -t list < <(projects)
  grep -qE '^(image/|templates/compose\.yaml$)' <<<"$changed" && rebuild=1
  for n in "${list[@]}"; do
    r=0
    if (( rebuild )) && docker inspect "$(env_name "$n")" >/dev/null 2>&1; then
      locked "$n" update_one "$n" || r=$?
    fi
    if (( r == UPDATE_SKIPPED_RC )); then skipped+=("$n"); elif (( r )); then failed+=("$n"); fi
  done
  (( ${#skipped[@]} == 0 )) \
    || warn "self-update: work is running in ${skipped[*]}: they switch to their new images on their own once it's done"
  (( ${#failed[@]} == 0 )) || die "self-update finished, but these projects failed (or were busy): ${failed[*]}"
  info "self-update done"
}

cmd_doctor() {
  # shellcheck source=lib/doctor.sh
  source "$BOXEN_REPO/lib/doctor.sh"
  doctor_main "$@"
}

cmd_migrate() {
  # shellcheck source=lib/migrate.sh
  source "$BOXEN_REPO/lib/migrate.sh"
  migrate_main "$@"
}

# ------------------------------------------------------------------- main

cmd=${1:-help}
shift || true
case "$cmd" in
  new)      cmd_new "$@" ;;
  ls|list)
    case ${1:-} in
      "")     cmd_ls ;;
      --json) (( $# == 1 )) || die "usage: boxen ls [--json]"; cmd_ls_json ;;
      *)      die "usage: boxen ls [--json]" ;;
    esac ;;
  claude)   cmd_claude "$@" ;;
  serve)    cmd_serve "$@" ;;
  serve-run) cmd_serve_run "$@" ;;
  ui)       cmd_ui "$@" ;;
  shell)    cmd_shell "$@" ;;
  up)       each cmd_up "$@" ;;
  down)     each cmd_down "$@" ;;
  rm)       cmd_rm "$@" ;;
  repos)    cmd_repos "$@" ;;
  nonroot)  cmd_nonroot "$@" ;;
  run)      cmd_run "$@" ;;
  env)      cmd_env "$@" ;;
  github)   cmd_github "$@" ;;
  doctor)   cmd_doctor "$@" ;;
  df)
    # shellcheck source=lib/df.sh
    source "$BOXEN_REPO/lib/df.sh"
    cmd_df "$@" ;;
  migrate)  cmd_migrate "$@" ;;
  update)   cmd_update "$@" ;;
  self-update) cmd_self_update ;;
  setup)    cmd_setup "$@" ;;
  managed-settings) managed_settings ;;
  tokens)   cmd_tokens "$@" ;;
  rebuild-pending) cmd_rebuild_pending ;;
  git-credential) cmd_git_credential "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
