#!/bin/bash
# boxen-carry: for the /carry skill, on the boxen VM.
#
#   boxen-carry list                          earlier sessions in this folder (state: live, partial, carried, -)
#   boxen-carry info <id-or-prefix>           one session's id, title, date, turns, chars, parts
#   boxen-carry read <id-or-prefix> [--part K]   one session as plain text (part K of M)
#   boxen-carry memdir                        this project's auto-memory dir
#
# /carry reads old conversations with these and writes what they learned into
# the project's auto memory, so later sessions start informed. The transcripts
# themselves are never changed (boxen resume still replays them).

set -u

CFG=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
# Claude Code files a folder's sessions under
# projects/<path with every non-alphanumeric character as ->, as in boxen-sessions.
keyof() { printf '%s/projects/%s' "$CFG" "$(printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g')"; }
KEYDIR=$(keyof "$PWD")
# Auto memory is keyed by the git repo's main root (worktrees and subfolders
# share it), so the handoffs go there; a folder that isn't a repo is its own.
mem_root() {
  local common
  if common=$(git rev-parse --git-common-dir 2>/dev/null) && [[ -n $common ]]; then
    [[ $common == /* ]] || common="$PWD/$common"
    dirname "$(realpath -m "$common")"
  else
    printf '%s\n' "$PWD"
  fi
}
MEMDIR="$(keyof "$(mem_root)")/memory"
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

tfile() { printf '%s/%s.jsonl' "$KEYDIR" "$1"; }

# Session IDs in this folder, newest first.
sessions() {
  local f id
  find "$KEYDIR" -maxdepth 1 -type f -name '*.jsonl' -printf '%T@ %f\n' 2>/dev/null \
    | sort -rn | while read -r _ f; do
        id=${f%.jsonl}
        [[ $id =~ $UUID_RE ]] && printf '%s\n' "$id"
      done
}

# The text you typed in a user record: its text blocks, each trimmed, minus
# system markup (a record holds e.g. a <system-reminder> block and then your
# message, so blocks are filtered one by one before joining). Slash commands
# are stored as markup; those become the command name. Tool results, meta
# records and compaction summaries aren't your messages.
# Same as boxen-sessions preview(): keep the two in sync.
JQ_DEFS='
  def blocks: .message.content
    | if type == "string" then [.] elif type == "array"
      then map(select(.type == "text") | .text) else [] end;
  def user_text: blocks
    | map(gsub("^\\s+|\\s+$"; "")
          | if test("<command-name>") then (capture("<command-name>(?<c>[^<]*)</command-name>").c // "")
            elif startswith("<") then "" else . end)
    | map(select(length > 0)) | join("\n");
  def typed: select(.type == "user" and .isMeta != true and .isCompactSummary != true);'
USER_TEXT="$JQ_DEFS typed | user_text | select(length > 0)"

# preview ID: the first thing you typed, for the list (best effort).
preview() {
  jq -r "$JQ_DEFS first(typed | user_text | select(length > 0)) | gsub(\"\\n\"; \" \")" \
     "$(tfile "$1")" 2>/dev/null \
    | head -1 | tr '\t' ' ' | cut -c1-60 | sed 's/[[:space:]]*$//'
}

# title ID: the session's name: the one you gave it (/rename, or renaming it
# in the Claude app), else the one Claude generated, else the first message.
# Same as boxen-sessions title(): keep the two in sync.
title() {
  local t
  t=$(grep -aE '"type":"(custom-title|ai-title)"' "$(tfile "$1")" 2>/dev/null \
        | jq -rs '(map(select(.type == "custom-title") | .customTitle) | last)
                  // (map(select(.type == "ai-title") | .aiTitle) | last) // empty' 2>/dev/null \
        | tr '\t\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $t ]] || t=$(preview "$1")
  printf '%s' "${t:0:60}"
}

# turns ID: how many messages you typed (one marker per message, since a
# message can span lines).
turns() { jq -r "$USER_TEXT | \"x\"" "$(tfile "$1")" 2>/dev/null | grep -c . || true; }

# sdate ID: the day the session started (its first timestamp, else the file's).
sdate() {
  local d
  d=$(jq -r 'select(.timestamp) | .timestamp' "$(tfile "$1")" 2>/dev/null | head -1 | cut -c1-10)
  [[ $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || d=$(date -r "$(tfile "$1")" +%F 2>/dev/null || echo "-")
  printf '%s' "$d"
}

# IDs of conversations a Claude process has open right now. Each running
# Claude writes sessions/<pid>.json with its conversation ID, PID, process
# start time and PID namespace; only entries from this PID namespace whose
# process is still the same one (start time matches) count.
running_ids() {
  local ns f id pid start dom
  ns=$(readlink /proc/self/ns/pid 2>/dev/null) || return 0
  for f in "$CFG"/sessions/*.json; do
    [[ -f $f ]] || continue
    IFS=$'\t' read -r id pid start dom < <(jq -r '[.sessionId, .pid, .procStart, .pidDomain] | map(. // "" | tostring) | @tsv' "$f" 2>/dev/null) || continue
    [[ -n $id && $pid =~ ^[0-9]+$ && $dom == *":$ns" ]] || continue
    [[ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)" == "$start" ]] && printf '%s\n' "$id"
  done
}

# state ID: live (a running Claude has it open: never carry it), partial
# (a carry of it was interrupted; its notes file is there), carried, or -.
state() {
  local f
  grep -qxF "$1" <<<"$LIVE" && { echo live; return; }
  # A notes file whose first line is "done" is a finished carry's (the
  # sandbox can't delete files there, so the skill marks it instead).
  if [[ -f "$MEMDIR/carried/.${1:0:8}.notes.md" ]] \
     && [[ "$(head -n 1 "$MEMDIR/carried/.${1:0:8}.notes.md" 2>/dev/null)" != done ]]; then
    echo partial; return
  fi
  for f in "$MEMDIR/carried/${1:0:8}"-*.md; do [[ -e $f ]] && { echo carried; return; }; done
  echo "-"
}

# N  id8  date  turns  parts  live|partial|carried|-  title
cmd_list() {
  local id p i=0
  LIVE=$(running_ids)
  for id in $(sessions); do
    p=$(title "$id")
    [[ -n $p ]] || continue            # empty, never-used session
    i=$((i + 1))
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$i" "${id:0:8}" "$(sdate "$id")" "$(turns "$id")" \
      "$(render_convo "$id" | MODE=count parts_perl)" "$(state "$id")" "$p"
  done
}

# find_id PREFIX: the full session ID.
find_id() {
  local id hits=()
  for id in $(sessions); do
    [[ $id == "$1"* ]] && hits+=("$id")
  done
  case ${#hits[@]} in
    0) echo "no session '$1' here" >&2; return 1 ;;
    1) printf '%s' "${hits[0]}" ;;
    *) echo "ambiguous: matches ${#hits[@]} sessions" >&2; return 1 ;;
  esac
}

# The conversation as text: "## You" / "## Claude" turns, Claude's text
# blocks, and a line naming the tools it used, with the inputs a handoff
# needs: the command for Bash (first 120 chars), the path for Edit, Write,
# Read and NotebookEdit; one entry per use in order, exact repeats within a
# turn dropped, the line capped at 400 chars. Tool results are left out; a
# compaction summary (Claude's own recap of an earlier, trimmed part) is
# kept under its own heading.
CONVO="$JQ_DEFS"'
  def tool_entry:
    if .name == "Bash" then "Bash: " + ((.input.command // "" | tostring) | gsub("[\\r\\n]+"; " ") | .[0:120])
    elif (.name == "Edit" or .name == "Write" or .name == "Read" or .name == "NotebookEdit")
      then .name + ": " + (.input.file_path // "" | tostring)
    else .name end;
  def dedup: reduce .[] as $e ([]; if index([$e]) then . else . + [$e] end);
  def tools_line: "[tools: " + join("; ") + "]" | if length > 400 then .[0:399] + "\u2026" else . end;
  if .type == "user" and .isMeta == true then empty
  elif .type == "user" and .isCompactSummary == true then
    (blocks | join("\n") | gsub("^\\s+|\\s+$"; "")) as $t
    | if $t == "" then empty else "## Earlier context (compaction summary)\n\($t)\n" end
  elif .type == "user" then
    user_text as $t
    | if $t == "" then empty else "## You\n\($t)\n" end
  elif .type == "assistant" then
    (.message.content
     | if type == "string" then {text: ., tools: []}
       elif type == "array" then
         {text: (map(select(.type == "text") | .text) | join("\n")),
          tools: (map(select(.type == "tool_use") | tool_entry) | dedup)}
       else {text: "", tools: []} end) as $m
    | if $m.text == "" and ($m.tools | length) == 0 then empty
      else "## Claude\n"
           + (if $m.text != "" then $m.text + "\n" else "" end)
           + (if ($m.tools | length) > 0 then ($m.tools | tools_line) + "\n" else "" end)
      end
  else empty end'

render_convo() { jq -r "$CONVO" "$(tfile "$1")" 2>/dev/null; }

# parts_perl: the rendered conversation (stdin) in parts of at most PART_CHARS
# characters, cut only between messages (before a "## ..." heading); a single
# message longer than that is a part of its own, whole. Nothing is ever left
# out. MODE=count prints the number of parts, MODE=chars the length, MODE=part
# prints part K with its header and continuation lines (K out of range: error).
export PART_CHARS=60000
parts_perl() {
  perl -CSD -e '
    use strict; use warnings;
    local $/; my $t = <STDIN>; $t = "" unless defined $t;
    my $limit = $ENV{PART_CHARS};
    my (@parts, $cur); $cur = "";
    for my $m (split /(?=^## (?:You|Claude|Earlier context)\b)/m, $t) {
      next if $m eq "";
      if ($cur ne "" && length($cur) + length($m) > $limit) { push @parts, $cur; $cur = $m }
      else { $cur .= $m }
    }
    push @parts, $cur if $cur ne "";
    @parts = ("") unless @parts;
    my $M = scalar @parts;
    my $mode = $ENV{MODE} // "count";
    if ($mode eq "count") { print "$M\n"; exit }
    if ($mode eq "chars") { print length($t), "\n"; exit }
    my $k = $ENV{K} // 1;
    if ($k !~ /^\d+$/ || $k < 1 || $k > $M) { print STDERR "no part $k: this session has $M part(s)\n"; exit 1 }
    my $id8 = substr($ENV{ID}, 0, 8);
    print "# Session $ENV{ID} \x{2014} $ENV{TITLE} \x{2014} $ENV{DATE} \x{2014} $ENV{TURNS} turns \x{2014} part $k of $M\n\n";
    print "(continues from part ", $k - 1, ")\n\n" if $k > 1;
    print $parts[$k - 1];
    print "(continued in part ", $k + 1, " \x{2014} run: boxen-carry read $id8 --part ", $k + 1, ")\n" if $k < $M;'
}

cmd_info() {
  local id
  [[ -n ${1:-} ]] || { echo "which session? (boxen-carry list)" >&2; return 1; }
  id=$(find_id "$1") || return 1
  printf 'id: %s\ntitle: %s\ndate: %s\nturns: %s\n' "$id" "$(title "$id")" "$(sdate "$id")" "$(turns "$id")"
  printf 'chars: %s\n' "$(render_convo "$id" | MODE=chars parts_perl)"
  printf 'parts: %s\n' "$(render_convo "$id" | MODE=count parts_perl)"
}

cmd_read() {
  local pick="" part=1 id
  while (( $# )); do
    case $1 in
      --part) part=${2:-}; shift ;;
      --part=*) part=${1#--part=} ;;
      -*) echo "unknown option: $1" >&2; return 1 ;;
      *) pick=$1 ;;
    esac
    shift
  done
  [[ -n $pick ]] || { echo "which session? (boxen-carry list)" >&2; return 1; }
  [[ $part =~ ^[0-9]+$ ]] || { echo "--part needs a number" >&2; return 1; }
  id=$(find_id "$pick") || return 1
  render_convo "$id" \
    | MODE=part K=$part ID=$id TITLE=$(title "$id") DATE=$(sdate "$id") TURNS=$(turns "$id") parts_perl
}

cmd_memdir() { printf '%s\n' "$MEMDIR"; }

case ${1:-} in
  list)   cmd_list ;;
  info)   shift; cmd_info "$@" ;;
  read)   shift; cmd_read "$@" ;;
  memdir) cmd_memdir ;;
  *)      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
