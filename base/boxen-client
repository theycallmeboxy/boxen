#!/usr/bin/env python3
"""boxen-client: the `boxen` command inside a boxen container.

Sends the arguments to boxen-agentd on the VM over a unix socket
($BOXEN_AGENT_SOCK, else /run/boxen/agent.sock: the supervisor's; a project
has its own, scoped to itself) as one JSON request per connection, prints
the lines it streams back, then exits with the command's exit code. The
agent decides what may run; this end does nothing but relay.
"""
import json
import os
import socket
import sys

SOCK = os.environ.get("BOXEN_AGENT_SOCK") or "/run/boxen/agent.sock"
SUPERVISOR = os.environ.get("BOXEN_SUPERVISOR") == "1"
USAGE = """Usage: boxen <command> [args]   (the restricted boxen inside a container)

From the supervisor project (%s):

  ls                                        List projects, servers, GitHub tokens
  show <name>                               A project's environment: sidecars, Dockerfile, services.yaml
  up <name|all> [--approve trust]           Start, or apply env/compose changes
  restart <name|all> [--approve trust]      Recreate the container (applies its services.yaml)
  down <name|all>                           Stop
  logs <name> [--tail N]                    The server's output (default: last 100 lines)
  update [name|all]                         Rebuild images (slow; applies a project's Dockerfile)
  self-update                               Update boxen itself and apply it
  new <name> [https-github-url] [--approve trust]
                                            Create a project and start it
  resume <name> [N|id] [--stop] [--force]   Continue an earlier session in the Claude app
  rm <name> [--yes]                         Remove a project (keeps its code)
  tokens [name|all]                         Refresh GitHub tokens

From a project's own container (%s), for this project only:

  ls                                        List projects (read only)
  show                                      This project's sidecars, Dockerfile, services.yaml
  logs [--tail N]                           This project's server output
  restart                                   Apply /boxen/services.yaml: recreate this container
  update                                    Apply /boxen/Dockerfile: rebuild the image, recreate this container

%s
""" % ((("this container", "not this one",
         'When boxen prints "approval needed", ask the user before running the\n'
         'command it names. Anything not listed here needs a terminal on the VM.')
        if SUPERVISOR else
        ("not this one", "this container",
         "restart and update from a project validate first (update builds the\n"
         "image too) and print any errors here, with nothing restarted. Only when\n"
         "that passes is this container recreated, detached: the session reconnects\n"
         "in about 30 seconds. Anything not listed here doesn't work from here.")))


def fail(msg, code=1):
    sys.stderr.write("boxen: %s\n" % msg)
    sys.exit(code)


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        sys.stdout.write(USAGE)
        return 0 if argv else 2
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(SOCK)
    except OSError as e:
        fail("can't reach the boxen agent at %s (%s); is boxen-agent running on the VM?" % (SOCK, e.strerror or e))
    s.sendall((json.dumps({"argv": argv}) + "\n").encode())
    s.shutdown(socket.SHUT_WR)
    f = s.makefile("rb")
    try:
        for raw in f:
            try:
                msg = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                continue
            if "out" in msg:
                sys.stdout.write(msg["out"] + "\n")
                sys.stdout.flush()
            if "error" in msg:
                sys.stderr.write("boxen: %s\n" % msg["error"])
                sys.stderr.flush()
            if "exit" in msg:
                return int(msg["exit"])
    except OSError:
        pass
    fail("the boxen agent closed the connection before the command finished (it may be restarting after an update)")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
