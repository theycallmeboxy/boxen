#!/bin/sh
# git credential helper for github.com inside boxen containers.
# Answers with a short-lived token boxen mints on the VM, one per owner in
# this project's repo list (the user's, kept on the VM), refreshed in
# /run/boxen: the token for the owner of the repo git asks about (git sends
# the repo's path: boxen-entry sets credential.useHttpPath), else the
# project's default token, else $GH_TOKEN, else nothing. A repo outside the
# list gets no token that covers it, so git fails with GitHub's own auth
# error (see /boxen/STATUS.md). Prints nothing but the username and
# password lines.
dir=${BOXEN_TOKEN_DIR:-/run/boxen}
host="" path=""
while IFS= read -r line; do
  case $line in
    host=*) host=${line#host=} ;;
    path=*) path=${line#path=} ;;
    "") break ;;
  esac
done
[ "$1" = get ] || exit 0
[ -z "$host" ] || [ "$host" = github.com ] || exit 0
owner=$(printf '%s' "${path%%/*}" | tr 'A-Z' 'a-z')
token=""
if [ -n "$owner" ] && printf '%s\n' "$owner" | grep -Eqx '[a-z0-9]([a-z0-9_.-]{0,37}[a-z0-9_])?' \
   && [ -s "$dir/gh-token.$owner" ]; then
  token=$(head -n 1 "$dir/gh-token.$owner" 2>/dev/null)
fi
[ -n "$token" ] || ! [ -s "$dir/gh-token" ] || token=$(head -n 1 "$dir/gh-token" 2>/dev/null)
[ -n "$token" ] || token=${GH_TOKEN:-}
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
