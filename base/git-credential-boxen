#!/bin/sh
# git credential helper for github.com inside boxen containers.
# Answers with this project's short-lived token, which boxen mints on the VM
# and refreshes in /run/boxen/gh-token. Falls back to $GH_TOKEN if set.
cat >/dev/null    # git sends the request on stdin; the answer is the same either way
[ "$1" = get ] || exit 0
token=""
[ -s /run/boxen/gh-token ] && token=$(cat /run/boxen/gh-token)
[ -n "$token" ] || token=${GH_TOKEN:-}
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
