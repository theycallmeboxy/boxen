#!/bin/bash
# boxen-sessions: runs inside a boxen container (via `boxen resume`).
#
#   boxen-sessions resume [N|ID] [--attach] [--force] [--stop]
#
# Lists this project's earlier Claude sessions and continues the one you pick
# in a tmux session with Remote Control on, so it shows up in the Claude app
# with its history. It runs until you stop it or the container restarts (the
# transcript stays, so you can resume it again).

set -u

CFG=${CLAUDE_CONFIG_DIR:?CLAUDE_CONFIG_DIR not set}
NAME=${BOXEN_PROJECT:-$(hostname)}
KEYDIR="$CFG/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

now()   { date +%s; }
tfile() { printf '%s/%s.jsonl' "$KEYDIR" "$1"; }
mtime() { stat -c %Y "$(tfile "$1")" 2>/dev/null || echo 0; }
tname() { printf 's-%s' "${1:0:8}"; }
alive() { tmux has-session -t "$(tname "$1")" 2>/dev/null \
            && [[ "$(tmux display -p -t "$(tname "$1")" '#{pane_dead}' 2>/dev/null)" != 1 ]]; }

# IDs of conversations a Claude process in this container has open right now
# (the server's sessions, a terminal session, or one boxen resumed). Each
# running Claude writes sessions/<pid>.json with its conversation ID, PID,
# process start time and PID namespace. The folder is shared by every
# project, so only entries from this container's namespace whose process is
# still the same one (start time matches) count.
running_ids() {
  local ns f id pid start dom
  ns=$(readlink /proc/self/ns/pid 2>/dev/null) || return 0
  for f in "$CFG"/sessions/*.json; do
    [[ -f $f ]] || continue
    IFS=$'\t' read -r id pid start dom < <(jq -r '[.sessionId, .pid, .procStart, .pidDomain] | map(. // "" | tostring) | @tsv' "$f" 2>/dev/null) || continue
    [[ -n $id && $pid =~ ^[0-9]+$ && $dom == *":$ns" ]] || continue
    [[ "$(awk '{print $22}' "/proc/$pid/stat" 2>/dev/null)" == "$start" ]] && printf '%s\n' "$id"
  done
}

ago() {
  local s=$(( $(now) - $1 ))
  if (( s < 3600 )); then printf '%dm ago' $(( s / 60 ))
  elif (( s < 172800 )); then printf '%dh ago' $(( s / 3600 ))
  else printf '%dd ago' $(( s / 86400 )); fi
}

# Session IDs in this project, newest first.
sessions() {
  local f id
  find "$KEYDIR" -maxdepth 1 -type f -name '*.jsonl' -printf '%T@ %f\n' 2>/dev/null \
    | sort -rn | while read -r _ f; do
        id=${f%.jsonl}
        [[ $id =~ $UUID_RE ]] && printf '%s\n' "$id"
      done
}

# The first thing you typed in a session, for the list. Transcripts are an
# internal format, so this is best effort and may come back empty. A record
# holds several text blocks (a <system-reminder>, then your message), so
# markup is dropped block by block before joining. Slash commands are stored
# as markup (<command-name>/model</command-name>...); those show as the
# command. Meta records and compaction summaries aren't your messages.
# Same as boxen-carry user_text: keep the two in sync.
preview() {
  jq -r 'first(select(.type == "user" and .isMeta != true and .isCompactSummary != true)
         | .message.content
         | if type == "string" then [.] elif type == "array"
           then map(select(.type == "text") | .text) else [] end
         | map(gsub("^\\s+|\\s+$"; "")
               | if test("<command-name>") then (capture("<command-name>(?<c>[^<]*)</command-name>").c // "")
                 elif startswith("<") then "" else . end)
         | map(select(length > 0)) | join(" ")
         | select(length > 0))' \
     "$(tfile "$1")" 2>/dev/null \
    | head -1 | tr '\t' ' ' | cut -c1-60 | sed 's/[[:space:]]*$//'
}

# title ID: the session's name. Claude keeps two in the transcript: the one
# you gave it (/rename, or renaming it in the Claude app, which syncs back as
# the same entry) and one it generates itself. Yours wins; with neither, the
# first message stands in.
title() {
  local t
  t=$(grep -aE '"type":"(custom-title|ai-title)"' "$(tfile "$1")" 2>/dev/null \
        | jq -rs '(map(select(.type == "custom-title") | .customTitle) | last)
                  // (map(select(.type == "ai-title") | .aiTitle) | last) // empty' 2>/dev/null \
        | tr '\t\n' '  ' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [[ -n $t ]] || t=$(preview "$1")
  printf '%s' "${t:0:60}"
}

# rc_state ID: is the session's Remote Control connected? Read off its screen.
# Prints "connected [url]", "elsewhere", "dead" or "waiting". A connected
# session shows "/rc active" in its footer and posts its claude.ai/code link
# in the conversation.
rc_state() {
  local screen url
  alive "$1" || { echo dead; return; }
  screen=$(tmux capture-pane -p -J -S -300 -t "$(tname "$1")" 2>/dev/null)
  if grep -q 'Remote Control not started here' <<<"$screen"; then echo elsewhere; return; fi
  url=$(grep -oE 'https://claude\.ai/code/[A-Za-z0-9_-]{6,}' <<<"$screen" | tail -1)
  if [[ -n $url ]] || grep -qiE '/rc active|remote control (is )?(active|connected)' <<<"$screen"; then
    echo "connected${url:+ $url}"
  else
    echo waiting
  fi
}

# wait_rc ID SECONDS: wait for the session to connect; prints its rc_state.
wait_rc() {
  local i st
  for (( i = 0; i < $2; i++ )); do
    st=$(rc_state "$1")
    [[ $st == waiting ]] || { echo "$st"; return; }
    sleep 1
  done
  echo waiting
}

screen_tail() {
  tmux capture-pane -p -J -S -300 -t "$(tname "$1")" 2>/dev/null \
    | grep -v '^[[:space:]]*$' | tail -"${2:-8}" | sed 's/^/    /'
}

# host ID TITLE: continue the session in tmux with Remote Control on, asking
# for TITLE in the app. The app lists it under "Remote Control", and a session
# that was in the app before keeps the title it had there.
host() {
  local t
  t=$(tname "$1")
  tmux kill-session -t "$t" 2>/dev/null || true
  # Keep the window after Claude exits (so its last words can be shown) before
  # Claude starts, then start it. The command goes in as separate arguments,
  # so tmux runs it directly with no shell quoting.
  tmux new-session -d -s "$t" -x 200 -y 50 \; \
       set-option -t "$t" remain-on-exit on \; \
       respawn-pane -k -t "$t" claude --resume "$1" --remote-control "$2" >/dev/null || return 1
}

# report ID: say whether the session made it into the app. If Claude is
# still waiting on a question (first-run setup, a one-time Remote Control
# confirmation), open it here so you can answer.
report() {
  local id=$1 st
  st=$(wait_rc "$id" "${BOXEN_RC_WAIT:-30}")
  case $st in
    connected*)
      echo "It's in the Claude app under \"Remote Control\" (resumed sessions don't go under the project)."
      [[ $st == "connected "* ]] && echo "  ${st#connected }"
      echo "It stays open until you close it (boxen resume $NAME ${id:0:8} --stop) or the container restarts."
      return 0 ;;
    elsewhere)
      echo "Another Claude process already has this conversation in the app; continue it there." >&2
      tmux kill-session -t "$(tname "$id")" 2>/dev/null || true
      return 1 ;;
    dead)
      echo "Claude exited instead of continuing the session. Its last output:" >&2
      screen_tail "$id" >&2
      tmux kill-session -t "$(tname "$id")" 2>/dev/null || true
      return 1 ;;
  esac

  if [[ ! -t 0 ]]; then
    echo "Claude hasn't connected yet; it may be waiting for an answer. Its screen:" >&2
    screen_tail "$id" >&2
    echo "Open it with: boxen resume $NAME ${id:0:8} --attach" >&2
    return 1
  fi
  echo
  echo "Claude hasn't connected yet. It's probably asking something first (first-run"
  echo "setup, or a one-time Remote Control confirmation; your answers are saved)."
  echo "Answer it, wait for \"/rc active\" at the bottom, then press Ctrl+B then D"
  echo "to leave it running."
  read -rp "Press Enter to open it... " _
  tmux attach -t "$(tname "$id")"
  st=$(rc_state "$id")
  case $st in
    connected*) echo "Connected: it's in the Claude app under \"Remote Control\". ${st#connected}" ;;
    dead)       echo "That session has ended." ;;
    *)          echo "It doesn't look connected yet. Look again with: boxen resume $NAME ${id:0:8} --attach" ;;
  esac
}

# number, id, state, last active, title
list_rows() {
  local id st m p i=0 running
  running=$(running_ids)
  for id in $(sessions); do
    p=$(title "$id")
    [[ -n $p ]] || continue            # empty, never-used session
    m=$(mtime "$id")
    if alive "$id"; then st=open
    elif grep -qxF "$id" <<<"$running"; then st=live
    else st=-; fi
    i=$((i + 1))
    printf '%s\t%s\t%s\t%s\t%s\n' "$i" "$id" "$st" "$m" "$p"
    (( i >= 30 )) && break
  done
}

cmd_resume() {
  local pick="" attach=0 force=0 stop=0 rows id st m p n
  while (( $# )); do
    case $1 in
      --attach) attach=1 ;; --force) force=1 ;; --stop) stop=1 ;;
      -*) echo "unknown option: $1" >&2; return 1 ;;
      *) pick=$1 ;;
    esac
    shift
  done
  rows=$(list_rows)
  [[ -n $rows ]] || { echo "No earlier sessions in $NAME yet."; return 0; }

  if [[ -z $pick ]]; then
    echo
    echo "Sessions in $NAME, newest first:"
    echo
    while IFS=$'\t' read -r n id st m p; do
      case $st in
        open) st="in the app (resumed with boxen)" ;;
        live) st="open in the app" ;;
        *)    st="" ;;
      esac
      printf '  %2s) %-8s %-62s %s\n' "$n" "$(ago "$m")" "\"$p\"" "$st"
    done <<< "$rows"
    echo
    read -rp "Number to continue in the Claude app (Enter to cancel): " pick
    [[ -n $pick ]] || return 0
  fi

  # A list number, or else the start of a session ID.
  id=""
  [[ $pick =~ ^[0-9]+$ ]] && id=$(awk -F'\t' -v n="$pick" '$1 == n { print $2 }' <<< "$rows")
  [[ -n $id ]] || id=$(awk -F'\t' -v s="$pick" 'index($2, s) == 1 { print $2; exit }' <<< "$rows")
  [[ -n $id ]] || { echo "No session '$pick' in the list." >&2; return 1; }
  st=$(awk -F'\t' -v s="$id" '$2 == s { print $3 }' <<< "$rows")
  p=$(awk -F'\t' -v s="$id" '$2 == s { print $5 }' <<< "$rows")

  if (( stop )); then
    if tmux kill-session -t "$(tname "$id")" 2>/dev/null; then
      echo "Closed \"$p\"."
      return 0
    fi
    echo "\"$p\" isn't open by boxen (nothing to close)."
    return 1
  fi
  if [[ $st == live ]] && (( ! force )); then
    cat >&2 <<EOF
"$p"
is open in another Claude process in $NAME right now (one of the project's
sessions in the app, or a terminal session), so continue it there. Opening it
twice would mix the two copies' messages. To open it anyway, add --force.
EOF
    return 1
  fi
  # In the app: "<project> · <title>", since the app lists every project's
  # sessions together.
  if [[ $st != open ]]; then
    echo "Continuing \"$p\"..."
    host "$id" "$NAME · $p" || { echo "Couldn't start Claude for that session." >&2; return 1; }
  fi
  if (( attach )); then
    tmux attach -t "$(tname "$id")"
  else
    report "$id"
  fi
}

case ${1:-} in
  resume) shift; cmd_resume "$@" ;;
  *)      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
