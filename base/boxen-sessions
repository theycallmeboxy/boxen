#!/bin/bash
# boxen-sessions: runs inside a boxen container (via `boxen resume`).
#
#   boxen-sessions resume [N|ID] [--attach] [--force] [--stop]
#   boxen-sessions count
#
# Lists this project's earlier Claude sessions and continues the one you pick
# in a tmux session with Remote Control on, so it shows up in the Claude app
# with its history. It runs until you stop it or the container restarts (the
# transcript stays, so you can resume it again).

set -u

CFG=${CLAUDE_CONFIG_DIR:?CLAUDE_CONFIG_DIR not set}
NAME=${BOXEN_PROJECT:-$(hostname)}
KEYDIR="$CFG/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

now()   { date +%s; }
tfile() { printf '%s/%s.jsonl' "$KEYDIR" "$1"; }
mtime() { stat -c %Y "$(tfile "$1")" 2>/dev/null || echo 0; }
tname() { printf 's-%s' "${1:0:8}"; }
alive() { tmux has-session -t "$(tname "$1")" 2>/dev/null \
            && [[ "$(tmux display -p -t "$(tname "$1")" '#{pane_dead}' 2>/dev/null)" != 1 ]]; }

# When this container (and so its Remote Control server) started.
started() { echo $(( $(now) - $(ps -o etimes= -p 1 | tr -d ' ') )); }

ago() {
  local s=$(( $(now) - $1 ))
  if (( s < 3600 )); then printf '%dm ago' $(( s / 60 ))
  elif (( s < 172800 )); then printf '%dh ago' $(( s / 3600 ))
  else printf '%dd ago' $(( s / 86400 )); fi
}

# Session IDs in this project, newest first.
sessions() {
  local f id
  find "$KEYDIR" -maxdepth 1 -type f -name '*.jsonl' -printf '%T@ %f\n' 2>/dev/null \
    | sort -rn | while read -r _ f; do
        id=${f%.jsonl}
        [[ $id =~ $UUID_RE ]] && printf '%s\n' "$id"
      done
}

# The first thing you typed in a session, for the list. Transcripts are an
# internal format, so this is best effort and may come back empty.
preview() {
  jq -r 'select(.type == "user") | .message.content
         | if type == "string" then . elif type == "array"
           then (map(select(.type == "text") | .text) | join(" ")) else empty end' \
     "$(tfile "$1")" 2>/dev/null \
    | grep -v '^[[:space:]]*$' | grep -v '^<' | head -1 | tr '\t\n' '  ' | cut -c1-60 | sed 's/[[:space:]]*$//'
}

# start_in_tmux ID CMD: start CMD in the session's tmux window; true if it's
# still running a few seconds later.
start_in_tmux() {
  local t
  t=$(tname "$1")
  tmux kill-session -t "$t" 2>/dev/null || true
  tmux new-session -d -s "$t" -x 200 -y 50 "$2" || return 1
  tmux set-option -t "$t" remain-on-exit on >/dev/null 2>&1 || true
  sleep "${BOXEN_START_WAIT:-8}"
  alive "$1"
}

# Continue a session in tmux with Remote Control on.
host() {
  local id=$1 t
  t=$(tname "$id")
  alive "$id" && return 0
  start_in_tmux "$id" "claude --resume $id --remote-control" && return 0
  # Fallback: resume, then turn Remote Control on from inside the session.
  if start_in_tmux "$id" "claude --resume $id"; then
    tmux send-keys -t "$t" "/remote-control" Enter
    sleep 2
    alive "$id" && return 0
  fi
  echo "Couldn't continue that session. Its last output:" >&2
  tmux capture-pane -p -t "$t" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -5 | sed 's/^/    /' >&2
  tmux kill-session -t "$t" 2>/dev/null || true
  return 1
}

# number, id, state, last active, preview
list_rows() {
  local id st since m p i=0
  since=$(started)
  for id in $(sessions); do
    p=$(preview "$id")
    [[ -n $p ]] || continue            # empty, never-used session
    m=$(mtime "$id")
    if alive "$id"; then st=open
    elif (( m >= since )); then st=live
    else st=-; fi
    i=$((i + 1))
    printf '%s\t%s\t%s\t%s\t%s\n' "$i" "$id" "$st" "$m" "$p"
    (( i >= 30 )) && break
  done
}

cmd_resume() {
  local pick="" attach=0 force=0 stop=0 rows id st m p n
  while (( $# )); do
    case $1 in
      --attach) attach=1 ;; --force) force=1 ;; --stop) stop=1 ;;
      *) pick=$1 ;;
    esac
    shift
  done
  rows=$(list_rows)
  [[ -n $rows ]] || { echo "No earlier sessions in $NAME yet."; return 0; }

  if [[ -z $pick ]]; then
    echo
    echo "Sessions in $NAME, newest first:"
    echo
    while IFS=$'\t' read -r n id st m p; do
      case $st in
        open) st="in the app (resumed with boxen)" ;;
        live) st="may be open in the app already" ;;
        *)    st="" ;;
      esac
      printf '  %2s) %-8s %-62s %s\n' "$n" "$(ago "$m")" "\"$p\"" "$st"
    done <<< "$rows"
    echo
    read -rp "Number to continue in the Claude app (Enter to cancel): " pick
    [[ -n $pick ]] || return 0
  fi

  if [[ $pick =~ ^[0-9]+$ ]]; then
    id=$(awk -F'\t' -v n="$pick" '$1 == n { print $2 }' <<< "$rows")
  else
    id=$(awk -F'\t' -v s="$pick" 'index($2, s) == 1 { print $2; exit }' <<< "$rows")
  fi
  [[ -n $id ]] || { echo "No session '$pick' in the list." >&2; return 1; }
  st=$(awk -F'\t' -v s="$id" '$2 == s { print $3 }' <<< "$rows")
  p=$(awk -F'\t' -v s="$id" '$2 == s { print $5 }' <<< "$rows")

  if (( stop )); then
    tmux kill-session -t "$(tname "$id")" 2>/dev/null || true
    echo "Closed \"$p\"."
    return 0
  fi
  if [[ $st == live ]] && (( ! force )); then
    cat >&2 <<EOF
"$p"
was used since $NAME started, so it's probably still open in the Claude app;
continue it there. (Opening it twice would mix the two copies' messages.)
If it isn't in the app, run this again with --force.
EOF
    return 1
  fi
  if [[ $st != open ]]; then
    echo "Continuing \"$p\"..."
    host "$id" || return 1
  fi
  if (( attach )); then
    tmux attach -t "$(tname "$id")"
  else
    echo "It's in the Claude app now, with its history. It stays open until you"
    echo "close it (boxen resume $NAME $pick --stop) or the container restarts."
    echo "(To see it here: boxen resume $NAME $pick --attach; Ctrl+B then D to leave.)"
  fi
}

case ${1:-} in
  resume) shift; cmd_resume "$@" ;;
  count)  tmux ls -F '#S' 2>/dev/null | grep -c '^s-' || true ;;
  *)      sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
