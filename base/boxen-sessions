#!/bin/bash
# boxen-sessions: runs inside a boxen container and keeps your Claude
# sessions available in the Claude app across restarts.
#
#   boxen-sessions serve [server flags]   the container's main command
#   boxen-sessions resume [N|ID] [--attach] [--force] [--stop]
#   boxen-sessions count
#
# Background: the project's Remote Control server brings its own sessions
# back if it restarts within about 4 hours of stopping. Past that it starts
# fresh. So when the server comes back after longer than that, this script
# brings back the sessions you used in the hours before it stopped, each in
# its own tmux session with Remote Control on. Sessions kept this way (and
# ones you resume by hand) aren't the server's, so they're started again
# after every restart, until they're closed or go idle.
#
# Everything here is best effort: failures are logged and never stop the
# server from starting.

set -u

CFG=${CLAUDE_CONFIG_DIR:?CLAUDE_CONFIG_DIR not set}
NAME=${BOXEN_PROJECT:?BOXEN_PROJECT not set}
STATE="$CFG/boxen/$NAME"
RUNDIR=/tmp/boxen-sessions            # this container's lifetime only
# The server reliably brings its sessions back within ~4h; past 4.5h, we do.
# (In between, neither does automatically; `boxen resume` covers it.)
WINDOW=${BOXEN_RC_WINDOW_SECS:-16200}
RECENT_HOURS=${BOXEN_REVIVE_HOURS:-24}
IDLE_HOURS=${BOXEN_KEEP_IDLE_HOURS:-24}
MAX=${BOXEN_REVIVE_MAX:-8}

KEYDIR="$CFG/projects/$(printf '%s' "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"
UUID_RE='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

mkdir -p "$STATE" "$RUNDIR"
touch "$STATE/kept" "$RUNDIR/started"

log()   { printf '[boxen] %s\n' "$*"; }
now()   { date +%s; }
get()   { cat "$STATE/$1" 2>/dev/null || true; }
put()   { printf '%s\n' "$2" > "$STATE/$1.tmp" && mv -f "$STATE/$1.tmp" "$STATE/$1"; }
tfile() { printf '%s/%s.jsonl' "$KEYDIR" "$1"; }
mtime() { stat -c %Y "$(tfile "$1")" 2>/dev/null || echo 0; }
tname() { printf 's-%s' "${1:0:8}"; }
alive() { tmux has-session -t "$(tname "$1")" 2>/dev/null \
            && [[ "$(tmux display -p -t "$(tname "$1")" '#{pane_dead}' 2>/dev/null)" != 1 ]]; }
kept()  { grep -qxF "$1" "$STATE/kept"; }

ago() {
  local s=$(( $(now) - $1 ))
  if (( s < 3600 )); then printf '%dm ago' $(( s / 60 ))
  elif (( s < 172800 )); then printf '%dh ago' $(( s / 3600 ))
  else printf '%dd ago' $(( s / 86400 )); fi
}

# Session IDs in this project, newest first.
sessions() {
  local f id
  find "$KEYDIR" -maxdepth 1 -type f -name '*.jsonl' -printf '%T@ %f\n' 2>/dev/null \
    | sort -rn | while read -r _ f; do
        id=${f%.jsonl}
        [[ $id =~ $UUID_RE ]] && printf '%s\n' "$id"
      done
}

# The first thing you typed in a session, for the list. Transcripts are an
# internal format, so this is best effort and may come back empty.
preview() {
  jq -r 'select(.type == "user") | .message.content
         | if type == "string" then . elif type == "array"
           then (map(select(.type == "text") | .text) | join(" ")) else empty end' \
     "$(tfile "$1")" 2>/dev/null \
    | grep -v '^[[:space:]]*$' | grep -v '^<' | head -1 | tr '\t\n' '  ' | cut -c1-60 | sed 's/[[:space:]]*$//'
}

remember() { kept "$1" || printf '%s\n' "$1" >> "$STATE/kept"; }
forget()   { grep -vxF "$1" "$STATE/kept" > "$STATE/kept.tmp" || true; mv -f "$STATE/kept.tmp" "$STATE/kept"; }

# start_in_tmux ID CMD: start CMD in the session's tmux window and report
# whether it's still running a few seconds later.
start_in_tmux() {
  local id=$1 cmd=$2 t
  t=$(tname "$id")
  tmux kill-session -t "$t" 2>/dev/null || true
  tmux new-session -d -s "$t" -x 200 -y 50 "$cmd" || return 1
  tmux set-option -t "$t" remain-on-exit on >/dev/null 2>&1 || true
  sleep "${BOXEN_START_WAIT:-8}"
  alive "$id"
}

# keep ID: continue a session in tmux with Remote Control on, so it's in the
# Claude app, and remember it so it comes back after restarts.
keep() {
  local id=$1 t
  t=$(tname "$id")
  remember "$id"
  alive "$id" && return 0
  if start_in_tmux "$id" "claude --resume $id --remote-control"; then
    printf '%s\n' "$id" >> "$RUNDIR/started"
    return 0
  fi
  # Fallback: resume, then turn Remote Control on from inside the session.
  if start_in_tmux "$id" "claude --resume $id"; then
    tmux send-keys -t "$t" "/remote-control" Enter
    sleep 2
    if alive "$id"; then printf '%s\n' "$id" >> "$RUNDIR/started"; return 0; fi
  fi
  log "couldn't continue session $id; last output:"
  tmux capture-pane -p -t "$t" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -5 | sed 's/^/    /'
  tmux kill-session -t "$t" 2>/dev/null || true
  return 1
}

unkeep() {
  tmux kill-session -t "$(tname "$1")" 2>/dev/null || true
  forget "$1"
}

# Every 10 minutes: drop kept sessions that ended (closed, /exit) or have
# been idle for IDLE_HOURS, so nothing lingers.
prune() {
  local id cutoff
  cutoff=$(( $(now) - IDLE_HOURS * 3600 ))
  while IFS= read -r id; do
    [[ -n $id ]] || continue
    if [[ ! -f "$(tfile "$id")" ]]; then
      unkeep "$id"; log "stopped keeping $id (its transcript is gone)"
    elif grep -qxF "$id" "$RUNDIR/started" && ! alive "$id"; then
      unkeep "$id"; log "session $id ended; stopped keeping it"
    elif (( $(mtime "$id") < cutoff )); then
      unkeep "$id"; log "session $id idle for ${IDLE_HOURS}h; closed it"
    fi
  done < <(cat "$STATE/kept")
}

# Runs in the background next to the server.
background() {
  local server=$1 last=$2 epoch=$3 revive_from=$4 id n=0 i=0
  sleep "${BOXEN_BG_DELAY:-15}"    # let the server start first
  # Sessions boxen keeps aren't the server's: start them again.
  while IFS= read -r id; do
    [[ -n $id ]] && keep "$id" && n=$((n + 1))
  done < <(cat "$STATE/kept")
  (( n )) && log "continued $n session(s) boxen keeps"

  # After long downtime, bring back what you were using.
  if (( revive_from > 0 )); then
    n=0
    for id in $(sessions); do
      (( $(mtime "$id") >= revive_from )) || break
      kept "$id" && continue
      [[ -n "$(preview "$id")" ]] || continue     # empty, never-used session
      (( n >= MAX )) && break
      keep "$id" && n=$((n + 1))
    done
    log "the server was down $(( ($(now) - last) / 3600 ))h, too long for it to bring its sessions back; brought back $n session(s) you'd used"
  fi

  # Heartbeat (only once the server has been up a minute, so a server that
  # keeps crashing doesn't count as running) and cleanup.
  sleep "${BOXEN_HB_DELAY:-45}"
  while kill -0 "$server" 2>/dev/null; do
    put heartbeat "$(now)"
    (( i % 10 == 0 )) && prune
    i=$((i + 1))
    sleep 60
  done
}

cmd_serve() {
  local t last epoch revive_from=0
  t=$(now)
  last=$(get heartbeat); last=${last:-0}
  epoch=$(get epoch); epoch=${epoch:-0}
  # A "serving period" is a run of server restarts each within the window,
  # during which the server keeps its own sessions. A longer gap ends it.
  if (( last == 0 )); then
    put epoch "$t"
  elif (( t - last > WINDOW && epoch <= last )); then
    revive_from=$(( last - RECENT_HOURS * 3600 ))
    (( epoch > revive_from )) && revive_from=$epoch
    put epoch "$t"
  fi
  background $$ "$last" "$epoch" "$revive_from" &
  exec claude remote-control --name "$NAME" "$@"
}

# The list `boxen resume` shows: number, id, state, last active, preview.
list_rows() {
  local id st epoch m p i=0
  epoch=$(get epoch); epoch=${epoch:-0}
  for id in $(sessions); do
    p=$(preview "$id")
    [[ -n $p ]] || continue
    m=$(mtime "$id")
    if kept "$id" && alive "$id"; then st=kept
    elif (( m >= epoch )) && ! kept "$id"; then st=live
    else st=-; fi
    i=$((i + 1))
    printf '%s\t%s\t%s\t%s\t%s\n' "$i" "$id" "$st" "$m" "$p"
    (( i >= 30 )) && break
  done
}

cmd_resume() {
  local pick="" attach=0 force=0 stop=0 rows id st m p n
  while (( $# )); do
    case $1 in
      --attach) attach=1 ;; --force) force=1 ;; --stop) stop=1 ;;
      *) pick=$1 ;;
    esac
    shift
  done
  rows=$(list_rows)
  [[ -n $rows ]] || { echo "No earlier sessions in $NAME yet."; return 0; }

  if [[ -z $pick ]]; then
    echo
    echo "Sessions in $NAME, newest first:"
    echo
    while IFS=$'\t' read -r n id st m p; do
      case $st in
        kept) st="in the app (boxen keeps it running)" ;;
        live) st="may be open in the app already" ;;
        *)    st="" ;;
      esac
      printf '  %2s) %-8s %-62s %s\n' "$n" "$(ago "$m")" "\"$p\"" "$st"
    done <<< "$rows"
    echo
    read -rp "Number to continue in the Claude app (Enter to cancel): " pick
    [[ -n $pick ]] || return 0
  fi

  if [[ $pick =~ ^[0-9]+$ ]]; then
    id=$(awk -F'\t' -v n="$pick" '$1 == n { print $2 }' <<< "$rows")
  else
    id=$(awk -F'\t' -v s="$pick" '$2 == s || index($2, s) == 1 { print $2; exit }' <<< "$rows")
  fi
  [[ -n $id ]] || { echo "No session '$pick' in the list." >&2; return 1; }
  st=$(awk -F'\t' -v s="$id" '$2 == s { print $3 }' <<< "$rows")
  p=$(awk -F'\t' -v s="$id" '$2 == s { print $5 }' <<< "$rows")

  if (( stop )); then
    unkeep "$id"
    echo "Closed \"$p\" and stopped keeping it."
    return 0
  fi
  if [[ $st == live ]] && (( ! force )); then
    cat >&2 <<EOF
"$p" was used since the server started, so it's probably still open in the
Claude app; continue it there. (Opening it twice would mix the two copies'
messages.) If it isn't in the app, run this again with --force.
EOF
    return 1
  fi
  if [[ $st != kept ]]; then
    echo "Continuing \"$p\"..."
    keep "$id" || return 1
  fi
  if (( attach )); then
    tmux attach -t "$(tname "$id")"
  else
    echo "It's in the Claude app now, with its history. boxen keeps it running"
    echo "across restarts until you close it or it's idle for ${IDLE_HOURS}h."
    echo "(To see it here: boxen resume $NAME $pick --attach; Ctrl+B then D to leave.)"
  fi
}

case ${1:-} in
  serve)  shift; cmd_serve "$@" ;;
  resume) shift; cmd_resume "$@" ;;
  count)  n=0; while IFS= read -r id; do [[ -n $id ]] && alive "$id" && n=$((n + 1)); done < "$STATE/kept"; echo "$n" ;;
  *)      sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
