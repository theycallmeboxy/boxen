#!/bin/sh
# Wrapper for the GitHub CLI inside boxen containers: hands gh this project's
# short-lived token (minted and refreshed by boxen on the VM), read fresh on
# every call. Without one, gh falls back to $GH_TOKEN as usual.
if [ -s /run/boxen/gh-token ]; then
  GH_TOKEN=$(cat /run/boxen/gh-token)
  export GH_TOKEN
fi
exec /usr/bin/gh "$@"
