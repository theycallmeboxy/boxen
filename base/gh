#!/bin/sh
# Wrapper for the GitHub CLI inside boxen containers: hands gh the token for
# the repo it's about, read fresh on every call. boxen mints them on the VM,
# one per owner in this project's repo list, in /run/boxen. The repo is the
# one -R/--repo names, else $GH_REPO, else this folder's origin; its owner's
# token if there is one, else the project's default token. Without either,
# gh falls back to $GH_TOKEN as usual. The arguments go to gh unchanged.
dir=${BOXEN_TOKEN_DIR:-/run/boxen}
repo="" next=""
for a in "$@"; do
  if [ -n "$next" ]; then repo=$a; next=""; continue; fi
  case $a in
    --) break ;;
    -R|--repo) next=1 ;;
    --repo=*) repo=${a#--repo=} ;;
    -R?*) repo=${a#-R} ;;
  esac
done
[ -n "$repo" ] || repo=${GH_REPO:-}
[ -n "$repo" ] || repo=$(git remote get-url origin 2>/dev/null) || repo=""
case $repo in
  https://github.com/*)   r=${repo#https://github.com/} ;;
  https://*@github.com/*) r=${repo#https://*@github.com/} ;;
  git@github.com:*)       r=${repo#git@github.com:} ;;
  ssh://git@github.com/*) r=${repo#ssh://git@github.com/} ;;
  github.com/*)           r=${repo#github.com/} ;;
  *://*|*/*/*)            r="" ;;    # another host
  */*)                    r=$repo ;;
  *)                      r="" ;;
esac
owner=$(printf '%s' "${r%%/*}" | tr 'A-Z' 'a-z')
f=""
if [ -n "$owner" ] && printf '%s\n' "$owner" | grep -Eqx '[a-z0-9]([a-z0-9_.-]{0,37}[a-z0-9_])?' \
   && [ -s "$dir/gh-token.$owner" ]; then
  f=$dir/gh-token.$owner
elif [ -s "$dir/gh-token" ]; then
  f=$dir/gh-token
fi
if [ -n "$f" ]; then
  GH_TOKEN=$(head -n 1 "$f")
  export GH_TOKEN
fi
exec /usr/bin/gh "$@"
